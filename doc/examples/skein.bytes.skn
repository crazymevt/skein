(ns skein.bytes.examples
  (:require [skein.bytes :as b]))

;;; Examples for skein.bytes (D-111). Bytes are u8 arrays; a string stands for its UTF-8.
;;; `./skein run doc/manual.skn --check skein.bytes` runs them.

;;;; utf8
(let [a (b/utf8 "héllo")]
  [(count a) (aget a 0) (aget a 1) (aget a 2)])
;=> [6 104 195 169]

;;;; utf8-string
(b/utf8-string (b/utf8 "naïve ☕"))
;=> "naïve ☕"

(handler-case (b/utf8-string (b/unhex "ff"))
  (error [_] :not-utf8))
;=> :not-utf8

;;;; base64
(b/base64 "Hello, Skein!")
;=> "SGVsbG8sIFNrZWluIQ=="

;; HTTP's Basic authentication.
(str "Basic " (b/base64 "user:secret"))
;=> "Basic dXNlcjpzZWNyZXQ="

;;;; unbase64
(b/utf8-string (b/unbase64 "SGVsbG8sIFNrZWluIQ=="))
;=> "Hello, Skein!"

(handler-case (b/unbase64 "not base64!")
  (error [_] :invalid))
;=> :invalid

;;;; hex
[(b/hex "AZ") (b/hex (b/utf8 "é"))]
;=> ["415a" "c3a9"]

;;;; unhex
;; Either case.
(vec (map (fn [i] (aget (b/unhex "00ffFF7f") i)) (range 4)))
;=> [0 255 255 127]

;;;; sha256
(b/hex (b/sha256 "abc"))
;=> "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

(count (b/sha256 ""))
;=> 32

;;;; sha1
;; Git's object id of a blob holding "hello\n".
(b/hex (b/sha1 "blob 6\u0000hello\n"))
;=> "ce013625030ba8dba906f756967f9e9ca394464a"

;;;; md5
;; For checksums and cache keys, not security.
(b/hex (b/md5 "abc"))
;=> "900150983cd24fb0d6963f7d28e17f72"
