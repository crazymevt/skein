;; The quick reference's topics (D-111): sections of groups of var names, in the order
;; the page shows them. A name is a public var of the section's :ns, or ns/name. A public
;; var that no group names is listed under its namespace's "Other", so the quick reference
;; always covers the whole library; `./skein run doc/manual.skn --check` checks the names.
[{:title "Definitions and namespaces" :ns "skein.core"
  :groups [["Define" ["defn" "defn-" "defmacro" "defonce" "declaim"]]
           ["Namespaces" ["ns" "in-ns" "load-file" "reload"]]
           ["Evaluate" ["eval" "read-string" "macroexpand-1" "macroexpand" "macroexpand-all"
                        "comment"]]
           ["REPL" ["*1" "*2" "*3" "*e" "*print-length*"]]]}

