;;;; Printing any value, for print/println (display) and pr/prn (readable).

(in-package #:skein.runtime)

(defun function-display-name (f)
  (if (typep f 'skein-generic)
      (generic-skein-name f)
      (let ((name (sb-kernel:%fun-name f)))
        (if (stringp name) name "fn"))))

(defun print-elements (items stream readably &optional (separator " "))
  (loop for (x . more) on items
        do (print-value x stream :readably readably)
           (when more (write-string separator stream))))

(defun print-fields (fields stream readably)
  "Print FIELDS, a list of (name . value), like a map but in their declared order."
  (write-char #\{ stream)
  (loop for ((name . value) . more) on fields
        do (write-char #\: stream)
           (write-string name stream)
           (write-char #\Space stream)
           (print-value value stream :readably readably)
           (when more (write-string ", " stream)))
  (write-char #\} stream))

(defun print-value (x stream &key readably)
  "Write X to STREAM. When READABLY is false, strings and chars are written raw, as
print does; otherwise as pr does. Values with no readable syntax print as #<...>."
  (cond ((and (not readably) (stringp x)) (write-string x stream))
        ((and (not readably) (characterp x)) (write-char x stream))
        ((or (null x) (eq x t) (false-p x) (numberp x) (characterp x) (stringp x)
             (sym-p x) (kw-p x))
         (print-atom x stream))
        ((pvector-p x)
         (write-char #\[ stream)
         (print-elements (vector-to-list x) stream readably)
         (write-char #\] stream))
        ((map-p x)
         (write-char #\{ stream)
         (let ((first t))
           (map-reduce-kv x (lambda (acc k v)
                              (unless first (write-string ", " stream))
                              (setf first nil)
                              (print-value k stream :readably readably)
                              (write-char #\Space stream)
                              (print-value v stream :readably readably)
                              acc)
                          nil))
         (write-char #\} stream))
        ((hash-set-p x)
         (write-string "#{" stream)
         (print-elements (seq-to-cl x) stream readably)
         (write-char #\} stream))
        ((or (sequential-p x) (eduction-p x))
         (write-char #\( stream)
         (print-elements (seq-to-cl x) stream readably)
         (write-char #\) stream))
        ((instance-p x)
         (format stream "#<~A " (skein-class-name (class-of x)))
         (print-fields (loop for s in (skein-slots (class-of x))
                             collect (cons (slot-name-string s)
                                           (let ((v (slot-value x (c2mop:slot-definition-name s))))
                                             ;; An :atom cell shows its value.
                                             (if (eq (slot-cell s) :atom)
                                                 (skein-atom-value v)
                                                 v))))
                       stream readably)
         (write-char #\> stream))
        ((struct-instance-def x)
         (format stream "#<~A " (struct-def-name (struct-instance-def x)))
         (print-fields (loop for f in (struct-def-fields (struct-instance-def x))
                             collect (cons (field-def-name f) (funcall (field-def-accessor f) x)))
                       stream readably)
         (write-char #\> stream))
        ((struct-array-p x)
         (format stream "#<array ~A [" (struct-def-name (struct-array-def x)))
         (print-elements (seq-to-cl x) stream readably)
         (write-string "]>" stream))
        ((and (vectorp x) (not (stringp x)))
         (format stream "#<array ~A [" (skein-element-name (array-element-type x)))
         (print-elements (coerce x 'list) stream readably)
         (write-string "]>" stream))
        ((byte-view-p x) (format stream "#<bytes ~D>" (count-of x)))
        ((cffi:pointerp x) (format stream "#<ptr 0x~X>" (cffi:pointer-address x)))
        ((task-p x) (format stream "#<task ~(~A~)>" (task-state x)))
        ((chan-p x) (format stream "#<chan~:[~; closed~]>" (chan-closed x)))
        ((nursery-p x) (write-string "#<nursery>" stream))
        ((skein-atom-p x)
         (write-string "#<atom " stream)
         (print-value (skein-atom-value x) stream :readably readably)
         (write-char #\> stream))
        ((typep x 'skein-generic) (format stream "#<generic ~A>" (generic-skein-name x)))
        ((typep x 'class) (format stream "#<class ~A>" (skein-class-name x)))
        ((functionp x) (format stream "#<fn ~A>" (function-display-name x)))
        ((var-p x) (format stream "#'~A" (var-qualified-name x)))
        ((namespace-p x) (format stream "#<namespace ~A>" (namespace-name x)))
        ((tvector-p x) (write-string "#<transient vector>" stream))
        ((tmap-p x) (write-string "#<transient map>" stream))
        ((tset-p x) (write-string "#<transient set>" stream))
        ((typep x 'condition)
         (let ((type (condition-type-of x)))
           (format stream "#<~A ~A>" (if type (condition-type-name type) (type-of x))
                   (condition-report x))))
        ((condition-type-p x) (format stream "#<condition-type ~A>" (condition-type-name x)))
        ((skein-restart-p x) (format stream "#<restart ~A>"
                                     (readable-string (skein-restart-name x))))
        ((reduced-p x)
         (write-string "#<reduced " stream)
         (print-value (reduced-value x) stream :readably readably)
         (write-char #\> stream))
        (t (format stream "#<~(~A~)>" (type-of x))))
  x)

(defun display-string (x)
  "Return X as print would write it."
  (with-output-to-string (s) (print-value x s)))

(defun readable-string (x)
  "Return X as pr would write it."
  (with-output-to-string (s) (print-value x s :readably t)))
