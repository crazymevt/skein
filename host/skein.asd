;;;; skein.asd: Phase 0 Skein, hosted on SBCL.

(defsystem "skein"
  :description "Skein, a Lisp for games and desktop apps (Phase 0: hosted on SBCL)."
  :version "0.0.1"
  :author "Jessie Hughart"
  :license "MIT"
  :depends-on ("closer-mop" "cffi" (:require "sb-bsd-sockets"))
  :pathname "src/"
  :serial t
  ;; One package per module (src/<module>/package.lisp). Files are listed in load order:
  ;; syntax objects come first because runtime errors report source locations.
  :components ((:file "platform/package")
               (:file "platform/cpu")
               (:file "platform/os")
               (:file "syntax/package")
               (:file "syntax/syntax")
               (:file "runtime/package")
               (:file "runtime/data")
               (:file "runtime/numbers")
               (:file "runtime/print")
               (:file "runtime/errors")
               (:file "runtime/namespaces")
               (:file "runtime/coll-types")
               (:file "runtime/vector")
               (:file "runtime/map")
               (:file "runtime/seq")
               (:file "runtime/equality")
               (:file "runtime/conditions")
               (:file "runtime/invoke")
               (:file "runtime/display")
               (:file "runtime/core")
               (:file "runtime/core-coll")
               (:file "runtime/core-conditions")
               (:file "runtime/atoms")
               (:file "runtime/objects")
               (:file "runtime/inline")
               (:file "runtime/arrays")
               (:file "runtime/math")
               (:file "runtime/structs")
               (:file "runtime/types")
               (:file "runtime/concurrency")
               (:file "runtime/channels")
               (:file "runtime/compile-env")
               (:file "runtime/io")
               (:file "syntax/print")
               (:file "reader/package")
               (:file "reader/reader")
               (:file "ir/package")
               (:file "ir/ir")
               (:file "expander/package")
               (:file "expander/env")
               (:file "expander/data")
               (:file "expander/syntax-quote")
               (:file "expander/destructure")
               (:file "expander/expander")
               (:file "expander/macros")
               (:file "ffi/package")
               (:file "ffi/ffi")
               (:file "bindgen/package")
               (:file "bindgen/json")
               (:file "bindgen/bindgen")
               (:file "backend-cl/package")
               (:file "backend-cl/compile")
               (:file "backend-cl/driver")
               (:file "backend-c/package")
               (:file "backend-c/emit")
               (:file "backend-c/typed")
               (:file "backend-c/build")
               (:file "repl/package")
               (:file "repl/repl")
               (:file "cli/package")
               (:file "cli/cli"))
  :in-order-to ((test-op (test-op "skein/tests"))))

(defsystem "skein/tests"
  :description "FiveAM test suites for Skein."
  :depends-on ("skein" "fiveam")
  :pathname "tests/"
  :serial t
  :components ((:file "package")
               (:file "smoke")
               (:file "runtime")
               (:file "syntax")
               (:file "reader")
               (:file "expander-in-skein")
               (:file "eval")
               (:file "collections")
               (:file "seqs")
               (:file "macros")
               (:file "conditions")
               (:file "objects")
               (:file "types")
               (:file "concurrency")
               (:file "cli")
               (:file "ffi")
               (:file "bindgen")
               (:file "repl")
               (:file "swank")
               (:file "math")
               (:file "io")
               (:file "backend-c")
               (:file "interp")
               (:file "driver"))
  :perform (test-op (o c)
             (unless (uiop:symbol-call :fiveam :run!
                                       (uiop:find-symbol* :all :skein.tests))
               (error "Skein test suite failed."))))
