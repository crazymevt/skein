;;;; Tests for persistent collections, transients, equality and hashing (DESIGN §6.2, §7),
;;;; including randomized tests against CL reference models.

(in-package #:skein.tests)

(def-suite skein.collections :in all
  :description "Persistent lists, vectors, maps, sets and transients.")

(in-suite skein.collections)

;;; Helpers

(defun sk (x)
  "Turn a CL keyword into the Skein keyword with the same (lowercase) name."
  (if (keywordp x) (kw (string-downcase (symbol-name x))) x))

(defun c (name &rest args)
  "Call the skein.core function NAME from CL. CL keywords become Skein keywords."
  (apply (skein.runtime::core-fn name) (mapcar #'sk args)))

(defun to-cl (x) (skein.runtime:seq-to-cl x))
(defun sk-list (&rest xs) (skein.runtime:list-from-cl (mapcar #'sk xs)))
(defun sk-vec (&rest xs) (skein.runtime:vector-from-list (mapcar #'sk xs)))
(defun sk-map (&rest kvs) (skein.runtime:map-from-pairs (mapcar #'sk kvs)))
(defun sk-set (&rest xs) (skein.runtime:set-from-cl (mapcar #'sk xs)))
(defun pr (x) (skein.runtime:readable-string x))
(defun sk= (a b) (skein.runtime:equiv a b))

(defun vector-contents (v)
  (loop for i below (skein.runtime:count-of v) collect (skein.runtime:vector-nth v i)))

;;; Lists

(test lists
  (let ((l (sk-list 1 2 3)))
    (is (= 3 (c "count" l)))
    (is (= 1 (c "first" l)))
    (is (string= "(2 3)" (pr (c "rest" l))))
    (is (string= "(0 1 2 3)" (pr (c "conj" l 0))))
    (is (string= "(0 1 2 3)" (pr (c "cons" 0 l))))
    (is (= 1 (c "peek" l)))
    (is (string= "(2 3)" (pr (c "pop" l))))
    (is (eq skein.runtime:+empty-list+ (c "rest" (sk-list 1))))
    (is (null (c "next" (sk-list 1))))
    (is (null (c "seq" skein.runtime:+empty-list+)))
    (is (string= "()" (pr (c "rest" nil))))
    (is (string= "(1)" (pr (c "conj" nil 1))))
    (signals skein.runtime:unsupported-operation-error (c "pop" skein.runtime:+empty-list+))))

;;; Vectors

(test vectors
  (let ((v (sk-vec 1 2 3)))
    (is (= 3 (c "count" v)))
    (is (= 2 (c "nth" v 1)))
    (is (= 2 (c "get" v 1)))
    (is (null (c "get" v 5)))
    (is (eq (sk :nf) (c "nth" v 5 :nf)))
    (signals skein.runtime:index-error (c "nth" v 5))
    (signals skein.runtime:index-error (c "assoc" v 5 0))
    (is (string= "[1 2 3 4]" (pr (c "conj" v 4))))
    (is (string= "[1 :x 3]" (pr (c "assoc" v 1 :x))))
    (is (string= "[1 2 3 4]" (pr (c "assoc" v 3 4))) "assoc at count appends")
    (is (= 3 (c "peek" v)))
    (is (string= "[1 2]" (pr (c "pop" v))))
    (is (string= "[1 2 3]" (pr v)) "v is unchanged")
    (signals skein.runtime:unsupported-operation-error (c "pop" skein.runtime:+empty-vector+))))

(test vector-trie-boundaries
  ;; Grow past each level of the trie (32, 32+32*32, 32+32^3 elements), checking every
  ;; element, then shrink back to empty.
  (let ((v skein.runtime:+empty-vector+)
        (n 40000))
    (dotimes (i n) (setf v (skein.runtime:vector-conj v i)))
    (is (= n (skein.runtime:count-of v)))
    (is (loop for i below n always (= i (skein.runtime:vector-nth v i))))
    (setf v (skein.runtime:vector-assoc v 35000 :x))
    (is (eq :x (skein.runtime:vector-nth v 35000)))
    (loop for i from (1- n) downto 0
          do (setf v (skein.runtime:pvector-pop v))
             (when (member i '(39999 32800 32768 32767 1056 1055 1024 33 32 31 1 0))
               (unless (and (= i (skein.runtime:count-of v))
                            (or (zerop i)
                                (eql (1- i) (skein.runtime:vector-nth v (1- i)))))
                 (fail "wrong vector after popping down to ~D elements" i))))
    (is (eq skein.runtime:+empty-vector+ v))))

;;; Maps

(test maps
  (let ((m (sk-map :a 1 :b 2)))
    (is (= 2 (c "count" m)))
    (is (= 1 (c "get" m :a)))
    (is (eq (sk :nf) (c "get" m :z :nf)))
    (is (eq t (c "contains?" m :a)))
    (is (string= "{:a 1, :b 2, :c 3}" (pr (c "assoc" m :c 3))))
    (is (string= "{:b 2}" (pr (c "dissoc" m :a))))
    (is (string= "[:a 1]" (pr (c "find" m :a))))
    (is (null (c "find" m :z)))
    (is (= 5 (c "get" (c "assoc" m nil 5) nil)) "nil can be a key")
    (is (= 6 (c "get" (c "assoc" m skein.runtime:+false+ 6) skein.runtime:+false+)))
    (is (= 7 (c "get" (c "assoc" m (sk-vec 1 2) 7) (sk-list 1 2))) "equal keys match")
    (is (null (c "get" (c "assoc" m 1 :int) 1.0)) "1 and 1.0 are different keys")))

(test array-map-becomes-hash-map
  (let ((m skein.runtime:+empty-map+))
    (dotimes (i 8) (setf m (skein.runtime:map-assoc m i i)))
    (is (skein.runtime:array-map-p m))
    (setf m (skein.runtime:map-assoc m 8 8))
    (is (skein.runtime:hash-map-p m))
    (is (= 9 (skein.runtime:map-count m)))
    (is (loop for i below 9 always (= i (skein.runtime:map-get m i))))
    (is (skein.runtime:array-map-p (c "into" skein.runtime:+empty-map+ (sk-list (sk-vec 1 2))))
        "small maps built with transients become array maps again")))

(defun colliding-key (a)
  "Integers of the form a * (2^32 + 1) all have the same 32-bit hash."
  (* a (1+ (expt 2 32))))

(test hash-collisions
  (is (= (skein.runtime:hash-of (colliding-key 1)) (skein.runtime:hash-of (colliding-key 2))))
  (let ((m skein.runtime:+empty-map+))
    (loop for a from 0 below 50 do (setf m (skein.runtime:map-assoc m (colliding-key a) a)))
    (is (= 50 (skein.runtime:map-count m)))
    (is (loop for a below 50 always (= a (skein.runtime:map-get m (colliding-key a)))))
    (loop for a from 0 below 50 by 2 do (setf m (skein.runtime:map-dissoc m (colliding-key a))))
    (is (= 25 (skein.runtime:map-count m)))
    (is (loop for a below 50
              always (eql (if (evenp a) nil a) (skein.runtime:map-get m (colliding-key a)))))))

;;; Sets

(test sets
  (let ((s (sk-set 1 2 3)))
    (is (= 3 (c "count" s)))
    (is (eq t (c "contains?" s 2)))
    (is (= 2 (c "get" s 2)))
    (is (null (c "get" s 9)))
    (is (= 4 (c "count" (c "conj" s 4))))
    (is (eq s (c "conj" s 1)) "adding an existing element returns the same set")
    (is (= 2 (c "count" (c "disj" s 1))))
    (is (sk= (sk-set 1 2 3) (sk-set 3 2 1)))
    (is (not (sk= (sk-set 1 2) (sk-vec 1 2))))))

;;; Transients

(test transients
  (let ((tv (c "transient" (sk-vec 1 2))))
    (c "conj!" tv 3)
    (c "assoc!" tv 0 :a)
    (c "pop!" tv)
    (is (string= "[:a 2]" (pr (c "persistent!" tv))))
    (signals skein.runtime:transient-error (c "conj!" tv 4))
    (signals skein.runtime:transient-error (c "persistent!" tv)))
  (let ((tm (c "transient" (sk-map :a 1))))
    (c "assoc!" tm :b 2 :c 3)
    (c "dissoc!" tm :a)
    (is (sk= (sk-map :b 2 :c 3) (c "persistent!" tm))))
  (let ((ts (c "transient" (sk-set 1 2))))
    (c "conj!" ts 3)
    (c "disj!" ts 1)
    (is (sk= (sk-set 2 3) (c "persistent!" ts))))
  (let* ((v (sk-vec 1 2 3))
         (tv (c "transient" v)))
    (c "assoc!" tv 0 :changed)
    (is (string= "[1 2 3]" (pr v)) "the source of a transient is unchanged")))

(test transients-are-owned-by-their-thread
  (let* ((tv (c "transient" (sk-vec 1)))
         (result nil)
         (thread (sb-thread:make-thread
                  (lambda ()
                    (setf result (handler-case (progn (c "conj!" tv 2) :no-error)
                                   (skein.runtime:transient-error () :error)))))))
    (sb-thread:join-thread thread)
    (is (eq :error result))))

;;; Equality and hashing

(test equality
  (is (sk= (sk-vec 1 2) (sk-list 1 2)))
  (is (sk= (sk-vec) skein.runtime:+empty-list+))
  (is (not (sk= nil skein.runtime:+empty-list+)))
  (is (not (sk= 1 1.0d0)))
  (is (sk= 1.0d0 1.0f0))
  (is (not (sk= skein.runtime:+f64-nan+ skein.runtime:+f64-nan+)))
  (is (sk= 0.0d0 -0.0d0))
  (is (sk= "ab" "ab"))
  (is (not (sk= "ab" (sk-vec #\a #\b))))
  (is (sk= (c "seq" "ab") (sk-vec #\a #\b)))
  (is (sk= (sk-map :a (sk-vec 1)) (sk-map :a (sk-list 1))))
  (is (not (sk= (sk-map :a 1) (sk-map :a 1 :b 2))))
  (is (not (sk= (sk-map :a nil) (sk-map :b nil))))
  (is (sk= (c "map" (lambda (x) (1+ x)) (sk-vec 1 2)) (sk-list 2 3)))
  (is (not (sk= (sk-vec 1 2) (sk-set 1 2))))
  (is (not (sk= (sk-vec 1 2) (sk-vec 1 2 3)))))

(test hashing-is-consistent-with-equality
  (flet ((same (a b)
           (is (sk= a b))
           (is (= (skein.runtime:hash-of a) (skein.runtime:hash-of b))
               "~A and ~A are equal but hash differently" (pr a) (pr b))))
    (same (sk-vec 1 2 3) (sk-list 1 2 3))
    (same (sk-vec 1 2) (c "map" #'identity (sk-vec 1 2)))
    (same (sk-vec) skein.runtime:+empty-list+)
    (same 1.0d0 1.0f0)
    (same 0.0d0 -0.0d0)
    (same (sk-map :a 1 :b 2) (sk-map :b 2 :a 1))
    (same (sk-set 1 2 3) (sk-set 3 1 2))
    (same (c "keys" (sk-map :a 1)) (sk-list :a))
    (same "abc" (copy-seq "abc"))))

(test compare-and-sort
  (is (= -1 (c "compare" 1 2)))
  (is (= 0 (c "compare" "a" "a")))
  (is (= 1 (c "compare" :b :a)))
  (is (= -1 (c "compare" nil 1)))
  (is (= -1 (c "compare" (sk-vec 1 2) (sk-vec 1 2 0))) "shorter vectors sort first")
  (is (= -1 (c "compare" (sk-vec 1 2) (sk-vec 1 3))))
  (is (= -1 (c "compare" skein.runtime:+false+ t)))
  (signals skein.runtime:unsupported-operation-error (c "compare" 1 "a"))
  (is (string= "(1 2 3)" (pr (c "sort" (sk-vec 3 1 2)))))
  (is (string= "(3 2 1)" (pr (c "sort" (lambda (a b) (> a b)) (sk-vec 1 3 2)))))
  (is (string= "(\"a\" \"bb\" \"ccc\")" (pr (c "sort-by" #'length (sk-vec "ccc" "a" "bb")))))
  (is (string= "()" (pr (c "sort" skein.runtime:+empty-vector+)))))

;;; Printing

(test printing-collections
  (is (string= "[1 \"a\" \\b :c nil]" (pr (sk-vec 1 "a" #\b :c nil))))
  (is (string= "[1 a b :c nil]" (skein.runtime:display-string (sk-vec 1 "a" #\b :c nil))))
  (is (string= "{:a [1 2]}" (pr (sk-map :a (sk-vec 1 2)))))
  (is (string= "#{:x}" (pr (sk-set :x))))
  (is (string= "(1 (2) ())" (pr (sk-list 1 (sk-list 2) skein.runtime:+empty-list+))))
  (is (string= "(0 1 2)" (pr (c "take" 3 (c "range")))))
  (is (string= "#<transient vector>" (pr (c "transient" (sk-vec)))))
  (is (string= "##Inf" (pr skein.runtime:+f64-infinity+))))

;;; Randomized tests against CL reference models

(defparameter *seed* 20261110)

(test random-vector-against-model
  (let ((rs (sb-ext:seed-random-state *seed*))
        (v skein.runtime:+empty-vector+)
        (model (make-array 0 :adjustable t :fill-pointer t))
        (snapshots '()))
    (dotimes (i 10000)
      (let ((n (length model)))
        (case (random 10 rs)
          ((0 1 2 3 4 5) (let ((x (random 1000000 rs)))
                           (setf v (skein.runtime:vector-conj v x))
                           (vector-push-extend x model)))
          ((6 7) (when (plusp n)
                   (let ((i (random n rs)) (x (random 1000000 rs)))
                     (setf v (skein.runtime:vector-assoc v i x)
                           (aref model i) x))))
          (8 (when (plusp n)
               (setf v (skein.runtime:pvector-pop v))
               (vector-pop model)))
          (9 (when (< (length snapshots) 20)
               (push (cons v (coerce model 'list)) snapshots)))))
      (unless (= (length model) (skein.runtime:count-of v))
        (fail "count differs after ~D operations" i)
        (return))
      (when (zerop (mod i 500))
        (unless (equal (coerce model 'list) (vector-contents v))
          (fail "contents differ after ~D operations" i)
          (return))))
    (is (equal (coerce model 'list) (vector-contents v)))
    (is (every (lambda (s) (equal (cdr s) (vector-contents (car s)))) snapshots)
        "old versions are unchanged")))

(test random-transient-vector-against-model
  (let ((rs (sb-ext:seed-random-state *seed*))
        (tv (skein.runtime:vector-transient skein.runtime:+empty-vector+))
        (model (make-array 0 :adjustable t :fill-pointer t))
        (snapshots '()))
    (dotimes (i 10000)
      (let ((n (length model)))
        (case (random 10 rs)
          ((0 1 2 3 4 5) (let ((x (random 1000000 rs)))
                           (skein.runtime:tvector-conj tv x)
                           (vector-push-extend x model)))
          ((6 7) (when (plusp n)
                   (let ((i (random n rs)) (x (random 1000000 rs)))
                     (skein.runtime:tvector-assoc tv i x)
                     (setf (aref model i) x))))
          (8 (when (plusp n)
               (skein.runtime:tvector-pop tv)
               (vector-pop model)))
          (9 (let ((p (skein.runtime:tvector-persistent tv)))
               (when (< (length snapshots) 20)
                 (push (cons p (coerce model 'list)) snapshots))
               (setf tv (skein.runtime:vector-transient p))))))
      (when (zerop (mod i 500))
        (unless (equal (coerce model 'list)
                       (vector-contents (let ((p (skein.runtime:tvector-persistent tv)))
                                          (setf tv (skein.runtime:vector-transient p))
                                          p)))
          (fail "contents differ after ~D operations" i)
          (return))))
    (is (every (lambda (s) (equal (cdr s) (vector-contents (car s)))) snapshots)
        "vectors made by persistent! are unchanged by later transient edits")))

(defun random-key (rs)
  (case (random 4 rs)
    (0 (random 3000 rs))
    (1 (colliding-key (random 40 rs)))
    (2 (format nil "k~D" (random 3000 rs)))
    (t (kw (format nil "k~D" (random 500 rs))))))

(defun map-matches-model-p (m model)
  (and (= (skein.runtime:map-count m) (hash-table-count model))
       (loop for k being the hash-keys of model using (hash-value v)
             always (eql v (skein.runtime:map-get m k :missing)))
       (= (hash-table-count model) (length (to-cl m)))))

(test random-map-against-model
  (let ((rs (sb-ext:seed-random-state *seed*))
        (m skein.runtime:+empty-map+)
        (model (make-hash-table :test 'equal))
        (snapshots '()))
    (dotimes (i 10000)
      (let ((k (random-key rs)))
        (case (random 10 rs)
          ((0 1 2 3 4) (let ((v (random 1000000 rs)))
                         (setf m (skein.runtime:map-assoc m k v)
                               (gethash k model) v)))
          ((5 6 7) (setf m (skein.runtime:map-dissoc m k))
           (remhash k model))
          (8 (unless (eql (gethash k model :missing) (skein.runtime:map-get m k :missing))
               (fail "lookup of ~S differs after ~D operations" k i)
               (return)))
          (9 (when (< (length snapshots) 10)
               (let ((copy (make-hash-table :test 'equal)))
                 (maphash (lambda (k v) (setf (gethash k copy) v)) model)
                 (push (cons m copy) snapshots))))))
      (unless (= (hash-table-count model) (skein.runtime:map-count m))
        (fail "count differs after ~D operations" i)
        (return))
      (when (zerop (mod i 1000))
        (unless (map-matches-model-p m model)
          (fail "contents differ after ~D operations" i)
          (return))))
    (is (map-matches-model-p m model))
    (is (every (lambda (s) (map-matches-model-p (car s) (cdr s))) snapshots)
        "old versions are unchanged")))

(test random-transient-map-against-model
  (let ((rs (sb-ext:seed-random-state *seed*))
        (tm (skein.runtime:map-transient skein.runtime:+empty-map+))
        (model (make-hash-table :test 'equal))
        (snapshots '()))
    (dotimes (i 10000)
      (let ((k (random-key rs)))
        (case (random 10 rs)
          ((0 1 2 3 4) (let ((v (random 1000000 rs)))
                         (skein.runtime:tmap-assoc tm k v)
                         (setf (gethash k model) v)))
          ((5 6 7) (skein.runtime:tmap-dissoc tm k)
           (remhash k model))
          (8 (unless (eql (gethash k model :missing) (skein.runtime:tmap-get tm k :missing))
               (fail "lookup of ~S differs after ~D operations" k i)
               (return)))
          (9 (let ((p (skein.runtime:tmap-persistent tm)))
               (unless (map-matches-model-p p model)
                 (fail "persistent! result differs after ~D operations" i)
                 (return))
               (when (< (length snapshots) 10)
                 (let ((copy (make-hash-table :test 'equal)))
                   (maphash (lambda (k v) (setf (gethash k copy) v)) model)
                   (push (cons p copy) snapshots)))
               (setf tm (skein.runtime:map-transient p)))))))
    (is (map-matches-model-p (skein.runtime:tmap-persistent tm) model))
    (is (every (lambda (s) (map-matches-model-p (car s) (cdr s))) snapshots)
        "maps made by persistent! are unchanged by later transient edits")))

(test random-set-against-model
  (let ((rs (sb-ext:seed-random-state *seed*))
        (s skein.runtime:+empty-set+)
        (model (make-hash-table :test 'equal)))
    (dotimes (i 10000)
      (let ((k (random-key rs)))
        (case (random 3 rs)
          (0 (setf s (c "conj" s k) (gethash k model) t))
          (1 (setf s (c "disj" s k)) (remhash k model))
          (t (unless (eq (if (gethash k model) t skein.runtime:+false+) (c "contains?" s k))
               (fail "contains? ~S differs after ~D operations" k i)
               (return))))
        (unless (= (hash-table-count model) (c "count" s))
          (fail "count differs after ~D operations" i)
          (return))))
    (is (= (hash-table-count model) (length (to-cl s))))))

(defun random-value (rs depth)
  "A random value, possibly a nested collection, built from a small domain so that equal
values come up often."
  (if (or (zerop depth) (< (random 10 rs) 5))
      (case (random 5 rs)
        (0 (random 5 rs)) (1 (kw (format nil "k~D" (random 3 rs))))
        (2 (format nil "s~D" (random 3 rs))) (3 nil) (t (* 1.0d0 (random 3 rs))))
      (let ((items (loop repeat (random 4 rs) collect (random-value rs (1- depth)))))
        (case (random 4 rs)
          (0 (apply #'sk-vec items))
          (1 (apply #'sk-list items))
          (2 (apply #'sk-set items))
          (t (skein.runtime:map-from-pairs
              (loop for x in items append (list x (random-value rs (1- depth))))))))))

(defun rebuilt (x rs)
  "Return a value equal to X built a different way: vectors as lists and back, maps and
sets with their entries shuffled."
  (cond ((skein.runtime:pvector-p x)
         (let ((items (mapcar (lambda (y) (rebuilt y rs)) (to-cl x))))
           (if (zerop (random 2 rs)) (apply #'sk-list items) (apply #'sk-vec items))))
        ((typep x '(or skein.runtime::plist skein.runtime::empty-list))
         (apply #'sk-vec (mapcar (lambda (y) (rebuilt y rs)) (to-cl x))))
        ((skein.runtime:hash-set-p x)
         (apply #'sk-set (shuffle (mapcar (lambda (y) (rebuilt y rs)) (to-cl x)) rs)))
        ((or (skein.runtime:array-map-p x) (skein.runtime:hash-map-p x))
         (skein.runtime:map-from-pairs
          (loop for e in (shuffle (to-cl x) rs)
                append (list (rebuilt (skein.runtime:vector-nth e 0) rs)
                             (rebuilt (skein.runtime:vector-nth e 1) rs)))))
        (t x)))

(defun shuffle (list rs)
  (let ((v (coerce list 'vector)))
    (loop for i from (1- (length v)) downto 1
          do (rotatef (aref v i) (aref v (random (1+ i) rs))))
    (coerce v 'list)))

(test random-equality-and-hashing
  (let ((rs (sb-ext:seed-random-state *seed*)))
    (dotimes (i 3000)
      (let* ((a (random-value rs 3))
             (b (rebuilt a rs))
             (other (random-value rs 3)))
        (unless (and (sk= a b) (sk= b a)
                     (= (skein.runtime:hash-of a) (skein.runtime:hash-of b)))
          (fail "~A and its rebuilt copy ~A differ" (pr a) (pr b))
          (return))
        (unless (eq (sk= a other) (sk= other a))
          (fail "= is not symmetric for ~A and ~A" (pr a) (pr other))
          (return))
        (when (and (sk= a other)
                   (/= (skein.runtime:hash-of a) (skein.runtime:hash-of other)))
          (fail "~A = ~A but their hashes differ" (pr a) (pr other))
          (return))
        (unless (sk= a (read-quoted (pr a)))
          (fail "~A does not read back equal" (pr a))
          (return))))
    (pass)))
