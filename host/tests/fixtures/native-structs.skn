(ns native-structs)

;; Value structs, records, typed arrays and defsoa natively (M1.8 step 5). The C backend
;; tests check that this prints the same natively as with `skein run`.

(defn message-of [thunk] (try (thunk) (catch error e (condition-message e))))

;; Structs
(defstruct vec2 :value (x f32) (y f32))
(defstruct rec (name) (n integer))
(defstruct box :value (p vec2) (w f64))
(prn (vec2 1.0f 2.0f) (vec2 :x 1.0f :y 3.0f) (rec "a" 1) (box (vec2 0.0f 1.0f) 2.0))
(prn (vec2-x (vec2 1.0f 2.0f)) (vec2? (vec2 1.0f 2.0f)) (vec2? 5) (struct? (rec "a" 1))
     (struct? {}) (:y (vec2 1.0f 2.0f)) (keys (rec "a" 1)) (with (vec2 1.0f 2.0f) :x 9.0f))
(prn (= (vec2 1.0f 2.0f) (vec2 1.0f 2.0f)) (= (vec2 1.0f 2.0f) (vec2 1.0f 3.0f))
     (= (rec "a" 1) (rec "a" 1)) (hash-of (vec2 1.0f 2.0f)) (hash-of (rec "a" 1))
     (get {(vec2 1.0f 2.0f) :found} (vec2 1.0f 2.0f)) (count #{(vec2 0.0f 0.0f) (vec2 1.0f 0.0f)}))
(prn (try (vec2 1 2) (catch error e :type-error)) (message-of (fn [] (vec2 1.0f)))
     (message-of (fn [] (with (vec2 1.0f 2.0f) :z 1))) (message-of (fn [] (vec2 :x 1.0f :z 2.0f)))
     (try (box (rec "a" 1) 1.0) (catch error e :type-error)))
(let [{:keys [x y]} (vec2 5.0f 6.0f)] (prn x y))
(prn (instance? vec2 (vec2 1.0f 2.0f)) (instance? vec2 (rec "a" 1)))
(defgeneric norm1 [v])
(defmethod norm1 [(v vec2)] (+ (abs (vec2-x v)) (abs (vec2-y v))))
(defmethod norm1 [v] :not-a-vec2)
(prn (norm1 (vec2 -1.0f 2.0f)) (norm1 3))

;; Typed arrays
(def a (make-array f32 3))
(def b (make-array vec2 2))
(def c (make-array any 2))
(def d (make-array i8 3))
(def e (make-array f64 2))
(def g (make-array box 2))
(aset! a 1 2.5f) (aset! b 1 (vec2 3.0f 4.0f)) (aset! c 0 :k) (aset! d 2 -5) (aset! e 0 1.5)
(aset! g 1 (box (vec2 1.0f 2.0f) 3.0))
(prn a b c d e g (aget b 1) (aget g 1) (count a) (count b) (count g))
(prn (seq a) (vec b) (reduce + a) (map inc d) (array? a) (array? b) (array? [1]) (seq (make-array f64 0)))
(prn (view a 1 3) (view (view a 1 3) 1) (count (as-bytes a)) (as-bytes d) (count (as-bytes e)))
(update! a 1 + 1.0f) (update! b 0 :x + 7.0f) (update! g 0 :w + 0.5) (update! g 1 :p (fn [_] (vec2 9.0f 9.0f)))
(prn a b g)
(prn (try (aget a 5) (catch error e :index)) (try (aset! a 0 1) (catch error e :type))
     (try (aset! d 0 300) (catch error e :range)) (try (aset! e 0 1.5f) (catch error e :type))
     (try (aset! b 0 (rec "x" 1)) (catch error e :struct)) (try (aget [1] 0) (catch error e :not-array)))
;; (Phase 0's char arrays are CL strings, so they print differently; not compared.)
(let [i (make-array i32 2) u (make-array u8 2) fx (make-array fixnum 2)]
  (aset! i 0 -2147483648) (aset! u 1 255) (aset! fx 1 123456789012)
  (prn i u fx (try (aset! u 0 -1) (catch error e :range))))

;; defsoa
(defsoa ps (pos vec2) (life f32))
(def s (make-ps 2))
(update! s 1 :pos (fn [_] (vec2 1.0f 2.0f)))
(update! s 1 :life + 3.0f)
(prn s (count s) (pos s 1) (life s 1) (aget s 1) (message-of (fn [] (pos a 0))))
