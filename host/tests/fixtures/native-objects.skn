(ns native-objects)

;; The object system natively (M1.8 step 4). The C backend tests check that this prints
;; the same natively as with `skein run`. (Phase 0 names built-in classes after CL's, so
;; this program doesn't print those.)

(defn message-of [thunk] (try (thunk) (catch error e (condition-message e))))

;; Classes, slots, inheritance and C3
(defclass shape [] (name :init "shape" :reader shape-name) (tags :init []))
(defclass circle [shape] (r :init 1) (name :init "circle"))
(defclass square [shape] (side :init 2))
(defclass named [] (label :init "?"))
(defclass labelled-circle [circle named] (extra))
(def c (make circle :r 3))
(def lc (make labelled-circle :label "L"))
(prn c lc (class-slots labelled-circle) (keys lc))
(prn (shape-name c) (shape-name (make square)) (:r c) (slot c :r) (get c :nope :nf) (get c :r))
(prn (mapv class-name (take 4 (class-precedence-list labelled-circle))))
(prn (instance? circle c) (instance? shape c) (instance? square c) (instance? named lc)
     (instance? 'object c) (instance? 'any c) (instance? 'integer 1) (instance? 'number 2.5)
     (instance? 'float 1.5f) (instance? 'seq '(1)) (instance? 'list (map inc [1]))
     (instance? 'seq (map inc [1])) (instance? 'nil-class nil) (instance? 'fn inc))
(prn (= (class-of c) circle) (class-name circle) (class-name 'integer))
(let [{:keys [r name]} c] (prn r name))

;; make, with and cells
(defclass counter []
  (n :cell :atom :init 0) (local :cell :unsynchronized :init 10) (fixed :init :f))
(def k (make counter))
(prn (update-slot! k :n + 5) (set-slot! k :n 7) (:n k) @(cell k :n))
(prn (set-slot! k :local 11) (update-slot! k :local inc) (:local k))
(set! (:local k) 20)
(prn (:local k))
(def k2 (with k :fixed :g))
(update-slot! k :n inc)
(prn (:n k) (:n k2) (:fixed k2) (:fixed k))
(def k3 (with k :fresh-cells true))
(update-slot! k :n inc)
(prn (:n k) (:n k3) (:n (with k :n 100)) (:n k))
(prn (message-of (fn [] (set-slot! k :fixed 1))) (message-of (fn [] (make counter :zzz 1)))
     (message-of (fn [] (cell k :fixed))) (message-of (fn [] (cell k :local)))
     (message-of (fn [] (slot k :zzz))) (message-of (fn [] (make counter :n)))
     (message-of (fn [] (with 5 :a 1))))

;; Generic functions: multiple dispatch, eql specializers, method combination
(def log (atom []))
(defn note [x] (swap! log conj x))
(defgeneric area [s])
(defmethod area [(s circle)] (* 3 (:r s) (:r s)))
(defmethod area [(s square)] (* (:side s) (:side s)))
(defmethod area [s] :unknown)
(prn (area c) (area (make square)) (area 5) (area lc))

(defgeneric meet [a b])
(defmethod meet [a b] [:any :any])
(defmethod meet [(a shape) b] [:shape :any])
(defmethod meet [(a circle) (b shape)] [:circle :shape])
(defmethod meet [(a shape) (b circle)] [:shape :circle])
(defmethod meet [(a circle) (b (= :wall))] [:circle :wall])
(defmethod meet [(a (= 1)) (b integer)] [:one :integer])
(defmethod meet [(a integer) (b number)] [:integer :number])
(defmethod meet [(a string) (b keyword)] [:string :keyword])
(defmethod meet [(a nil-class) b] [:nil :any])
(prn (meet c (make square)) (meet (make square) c) (meet c c) (meet c :wall) (meet c :door))
(prn (meet 1 2) (meet 2 3) (meet 1 2.5) (meet "s" :k) (meet nil 1) (meet [1] {}))

(defgeneric act [x])
(defmethod act [x] (note [:primary-any x]) :any)
(defmethod act [(x shape)] (note :primary-shape) [:shape (call-next-method)])
(defmethod act [(x circle)] (note :primary-circle) [:circle (next-method?) (call-next-method)])
(defmethod act :before [(x shape)] (note :before-shape))
(defmethod act :before [(x circle)] (note :before-circle))
(defmethod act :after [(x shape)] (note :after-shape))
(defmethod act :after [(x circle)] (note :after-circle))
(defmethod act :around [(x circle)] (note :around-circle) [:around (call-next-method)])
(defmethod act :around [(x shape)] (note :around-shape) (call-next-method))
(prn (act c) @log)
(reset! log [])
(prn (act 7) @log)

;; call-next-method with new arguments, next-method?, rest parameters
(defgeneric scale [s k & more])
(defmethod scale [s k & more] [:base k more])
(defmethod scale [(s circle) k & more] [:circle (call-next-method s (* 10 k)) (next-method?)])
(prn (scale c 2) (scale c 3 :a :b) (scale 5 1))
(defgeneric last-one [x])
(defmethod last-one [x] [(next-method?) (try (call-next-method) (catch error e :no-next))])
(prn (last-one 1))

;; Replacing a method, and errors
(defgeneric greet [x])
(defmethod greet [(x circle)] :old)
(defmethod greet [(x circle)] :new)
(prn (greet c) (count (generic-methods greet)))
(prn (message-of (fn [] (greet 5))) (try (meet c) (catch error e :arity))
     (message-of (fn [] (defmethod greet [a b] :two))))

;; initialize, and value equality through equiv and hash-of
(defclass tracked [] (id :init 0))
(defmethod initialize [(t tracked)] (note [:made (:id t)]))
(reset! log [])
(make tracked :id 1)
(make tracked :id 2)
(prn @log)
(defclass pt [] (x) (y))
(defmethod equiv [(a pt) b] (and (instance? pt b) (= (:x a) (:x b)) (= (:y a) (:y b))))
(defmethod hash-of [(p pt)] (hash-of [(:x p) (:y p)]))
(def p1 (make pt :x 1 :y 2))
(prn (= p1 (make pt :x 1 :y 2)) (= p1 (make pt :x 1 :y 3)) (= c (make circle :r 3)) (= c c))
(prn (count (hash-set p1 (make pt :x 1 :y 2) (make pt :x 0 :y 0)))
     (get {p1 :found} (make pt :x 1 :y 2))
     (message-of (fn [] #{p1 (make pt :x 1 :y 2)}))
     (message-of (fn [] {p1 1 (make pt :x 1 :y 2) 2}))
     (= (hash-of p1) (hash-of (make pt :x 1 :y 2))))

;; Condition types as specializers
(defcondition oops [error] (code :reader oops-code))
(defgeneric describe-c [x])
(defmethod describe-c [x] :other)
(defmethod describe-c [(x error)] :an-error)
(defmethod describe-c [(x oops)] [:oops (oops-code x) (call-next-method)])
(defmethod describe-c [(x arithmetic-error)] :arithmetic)
(prn (describe-c (make-condition oops :code 4)) (describe-c (try (/ 1 0) (catch error e e)))
     (describe-c (try (error "plain") (catch error e e))) (describe-c :k))
