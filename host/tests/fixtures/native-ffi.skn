(ns native-ffi
  (:require [skein.ffi :as ffi]))

;; The FFI natively (M1.10): built by skeinc, it must print what `skein run` prints
;; (host/tools/bootstrap.sh checks). Phase 0's FFI tests (host/tests/ffi.lisp) are the
;; model. Addresses aren't printed: they differ between runs.

(defn message [thunk] (try (thunk) (catch error e (condition-message e))))

;; Structs and unions: sizes and layouts follow C's rules
(ffi/defcstruct point (x i32) (y i32))
(ffi/defcstruct rect (origin point) (size (array f32 2)) (tag u8))
(ffi/defcunion number (i i64) (f f32) (bytes (array u8 3)))
(ffi/defcstruct mixed (a u8) (b f64) (c u16) (d ptr) (e bool))
(prn [(ffi/sizeof point) (ffi/sizeof rect) (ffi/sizeof number) (ffi/sizeof f64)
      (ffi/sizeof ptr) (ffi/sizeof mixed)])

(prn (ffi/with-foreign [p (ffi/alloc point)]
       (ffi/put-field! p point :x 3)
       (ffi/put-field! p point :y -4)
       [(ffi/field p point :x) (ffi/field p point :y) (ffi/get p i32 1)]))

(ffi/defcunion num2 (i i32) (f f32))
(prn (ffi/with-foreign [p (ffi/alloc num2)]
       (ffi/put-field! p num2 :f 1.0f)
       (ffi/field p num2 :i)))

(ffi/defcstruct flag (on bool) (n u8))
(prn (ffi/with-foreign [p (ffi/alloc flag)]
       (ffi/put-field! p flag :on true)
       [(ffi/sizeof flag) (ffi/field p flag :on) (ffi/get p u8 0)]))

;; A nested struct or array field gives its address
(ffi/defcstruct line (from point) (to point) (tags (array u8 2)))
(prn (ffi/with-foreign [p (ffi/alloc line)]
       (let [to (ffi/field p line :to)
             tags (ffi/field p line :tags)]
         (ffi/put-field! to point :y 7)
         (ffi/put! tags u8 3 1)
         [(ffi/get p i32 3) (ffi/get p u8 17) (- (ffi/address to) (ffi/address p))])))

(prn (ffi/with-foreign [p (ffi/alloc mixed)]
       (ffi/put-field! p mixed :a 255)
       (ffi/put-field! p mixed :b 2.5)
       (ffi/put-field! p mixed :c 65535)
       (ffi/put-field! p mixed :d nil)
       (ffi/put-field! p mixed :e false)
       [(ffi/field p mixed :a) (ffi/field p mixed :b) (ffi/field p mixed :c)
        (ffi/field p mixed :d) (ffi/field p mixed :e) (ffi/get p u8 8)]))

;; Memory and pointers
(prn (ffi/with-foreign [p (ffi/alloc f32 4)]
       (ffi/put! p f32 2.5 1)
       (ffi/put! p f32 -1 3)
       [(ffi/get p f32 0) (ffi/get p f32 1) (ffi/get p f32 3) (ffi/null? p) (ffi/ptr? p)]))
(prn (ffi/with-foreign [p (ffi/alloc u8 8)]
       (let [q (ffi/ptr+ p 3)]
         (ffi/put! q u8 9)
         [(- (ffi/address q) (ffi/address p)) (ffi/get p u8 3)])))
(prn [(ffi/null? (ffi/null)) (ffi/null? nil) (ffi/ptr? 5) (ffi/ptr? nil)])
(prn (ffi/with-foreign [p (ffi/alloc i64 2)]
       (ffi/put! p i64 -2 0)
       (ffi/put! p u64 18446744073709551615 1)
       [(ffi/get p i64 0) (ffi/get p u64 0) (ffi/get p i64 1) (ffi/get p u64 1)
        (ffi/get p i8 0) (ffi/get p u16 0)]))
(prn (ffi/with-foreign [p (ffi/alloc ptr 2)]
       (ffi/put! p c-string "héllo ☃")
       (ffi/put! p ptr nil 1)
       [(ffi/get p c-string) (ffi/c-string (ffi/get p ptr)) (ffi/get p ptr 1)
        (ffi/c-string nil)]))

;; Owned pointers: freed by ffi/free, or by the GC when unreachable
(let [p (ffi/own (ffi/alloc u8 4))]
  (ffi/put! p u8 7 0)
  (prn [(ffi/get p u8 0) (ffi/ptr? p) (ffi/null? p)])
  (ffi/free p)
  (prn (message (fn [] (ffi/get p u8 0)))))
(dotimes [i 20000] (ffi/put! (ffi/own (ffi/alloc u8 256)) u8 1 0))
(prn :owned-churn-done)

;; Enums
(ffi/defcenum flags u32 (:a 1) (:b 2) (:c 4))
(prn [(ffi/enum-value flags :b) (ffi/enum-value flags [:a :c]) (ffi/enum-value flags 9)
      (ffi/enum-value flags nil)])
(ffi/defcstruct tagged (kind flags) (n i32))
(prn (ffi/with-foreign [p (ffi/alloc tagged)]
       (ffi/put-field! p tagged :kind [:b :c])
       [(ffi/field p tagged :kind) (ffi/sizeof tagged)]))

;; Handles
(prn (let [v [1 2]
           h (ffi/handle v)]
       [(integer? h) (identical? v (ffi/handle-value h)) (ffi/free-handle h)]))
(prn (not= (ffi/handle :a) (ffi/handle :a)))

;; Calling C (step 2): functions of the C library every process has loaded
(ffi/defcfun strlen "strlen" u64 [s c-string])
(ffi/defcfun c-abs "abs" i32 [x i32])
(ffi/defcfun ^:blocking getenv "getenv" c-string [name c-string])
(prn [(strlen "héllo") (strlen "") (c-abs -7) (string? (getenv "PATH"))
      (getenv "SKEIN_NO_SUCH_VARIABLE_42")])
(ffi/defcfun c-exp "exp" f64 [x f64])
(ffi/defcfun c-sqrtf "sqrtf" f32 [x f32])
(prn [(> (c-exp 1000.0) 1e300) (c-sqrtf 2.25) (c-exp 0)])
(ffi/defcfun memset "memset" ptr [p ptr, c i32, n u64])
(prn (let [p (ffi/own (ffi/alloc u8 4))]
       (memset p 7 4)
       [(ffi/get p u8 0) (ffi/get p u8 3)]))
(prn (let [a (make-array u8 6)]
       (memset (view a 2 4) 9 2)
       (vec a)))
(prn (let [a (make-array f32 2)
           bytes (as-bytes a)]
       (aset! a 0 1.5f)
       (aset! a 1 2.5f)
       (memset bytes 0 (count bytes))
       [(count bytes) (vec a)]))
(prn (let [a (make-array u8 4)]
       (ffi/pin [p a] (memset p 5 4))
       (vec a)))
(ffi/defcfun c-malloc "malloc" ^:owned (ptr u8) [n u64])
(ffi/defcfun c-malloc2 "malloc" ^:owned ptr [n u64])
(ffi/defcfun ^:blocking c-malloc3 "malloc" ^:borrowed ptr [n u64])
(prn (let [p (c-malloc 4) q (c-malloc2 4) r (c-malloc3 4)]
       (ffi/put! p u8 42 3)
       (ffi/free r)
       [(ffi/get p u8 3) (ffi/ptr? p) (ffi/null? q)]))
(dotimes [i 5000] (c-malloc 128))
(ffi/defcenum color (:red 0) (:green 5))
(ffi/defcfun color-abs "abs" i32 [x color])
(prn [(color-abs :green) (color-abs -3)])
;; (Arity and type errors in calls have SBCL's and CFFI's wording in Phase 0.)
(prn (message (fn [] (color-abs :blue))))

;; Callbacks (step 3): C calling Skein. The C library calls back only through qsort and
;; bsearch, so callbacks of other types are compiled but not called.
(ffi/defcfun qsort "qsort" void [base ptr, n u64, size u64, cmp ptr])
(ffi/defcfun ^:blocking qsort-blocking "qsort" void [base ptr, n u64, size u64, cmp ptr])
(ffi/defcfun bsearch "bsearch" ptr [key ptr, base ptr, n u64, size u64, cmp ptr])
(ffi/defcallback compare-ints i32 [a ptr, b ptr]
  (compare (ffi/get a i32) (ffi/get b i32)))
(defn sorted-with [sort-fn cmp xs]
  (let [a (make-array i32 (count xs))]
    (doseq [[i v] (map-indexed vector xs)] (aset! a i v))
    (sort-fn a (count xs) 4 cmp)
    (vec a)))
(prn (sorted-with qsort compare-ints [5 3 9 1 4]) (ffi/ptr? compare-ints))
(prn (let [a (make-array i32 4)]
       (doseq [i (range 4)] (aset! a i (* 10 i)))
       (ffi/with-foreign [key (ffi/alloc i32)]
         (ffi/put! key i32 20)
         (let [found (bsearch key a 4 4 compare-ints)]
           (ffi/put! key i32 25)
           [(ffi/get found i32) (bsearch key a 4 4 compare-ints)]))))
;; A comparator that allocates, so collections happen while C's frames are on the stack,
;; called directly and from a blocking call
(def comparisons (atom 0))
(ffi/defcallback compare-allocating i32 [a ptr, b ptr]
  (swap! comparisons inc)
  (let [junk (vec (range 40))]
    (compare (+ (ffi/get a i32) (count junk)) (+ (ffi/get b i32) (count junk)))))
(let [xs (vec (map (fn [i] (mod (* i 7919) 1000)) (range 2000)))]
  (prn [(= (sorted-with qsort compare-allocating xs) (vec (sort xs)))
        (= (sorted-with qsort-blocking compare-allocating xs) (vec (sort xs)))
        (> @comparisons 2000)]))
;; An error can't unwind through C: the callback warns and returns zero.
;; stderr: callback native-ffi/bad-compare signaled no; returning 0
(ffi/defcallback bad-compare i32 [a ptr, b ptr] (error "no"))
(prn (count (sorted-with qsort bad-compare [2 1])))
;; Nor can any other non-local exit: invoking a restart established outside the C call
;; is stopped where C called the callback, which warns and returns zero.
;; stderr: callback native-ffi/leaving-compare tried to exit through C; returning 0
(ffi/defcallback leaving-compare i32 [a ptr, b ptr] (invoke-restart 'skip-sort) 1)
(prn (restart-case (count (sorted-with qsort leaving-compare [2 1])) (skip-sort [] :skipped)))
;; A handler outside that catches a warning signaled in the callback is stopped too
(ffi/defcallback warning-compare i32 [a ptr, b ptr] (warn "careful") 1)
(prn (try (count (sorted-with qsort warning-compare [2 1])) (catch warning w :caught)))
(ffi/defcallback many-types f64 [a f32, b f64, c bool, d c-string, e u64, f i8, g flags]
  (+ a b))
(ffi/defcallback no-arguments void [] nil)
(ffi/defcallback gives-string c-string [] "hi")
(ffi/defcallback gives-flag bool [x i32] (pos? x))
(ffi/defcallback gives-enum flags [] :b)
(prn (mapv ffi/ptr? [many-types no-arguments gives-string gives-flag gives-enum]))

;; Errors
(prn (message (fn [] (ffi/with-foreign [p (ffi/alloc line)] (ffi/put-field! p line :to 0))))
     (message (fn [] (ffi/enum-value flags :zzz)))
     (message (fn [] (ffi/with-foreign [p (ffi/alloc point)] (ffi/field p point :z))))
     (message (fn [] (ffi/get 5 u8 0))))
