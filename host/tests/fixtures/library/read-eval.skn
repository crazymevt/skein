;; build: --eval
(ns read-eval
  (:require [skein.test :refer [deftest is are run-tests]]))

;; read-string and *print-length* in a program built with --eval (M2.11 step 4, D-093),
;; compared with read-eval.expected.

(deftest reading
  (are [x y] (= x y)
    '(1 2) (read-string "(1 2) ignored")
    [:a "b" \c] (read-string " [:a \"b\" \\c]")
    {:k 'sym} (read-string "{:k sym}")
    :read-eval/here (read-string "::here")
    42 (eval (read-string "(* 6 7)"))
    {:a true} (meta (read-string "^:a [1]"))
    {:b true} (meta (eval (read-string "'^:b [1]"))))
  (is (thrown? error (read-string "")))
  (is (thrown? error (read-string 5))))

(deftest evaluated-print-length
  (is (= "[1 2 ...]" (eval '(binding [*print-length* 2] (pr-str [1 2 3])))))
  (is (= "[1 ...]" (binding [*print-length* 1] (eval '(pr-str [1 2])))))
  (is (= 2 (binding [*print-length* 2] (eval '*print-length*)))))

(prn (select-keys (run-tests 'read-eval) [:test :fail :error]))
