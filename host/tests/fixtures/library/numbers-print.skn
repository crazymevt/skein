(ns numbers-print
  (:require [skein.test :refer [deftest is are testing run-tests]]))

;; skein.core's additions of M2.11 step 4 (D-093), natively, compared with
;; numbers-print.expected: numbers, bit operations, format, printing and files.

(deftest numbers
  (are [x y] (= x y)
    1.5 (parse-double "1.5")
    -250.0 (parse-double "-2.5e2")
    nil (parse-double "1.5x")
    nil (parse-double "")
    true (= ##Inf (parse-double "Infinity"))
    true (parse-boolean "true")
    false (parse-boolean "false")
    nil (parse-boolean "yes")
    true (int? 5)
    true (int? 9223372036854775807)
    false (int? 9223372036854775808)
    false (int? 1.0)
    true (pos-int? 1)
    false (pos-int? 0)
    true (nat-int? 0)
    true (neg-int? -1)
    true (double? 1.5)
    false (double? 1)
    true (= (hash [1 2]) (hash [1 2]))
    true (= (hash {:a 1}) (hash (assoc {} :a 1))))
  (let [u (random-uuid)]
    (is (= 36 (count u)))
    (is (= \4 (nth u 14)))
    (is (contains? #{\8 \9 \a \b} (nth u 19)))
    (is (not= u (random-uuid)))))

(deftest bits
  (are [x y] (= x y)
    8 (bit-and 12 10)
    14 (bit-or 12 10)
    6 (bit-xor 12 10)
    4 (bit-and-not 12 10)
    0 (bit-and 15 12 3)
    -13 (bit-not 12)
    1024 (bit-shift-left 1 10)
    4611686018427387904 (bit-shift-left 1 62)
    3 (bit-shift-right 12 2)
    -1 (bit-shift-right -4 5)
    9223372036854775807 (unsigned-bit-shift-right -1 1)
    true (bit-test 5 2)
    false (bit-test 5 1)
    7 (bit-set 5 1)
    1 (bit-clear 5 2)
    4 (bit-flip 5 0))
  (is (thrown? error (bit-and 1.5 2))))

(deftest formatting
  (are [x y] (= x y)
    "a 1 :b" (format "%s %d %s" "a" 1 :b)
    "[   42]" (format "[%5d]" 42)
    "[42   ]" (format "[%-5d]" 42)
    "[00042]" (format "[%05d]" 42)
    "[-0042]" (format "[%05d]" -42)
    "+7" (format "%+d" 7)
    "1,234,567" (format "%,d" 1234567)
    "ff FF 17 true false" (format "%x %X %o %b %b" 255 255 15 :x nil)
    "3.14" (format "%.2f" 3.14159)
    "2.500000" (format "%f" 2.5)
    "[  1.5]" (format "[%5.1f]" 1.5)
    "100% done\n" (format "%d%% done%n" 100)
    "ab" (format "%.2s" "abcdef")
    "A" (format "%c" \A)
    "HI" (format "%S" "hi"))
  (is (thrown-with-msg? error "too few arguments" (format "%d %d" 1)))
  (is (thrown-with-msg? error "no conversion" (format "%q" 1))))

(deftest printing
  (are [x y] (= x y)
    "[1 \"a\"] :b\n" (prn-str [1 "a"] :b)
    "[1 a] :b" (print-str [1 "a"] :b)
    "x\n" (println-str "x")
    "[1 2 ...]" (binding [*print-length* 2] (pr-str [1 2 3]))
    "[1 2 3]" (binding [*print-length* 3] (pr-str [1 2 3]))
    "(...)" (binding [*print-length* 0] (pr-str (range)))
    "(0 1 2 ...)" (binding [*print-length* 3] (pr-str (range)))
    "{:a 1, ...}" (binding [*print-length* 1] (pr-str {:a 1 :b 2}))
    "[[1 ...] ...]" (binding [*print-length* 1] (pr-str [[1 2] [3 4]]))
    "(0 1 ...)\n" (binding [*print-length* 2] (with-out-str (prn (range)))))
  (is (nil? *print-length*))
  (is (thrown-with-msg? error "--eval" (read-string "(1 2)"))))

(deftest files
  (let [path "build/examples/numbers-print-test.txt"]
    (spit path "one\n")
    (spit path 2 :append true)
    (is (= "one\n2" (slurp path)))
    (spit path "over")
    (is (= "over" (slurp path)))))

(prn (select-keys (run-tests 'numbers-print) [:test :fail :error]))
