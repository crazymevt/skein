(ns additions
  (:require [skein.ffi :as ffi]))

;; Structs and unions passed and returned by value, calls through function pointers, and
;; variadic calls (M2.13 steps 1 to 4, D-096), natively, with
;; host/tests/fixtures/ffi/additions.c, which the bootstrap builds into build/examples/.
;; Arguments are maps of the fields (nested maps for nested structs) or pointers to a
;; struct; results are owned pointers to a copy, read with ffi/field. Callbacks get
;; by-value parameters as owned pointers and return a map or a pointer. A variadic C
;; function gets a name for each shape of call, with & before the variadic parameters.

(ffi/deflibrary additions
  {:macos "libadditions.dylib" :linux "libadditions.so" :windows "additions.dll"})

(ffi/defcstruct vec2f (x f32) (y f32))
(ffi/defcstruct rectd (x f64) (y f64) (w f64) (h f64))
(ffi/defcstruct mixed (a i32) (b i64) (c u8))
(ffi/defcstruct color (r u8) (g u8) (b u8) (a u8))
(ffi/defcstruct frame (origin vec2f) (size vec2f))
(ffi/defcunion num (i i32) (f f32))
(ffi/defcstruct triple (v (array i32 3)))

(ffi/defcfun vec2-add "vec2_add" vec2f [a vec2f, b vec2f])
(ffi/defcfun vec2-dot "vec2_dot" f32 [a vec2f, b vec2f])
(ffi/defcfun rect-grow "rect_grow" rectd [r rectd, by f64])
(ffi/defcfun mixed-sum "mixed_sum" i64 [m mixed])
(ffi/defcfun mixed-make "mixed_make" mixed [a i32, b i64, c u8])
(ffi/defcfun color-invert "color_invert" color [c color])
(ffi/defcfun frame-offset "frame_offset" frame [f frame, dx f32])
(ffi/defcfun num-as-float "num_as_float" f32 [n num])
(ffi/defcfun num-from-int "num_from_int" num [i i32])
(ffi/defcfun triple-sum "triple_sum" i32 [t triple])
(ffi/defcfun apply-vec2 "apply_vec2" vec2f [f ptr, v vec2f])
(ffi/defcfun apply-rect "apply_rect" rectd [f ptr])
(ffi/defcfun apply-mixed "apply_mixed" i64 [f ptr])
(ffi/defcfun apply-color "apply_color" color [f ptr, c color])

(ffi/defcallback scale-vec2 vec2f [v vec2f, k f32]
  {:x (* k (ffi/field v vec2f :x)) :y (* k (ffi/field v vec2f :y))})

(ffi/defcallback swap-rect rectd [r rectd]
  {:x (ffi/field r rectd :y) :y (ffi/field r rectd :x)
   :w (ffi/field r rectd :h) :h (ffi/field r rectd :w)})

(ffi/defcallback sum-mixed i64 [m mixed]
  (+ (ffi/field m mixed :a) (ffi/field m mixed :b) (ffi/field m mixed :c)))

;; Returns the struct it was given: a pointer works as a result too.
(ffi/defcallback same-color color [c color] c)

(ffi/defcallback bad-color color [c color] (error "no color"))

(ffi/defcfun ops-table "ops_table" ptr [])
(ffi/defcfun-ptr call-binop i64 [a i64, b i64])
(ffi/defcfun vec2-add-pointer "vec2_add_pointer" ptr [])
(ffi/defcfun-ptr call-vec2-op vec2f [a vec2f, b vec2f])
;; One C function, two signatures (as objc_msgSend is bound once per message).
(ffi/defcfun length-of-string "length_of" u64 [s c-string])
(ffi/defcfun length-of-bytes "length_of" u64 [p ptr])

;; Small integers and floats are promoted in a ..., as C does.
(ffi/defcfun va-small "va_sum" f64 [types c-string & a i8, b i16, c u8, d i32])
(ffi/defcfun va-floats "va_sum" f64 [types c-string & x f32, y f64])
(ffi/defcfun va-mixed "va_sum" f64 [types c-string & n i64, x f32, m i32, s c-string])
(ffi/defcfun va-none "va_sum" f64 [types c-string &])
(ffi/defcfun format-row "va_format" c-string [fmt c-string & i i32, d f64, s c-string])
(ffi/defcfun-ptr va-sum-through f64 [types c-string & x f32, n i64])
(ffi/defcfun va-sum-pointer "va_sum_pointer" ptr [])

(defn fields [p type ks] (mapv (fn [k] (ffi/field p type k)) ks))

(defn -main [& args]
  (let [v (vec2-add {:x 1.5 :y 2.0} {:x 0.25 :y -1.0})]
    (prn :vec2-add (fields v vec2f [:x :y]))
    (prn :vec2-dot (vec2-dot v {:x 2.0 :y 4.0}))
    (prn :result-is-a-pointer (ffi/ptr? v)))
  (let [r (rect-grow {:x 10.0 :y 20.0 :w 100.0 :h 50.0} 2.5)]
    (prn :rect-grow (fields r rectd [:x :y :w :h]))
    (prn :pointer-argument (fields (rect-grow r 1.0) rectd [:x :w])))
  (prn :mixed-sum (mixed-sum {:a 1 :b 10000000000 :c 200}))
  (let [m (mixed-make -5 123456789012 7)]
    (prn :mixed-make (fields m mixed [:a :b :c]) (mixed-sum m)))
  (prn :color-invert (fields (color-invert {:r 10 :g 20 :b 30 :a 255}) color [:r :g :b :a]))
  (prn :missing-fields-are-zero (fields (color-invert {:a 1}) color [:r :g :b :a]))
  (let [f (frame-offset {:origin {:x 1.0 :y 2.0} :size {:x 3.0 :y 4.0}} 10.0)]
    (prn :frame-offset (fields (ffi/field f frame :origin) vec2f [:x :y])
         (fields (ffi/field f frame :size) vec2f [:x :y])))
  (prn :num-as-float (num-as-float {:f 2.5}))
  (prn :num-from-int (ffi/field (num-from-int 42) num :i))
  (let [t (ffi/alloc triple)]
    (dotimes [i 3] (ffi/put! (ffi/field t triple :v) i32 (* 10 (inc i)) i))
    (prn :triple-sum (triple-sum t))
    (ffi/free t))
  (prn :callback-vec2 (fields (apply-vec2 scale-vec2 {:x 1.5 :y -2.0}) vec2f [:x :y]))
  (prn :callback-rect (fields (apply-rect swap-rect) rectd [:x :y :w :h]))
  (prn :callback-mixed (apply-mixed sum-mixed))
  (prn :callback-pointer-result
       (fields (apply-color same-color {:r 1 :g 2 :b 3 :a 4}) color [:r :g :b :a]))
  (prn :callback-error (fields (apply-color bad-color {:r 1 :g 2 :b 3 :a 4}) color
                               [:r :g :b :a]))
  (let [t (ops-table)]
    (prn :vtable (call-binop (ffi/get t ptr 0) 6 7) (call-binop (ffi/get t ptr 1) 6 7)))
  (prn :pointer-by-value
       (fields (call-vec2-op (vec2-add-pointer) {:x 1.0 :y 2.0} {:x 3.0 :y 4.0}) vec2f [:x :y]))
  (let [bytes (ffi/alloc u8 4)]
    (dotimes [i 2] (ffi/put! bytes u8 65 i))
    (prn :one-symbol-two-signatures (length-of-string "hello") (length-of-bytes bytes))
    (ffi/free bytes))
  (prn :va-small (va-small "iiii" -3 1000 250 70000))
  (prn :va-floats (va-floats "dd" 1.5 2.25))
  (prn :va-mixed (va-mixed "ldip" 10000000000 0.5 -2 "four"))
  (prn :va-none (va-none ""))
  (prn :va-format (format-row "%d|%.2f|%s" 42 3.14159 "skein"))
  (prn :va-through-pointer (va-sum-through (va-sum-pointer) "dl" 0.25 7))
  (prn :nil-pointer (try (call-binop nil 1 2) (catch error e (condition-message e))))
  (prn :null-pointer (try (call-binop (ffi/null) 1 2) (catch error e (condition-message e))))
  (prn :arity (try (call-binop (ffi/get (ops-table) ptr 0) 1)
                   (catch error e (condition-type-name (condition-type e)))))
  (prn :not-a-struct (try (vec2-add 5 {:x 1.0 :y 1.0})
                          (catch error e (condition-message e))))
  (prn :no-such-field (try (vec2-add {:z 1.0} {:x 1.0 :y 1.0})
                           (catch error e (condition-message e)))))
