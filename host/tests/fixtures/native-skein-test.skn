(ns native-skein-test
  (:require [skein.test :refer [deftest is testing are use-fixtures run-tests successful?]]))

;; skein.test (M2.11 step 1, D-093): what run-tests reports for passing and failing
;; assertions, contexts, messages, are, thrown?, thrown-with-msg?, errors in and out of
;; is, and fixtures. Native and Phase 0 print the same.

(def log (atom []))
(use-fixtures :once (fn [f] (swap! log conj :once-before) (f) (swap! log conj :once-after)))
(use-fixtures :each (fn [f] (swap! log conj :each) (f)))

(defn boom [] (error "boom"))

(deftest arithmetic
  (testing "addition"
    (is (= 4 (+ 2 2)))
    (is (= 5 (+ 2 2)) "two and two")
    (testing "and inc"
      (are [x y] (= x (inc y)) 2 1, 3 2, 5 3)))
  (is (thrown? error (boom)))
  (is (thrown? error (+ 1 1)))
  (is (thrown-with-msg? error "oo" (boom)))
  (is (thrown-with-msg? error "xyz" (boom)))
  (is (nil? nil))
  (is (pos? (- 3 5)))
  (is (some #{3} [1 2])))

(deftest errors
  (is (= 1 (boom)))
  (boom))

(deftest passing (is true) (is (= [1 2] (vector 1 2))))

;; Defined again: it keeps its place.
(deftest passing (is (= :again :again)))

(let [r (run-tests 'native-skein-test)]
  (prn r (successful? r) (successful? {:test 1 :pass 1 :fail 0 :error 0}))
  (prn @log))
