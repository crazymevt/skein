(ns native-eval)

;; build: --eval
;; Evaluating code natively (M2.5, D-078). The bootstrap check builds this with skeinc's
;; --eval, which includes the front end and the program's own macros, and compares it
;; with `skein run`.

(defn- twice-form [x] (list '* 2 x))
(defmacro twice [x] (twice-form x))
(defmacro unless [test & body] `(if ~test nil (do ~@body)))

;; macroexpand-1, macroexpand and macroexpand-all, in the current namespace
(prn (macroexpand-1 '(twice 5)))
(prn (macroexpand '(unless false 1 2)))
(prn (macroexpand-1 '(when x 1)))
(prn (macroexpand '(-> a (b c) d)))
(prn (macroexpand-all '(when (twice 3) (unless x '(twice 4)))))
(prn (macroexpand-1 '(not-a-macro 1)) (macroexpand-1 'just-a-symbol) (macroexpand-1 5))
(prn (macroexpand '(native-eval/twice 7)))
(let [x 1]
  (prn (macroexpand-1 (list 'twice x))))

(defn -main []
  ;; -main runs in user, as in Phase 0: the program's macros by their full names only.
  (prn (macroexpand '(native-eval/twice 8)))
  (prn (macroexpand '(twice 9)))
  (prn (macroexpand '(->> 1 (+ 2) inc))))

;; eval: a form given as data, in the current namespace
(def ^:dynamic *depth* 0)
(defn depth [] *depth*)
(defgeneric describe [x])
(defmethod describe [(x integer)] [:integer x])
(prn (eval '(+ 1 2)) (eval 5) (eval "s") (eval '(twice 21)) (eval '(depth)))
(prn (eval '(let [a 1 b (+ a 1)] [a b])) (eval '((fn [x & more] [x more]) 1 2 3)))
(prn (eval '(loop [i 0 acc []] (if (< i 3) (recur (inc i) (conj acc i)) acc))))
(prn (eval '(letfn [(ev? [n] (if (zero? n) true (od? (dec n))))
                    (od? [n] (if (zero? n) false (ev? (dec n))))]
              [(ev? 10) (od? 7)])))
(prn (mapv (eval '(fn [x] (* x x))) [1 2 3]))
(prn (eval '(binding [*depth* 2] [(depth) (do (set! *depth* 3) (depth))])) (depth))
(prn (eval '(try (error "boom") (catch error e (condition-message e)))))
(prn (eval '(block* b (return-from* b 7) 8)) (eval '(let-values* [[a b] (values 1 2)] [a b])))
(prn (eval '(let [a (atom [])]
              (try (unwind-protect (error "x") (swap! a conj :cleaned)) (catch error e nil))
              @a)))
(prn (eval '(restart-case (invoke-restart 'use-value 9) (use-value [v] [:restarted v]))))
(prn (eval '(handler-case (with-nursery [n] @(spawn n (error "in a task")))
              (error [c] (condition-message c)))))

;; Definitions made by eval: vars of the current namespace, which compiled code sees
(defn scale [x] (* 2 x))
(eval '(defn scale [x] (* 3 x)))
(prn (scale 2) (eval '(scale 2)))
(eval '(defmethod describe [(x string)] [:string x]))
(prn (describe 1) (describe "s"))
(eval '(defmacro thrice [x] (list '* 3 x)))
(prn (eval '(thrice 5)) (macroexpand '(thrice 5)))
(eval '(defstruct point (x f64) (y f64)))
(prn (eval '(point-x (point 1.5 2.5))))
(prn (eval '(do (def a-var 1) (def b-var (inc a-var)) [a-var b-var])))

;; load-file and require: a namespace the program doesn't include, loaded from source
(eval '(ns native-eval.user (:require [native-eval.extra :as x])))
(prn (eval '(x/hello "eval")) (eval '(x/unless false :unless)) @(eval 'native-eval.extra/loads))
(eval '(ns native-eval))
(prn (reload 'native-eval.extra) @(eval 'native-eval.extra/loads))

;; Errors
(defn message-of [thunk] (try (thunk) (catch error e (condition-message e))))
(prn (message-of (fn [] (eval '(no-such-function 1)))))
(prn (message-of (fn [] (eval '(error "from eval")))))
(prn (message-of (fn [] (load-file "no/such/file.skn"))))
(prn (message-of (fn [] (reload 'no.such.namespace))))
(prn (message-of (fn [] (reload "x"))))

;; Typed code (step 5): evaluated code computes declared and inferred types unboxed, with
;; the C backend's checks. native-eval.typed (evaluated from source, required by code
;; evaluated here) has the same functions as these compiled ones; their results and error
;; messages must be the same. Only that is printed: Phase 0's messages for typed code are
;; SBCL's, and SBCL doesn't check a fixnum parameter's range.
(defn typed-sum ^f64 [xs]
  (declare (type (array f64) xs))
  (loop [^fixnum i 0 ^f64 acc 0.0]
    (if (< i (count xs)) (recur (inc i) (+ acc (* 2.0 (aget xs i)))) acc)))
(defn mixed [^fixnum n ^f64 x]
  (let [a (* n 2) b (/ n 4) c (+ x n) d (if (< x n) :less :more) e (sqrt (* x x))]
    [a b c d e (zero? (- n n)) (pos? x) (neg? x) (- x) (inc n) (dec x)]))
(defn index-at [^fixnum i] (let [a (make-array f64 2)] (aset! a 0 1.5) (aget a i)))
(defn divide [^f64 x ^f64 y] (/ x y))
(defn squared [^f64 x] (the f64 (* x x)))
(defn int-box [^fixnum n] (* n 3))

(let [_ (eval '(ns native-eval.typed-user (:require [native-eval.typed])))]
  (eval '(ns native-eval)))
(defn without-location
  "A message without its \" at file:line:col\" (the functions are defined in two files)."
  [m]
  (loop [i 0]
    (cond (> (+ i 4) (count m)) m
          (= " at " (subs m i (+ i 4))) (subs m 0 i)
          :else (recur (inc i)))))
(defn outcome [f & args]
  (try (apply f args) (catch error e [:error (without-location (condition-message e))])))
(def float-array (let [a (make-array f64 4)] (dotimes [i 4] (aset! a i (* 1.5 i))) a))
(prn (outcome typed-sum float-array) (outcome mixed 3 2.5) (outcome mixed 8 -1.0))
(doseq [[nm & args] [['typed-sum float-array] ['mixed 3 2.5] ['mixed 8 -1.0]
                     ['index-at 0] ['index-at 5] ['divide 1.0 4.0] ['divide 1.0 0.0]
                     ['squared 3.0] ['int-box 4611686018427387903]]]
  (let [compiled (apply outcome (eval (symbol "native-eval" (name nm))) args)
        evaluated (apply outcome (eval (symbol "native-eval.typed" (name nm))) args)]
    (prn nm (= compiled evaluated))))
