(test callable-collections
  (skein-is "({:a 1} :a)" "1")
  (skein-is "({:a 1} :b :nf)" ":nf")
  (skein-is "(:a {:a 1})" "1")
  (skein-is "(:a #{:a})" ":a")
  (skein-is "(#{1 2} 3)" "nil")
  (skein-is "([:x :y] 1)" ":y")
  (skein-is "(map :a [{:a 1} {:a 2}])" "(1 2)")
  (skein-is "(filter #{1 3} [1 2 3])" "(1 3)")
  (signals skein.runtime:index-error (skein-result "([1] 5)"))
  (signals skein.runtime:arity-error (skein-result "({} 1 2 3)")))

(test rest-args-are-lists
  (skein-is "((fn [& xs] xs) 1 2 3)" "(1 2 3)")
  (skein-is "((fn [& xs] (list? xs)) 1)" "true")
  (skein-is "((fn [& xs] xs))" "nil")
  (skein-is "(apply (fn [a & xs] [a xs]) [1 2 3])" "[1 (2 3)]"))
