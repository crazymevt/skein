;;;; Tests for seqs, lazy seqs, the core seq library and transducers (DESIGN §7).

(in-package #:skein.tests)

(def-suite skein.seqs :in all
  :description "Seqs, lazy seqs, the core seq library and transducers.")

(in-suite skein.seqs)

(defun read-quoted (string)
  "Read STRING as a quoted Skein form and evaluate it."
  (skein.backend.cl:load-string (format nil "(quote ~A)" string) :namespace "user"))

(defun skein-result (source)
  "Evaluate Skein SOURCE and return its printed value."
  (pr (skein.backend.cl:load-string source :namespace "user")))

(defmacro skein-is (source expected)
  `(is (string= ,expected (skein-result ,source))
       "~S gave ~A, expected ~A" ,source (skein-result ,source) ,expected))

;;; Laziness

(test lazy-seqs-are-realized-one-element-at-a-time
  (let ((calls 0))
    (let ((s (c "map" (lambda (x) (incf calls) x) (c "range"))))
      (is (zerop calls) "map does no work until asked")
      (is (= 0 (c "first" s)))
      (is (= 1 calls) "first realizes only one element")
      (c "first" s)
      (is (= 1 calls) "a realized element is cached")
      (is (= 1 (c "second" s)))
      (is (= 2 calls))))
  (let ((calls 0))
    (let ((s (c "cons" 1 (c "%lazy-seq" (lambda () (incf calls) nil)))))
      (c "rest" s)
      (is (zerop calls) "rest does not realize a lazy tail")
      (c "next" s)
      (is (= 1 calls) "next does"))))

(test lazy-seq-macro
  (skein-is "(do (defn nat [n] (lazy-seq (cons n (nat (inc n))))) (take 3 (nat 5)))" "(5 6 7)")
  (skein-is "(lazy-seq nil)" "()")
  (skein-is "(seq (lazy-seq nil))" "nil")
  (skein-is "(realized? (lazy-seq [1]))" "false"))

(test infinite-seqs
  (skein-is "(take 4 (iterate inc 10))" "(10 11 12 13)")
  (skein-is "(take 5 (cycle [1 2]))" "(1 2 1 2 1)")
  (skein-is "(take 3 (repeat :x))" "(:x :x :x)")
  (skein-is "(repeat 2 :y)" "(:y :y)")
  (skein-is "(nth (range) 1000)" "1000")
  (skein-is "(first (drop 100000 (range)))" "100000")
  (skein-is "(take 3 (filter even? (map inc (range))))" "(2 4 6)"))

;;; The core seq library, against CL reference computations on random lists

(defun random-ints (rs)
  (loop repeat (random 30 rs) collect (- (random 20 rs) 10)))

(defmacro check-against-cl ((xs rs n) &body clauses)
  "For N random lists XS, check each (skein-form cl-form) clause gives equal results."
  `(let ((,rs (sb-ext:seed-random-state *seed*)))
     (dotimes (i ,n)
       (let ((,xs (random-ints ,rs)))
         ,@(loop for (skein cl) in clauses
                 collect `(let ((got (to-cl ,skein)) (want ,cl))
                            (unless (equal got want)
                              (fail "~S on ~S: got ~S, want ~S" ',skein ,xs got want)
                              (return))))))
     (pass)))

(defun cl-partition (n xs &optional all)
  (loop for tail on xs by (lambda (l) (nthcdr n l))
        for chunk = (subseq tail 0 (min n (length tail)))
        when (or all (= (length chunk) n)) collect chunk))

(test seq-functions-match-cl
  (check-against-cl (xs rs 300)
    ((c "map" #'1+ (apply #'sk-vec xs)) (mapcar #'1+ xs))
    ((c "map" #'+ (apply #'sk-list xs) (c "range")) (loop for x in xs for i from 0 collect (+ x i)))
    ((c "filter" #'oddp (apply #'sk-vec xs)) (remove-if-not #'oddp xs))
    ((c "remove" #'oddp (apply #'sk-list xs)) (remove-if #'oddp xs))
    ((c "keep" (lambda (x) (and (plusp x) (* 2 x))) (apply #'sk-vec xs))
     (loop for x in xs when (plusp x) collect (* 2 x)))
    ((c "take" 5 (apply #'sk-vec xs)) (subseq xs 0 (min 5 (length xs))))
    ((c "drop" 5 (apply #'sk-vec xs)) (nthcdr 5 xs))
    ((c "take-while" #'minusp (apply #'sk-vec xs)) (loop for x in xs while (minusp x) collect x))
    ((c "drop-while" #'minusp (apply #'sk-vec xs)) (member-if-not #'minusp xs))
    ((c "concat" (apply #'sk-vec xs) (apply #'sk-list xs)) (append xs xs))
    ((c "reverse" (apply #'sk-vec xs)) (reverse xs))
    ((c "sort" (apply #'sk-vec xs)) (sort (copy-list xs) #'<))
    ((c "distinct" (apply #'sk-vec xs)) (remove-duplicates xs :from-end t))
    ((c "map" #'to-cl (c "partition" 3 (apply #'sk-vec xs))) (cl-partition 3 xs))
    ((c "map" #'to-cl (c "partition-all" 3 (apply #'sk-vec xs))) (cl-partition 3 xs t))
    ((c "mapcat" (lambda (x) (sk-list x x)) (apply #'sk-vec xs))
     (mapcan (lambda (x) (list x x)) xs))
    ((c "interpose" 0 (apply #'sk-vec xs)) (butlast (mapcan (lambda (x) (list x 0)) xs)))
    ((c "map-indexed" #'* (apply #'sk-vec xs)) (loop for x in xs for i from 0 collect (* i x)))
    ((c "butlast" (apply #'sk-vec xs)) (butlast xs))
    ((c "nthrest" (apply #'sk-vec xs) 3) (nthcdr 3 xs))))

(test transducers-match-lazy-seqs
  ;; For each transducer, (into [] xf coll) must equal (vec (f ... coll)).
  (block outer
  (let ((rs (sb-ext:seed-random-state *seed*))
        (cases (list (list "map" #'1+) (list "filter" #'evenp) (list "remove" #'evenp)
                     (list "keep" (lambda (x) (and (plusp x) x)))
                     (list "take" 4) (list "drop" 4)
                     (list "take-while" #'minusp) (list "drop-while" #'minusp)
                     (list "mapcat" (lambda (x) (sk-list x 0))) (list "distinct")
                     (list "dedupe") (list "partition-all" 3) (list "map-indexed" #'+)
                     (list "interpose" :sep))))
    (dotimes (i 200)
      (let ((coll (apply #'sk-vec (random-ints rs))))
        (dolist (case cases)
          (let ((lazy (apply #'c (first case) (append (rest case) (list coll))))
                (xf (apply #'c (first case) (rest case))))
            (unless (and (sk= lazy (c "into" skein.runtime:+empty-vector+ xf coll))
                         (sk= lazy (c "sequence" xf coll)))
              (fail "~A transducer differs from the lazy seq on ~A" (first case) (pr coll))
              (return-from outer))))))
    (pass))))

(test transducer-entry-points
  (skein-is "(transduce (map inc) + [1 2 3])" "9")
  (skein-is "(transduce (map inc) + 100 [1 2 3])" "109")
  (skein-is "(transduce (filter odd?) conj [] (range 6))" "[1 3 5]")
  (skein-is "(into [] (comp (map inc) (filter even?) (take 2)) (range))" "[2 4]")
  (skein-is "(= #{0 1 2} (into #{} (map #(mod % 3)) (range 10)))" "true")
  (skein-is "(into {} (map (fn [x] [x (* x x)])) [1 2])" "{1 1, 2 4}")
  (skein-is "(into '(1) [2 3])" "(3 2 1)")
  (skein-is "(sequence (map inc) [])" "()")
  (skein-is "(take 3 (sequence (map inc) (range)))" "(1 2 3)")
  (skein-is "(reduce + (eduction (filter odd?) (map inc) (range 5)))" "6")
  (skein-is "(into [] cat [[1 2] [3]])" "[1 2 3]")
  (skein-is "(transduce (take 2) + (range))" "1")
  (skein-is "(transduce (comp (mapcat (fn [x] [x x])) (take 3)) conj [] [1 2 3])" "[1 1 2]")
  (skein-is "(transduce (partition-all 2) conj [] [1 2 3])" "[[1 2] [3]]")
  (skein-is "(reduce (fn [acc x] (if (> x 2) (reduced acc) (+ acc x))) 0 (range))" "3")
  (skein-is "(reduce + [])" "0")
  (skein-is "(reduce + [5])" "5")
  (skein-is "(reduce-kv (fn [acc k v] (+ acc k v)) 0 {1 2 3 4})" "10")
  (skein-is "(reduce-kv (fn [acc i x] (+ acc (* i x))) 0 [5 6 7])" "20")
  (skein-is "(transduce (map inc) (completing + (fn [x] (* 10 x))) [1 2])" "50"))

