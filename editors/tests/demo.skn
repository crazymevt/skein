(ns demo)

;; The program the scripted SLIME session (slime-session.el) runs with skein dev.

(defn greet
  "Say hi to n."
  [n]
  (str "hi " n))

(defn inner [x] (/ x 0))

(defonce go? (atom false))
(defonce result (atom nil))

(defn -main [& args]
  ;; Wait for the session, then fail in a way a restart fixes.
  (loop [] (when-not @go? (sleep 0.02) (recur)))
  (reset! result (restart-case (inner 1) (use-ten [] :report "Use ten" 10)))
  (sleep 600))
