(ns skein.core.native
  "skein.core's functions written in Skein for native programs (M1.8, D-051). Phase 0
implements them in CL; natively, the C backend compiles this namespace into every program
and sends calls of skein.core functions the Zig runtime lacks to the definitions here. On
the host it is an ordinary namespace, so the tests compare it with Phase 0's versions.

Definitions may use only what the C backend compiles at the current step of M1.8.")

(defn update
  "m with the value at k replaced by (f old-value args...)."
  ([m k f] (assoc m k (f (get m k))))
  ([m k f & args] (assoc m k (apply f (get m k) args))))

;;; ------------------------------------------------------------------------------------
;;; Seqs and transducers (step 2 of M1.8, D-052): ports of Phase 0's core-coll.lisp.
;;; Called with a collection, the seq functions return lazy seqs realized one element at
;;; a time (D-032); called without one, most return transducers. A transducer is a
;;; function of a reducing function, which has arities 0 (init), 1 (complete) and 2 (step).

(defn second "The second element." [coll] (first (next coll)))
(defn ffirst "The first element of the first element." [coll] (first (first coll)))
(defn nnext "(next (next coll))." [coll] (next (next coll)))

(defn last
  "The last element, walking the collection unless it is a vector."
  [coll]
  (if (vector? coll)
    (when (pos? (count coll)) (nth coll (dec (count coll))))
    (loop [s (seq coll) x nil]
      (if s (recur (next s) (first s)) x))))

(defn reverse
  "The elements in reverse order, as a list."
  [coll]
  (reduce (fn [acc x] (cons x acc)) '() coll))

(defn butlast
  "Every element but the last, as a list, or nil."
  [coll]
  (let [items (reduce conj [] coll)]
    (when (> (count items) 1)
      (loop [i (- (count items) 2) acc '()]
        (if (neg? i) acc (recur (dec i) (cons (nth items i) acc)))))))

(defn list*
  "A seq of the arguments, the last of which is a collection of the rest."
  [& args]
  (let [items (reduce conj [] args)
        n (count items)]
    (loop [i (- n 2) acc (seq (nth items (dec n)))]
      (if (neg? i) acc (recur (dec i) (cons (nth items i) acc))))))

;;; Functions

(defn comp
  "The composition of fns: the last is applied to the arguments, then each one before it
to the result."
  [& fns]
  (if (nil? (seq fns))
    identity
    (let [fs (reverse fns)]
      (fn [& args]
        (loop [r (apply (first fs) args) more (next fs)]
          (if more (recur ((first more) r) (next more)) r))))))

(defn partial
  "f with its first arguments fixed."
  [f & bound]
  (fn [& args] (apply f (concat bound args))))

(defn complement
  "A function returning the opposite truth of f's result, as a boolean."
  [f]
  (fn [& args] (if (apply f args) false true)))

(defn juxt
  "A function returning a vector of each fn's result."
  [& fns]
  (fn [& args] (reduce (fn [acc f] (conj acc (apply f args))) [] fns)))

(defn fnil
  "f, with a nil first argument replaced by default."
  [f default]
  (fn [x & args] (apply f (if (nil? x) default x) args)))

;;; Reduction, into and transducer entry points

(defn completing
  "A reducing function from f (steps and init), completing with cf (default: identity)."
  ([f] (completing f identity))
  ([f cf] (fn ([] (f)) ([acc] (cf acc)) ([acc x] (f acc x)))))

(defn transduce
  "Reduce coll with (xform f), then complete the result."
  ([xform f coll] (transduce xform f (f) coll))
  ([xform f init coll]
   (let [xf (xform f)]
     (xf (reduce xf init coll)))))

(defn reduce-kv
  "Reduce a map with (f acc key value), or a vector with (f acc index value)."
  [f init coll]
  (cond (nil? coll) init
        (map? coll) (reduce (fn [acc entry] (f acc (nth entry 0) (nth entry 1))) init coll)
        (vector? coll) (loop [i 0 acc init]
                         (cond (reduced? acc) (unreduced acc)
                               (< i (count coll)) (recur (inc i) (f acc i (nth coll i)))
                               :else acc))
        :else (error (str "reduce-kv needs a map or vector, not " (pr-str coll)))))

(defn- into-coll [to from xform]
  (if (and (or (vector? to) (map? to) (set? to)) (not (sorted? to)))
    (let [rf (fn ([] (transient to)) ([acc] acc) ([acc x] (conj! acc x)))
          result (persistent! (if xform
                                (transduce xform rf (transient to) from)
                                (reduce rf (transient to) from)))]
      ;; Transients drop metadata; into keeps to's (M2.11).
      (if (meta to) (with-meta result (meta to)) result))
    (let [rf (fn ([] to) ([acc] acc) ([acc x] (conj acc x)))]
      (if xform (transduce xform rf to from) (reduce rf to from)))))

(defn into
  "to with the elements of from conj'ed on, passed through xform if given."
  ([] [])
  ([to] to)
  ([to from] (into-coll to from nil))
  ([to xform from] (into-coll to from xform)))

(defn- cons-all
  "The elements of the vector items consed onto tail, in order."
  [items tail]
  (loop [i (dec (count items)) acc tail]
    (if (neg? i) acc (recur (dec i) (cons (nth items i) acc)))))

(defn- transformed-seq
  "A lazy seq of coll's elements passed through the transducer xform."
  [xform coll]
  (let [buffer (atom [])
        xf (xform (fn ([] nil) ([acc] acc) ([acc x] (swap! buffer conj x) acc)))
        source (atom (seq coll))
        done (atom false)]
    (letfn [(next-chunk []
              (lazy-seq
               (loop []
                 (cond (pos? (count @buffer))
                       (let [items @buffer]
                         (reset! buffer [])
                         (cons-all items (next-chunk)))
                       @done nil
                       :else (do (if @source
                                   (let [r (xf nil (first @source))]
                                     (reset! source (next @source))
                                     (when (reduced? r) (reset! source nil)))
                                   (do (reset! done true) (xf nil)))
                                 (recur))))))]
      (next-chunk))))

(defn sequence
  "coll as a seq, or () if it is empty; with xform, a lazy seq of coll through it."
  ([coll] (or (seq coll) '()))
  ([xform coll] (transformed-seq xform coll)))

(defn eduction
  "A collection with the transducers applied each time it is reduced or seq'd."
  [& xforms-and-coll]
  (let [xform (apply comp (butlast xforms-and-coll))
        coll (last xforms-and-coll)]
    (%eduction xform coll
               (fn [] (transformed-seq xform coll))
               (fn [f init]
                 (transduce xform (fn ([] (f)) ([acc] acc) ([acc x] (f acc x))) init coll)))))

;;; Seq functions

(defn- all-seqs
  "The seqs of colls (a seq of collections) as a vector, or nil if any is empty."
  [colls]
  (loop [cs (seq colls) out []]
    (if cs
      (let [s (seq (first cs))]
        (when s (recur (next cs) (conj out s))))
      out)))

(defn- map-firsts [seqs] (reduce (fn [acc s] (conj acc (first s))) [] seqs))
(defn- map-rests [seqs] (reduce (fn [acc s] (conj acc (rest s))) [] seqs))

(defn- lazy-map [f colls]
  (lazy-seq
   (let [seqs (all-seqs colls)]
     (when seqs
       (cons (apply f (map-firsts seqs)) (lazy-map f (map-rests seqs)))))))

(defn map
  "A lazy seq of f applied to the elements of the colls in step, or a transducer."
  ([f] (fn [rf] (fn ([] (rf)) ([acc] (rf acc)) ([acc x] (rf acc (f x))))))
  ([f & colls] (lazy-map f colls)))

(defn mapv
  "map, as a vector."
  [f & colls]
  (into [] (lazy-map f colls)))

(defn map-indexed
  "A lazy seq of (f index x), or a transducer."
  ([f] (fn [rf]
         (let [i (atom -1)]
           (fn ([] (rf)) ([acc] (rf acc)) ([acc x] (rf acc (f (swap! i inc) x)))))))
  ([f coll]
   (letfn [(walk [i coll]
             (lazy-seq (let [s (seq coll)]
                         (when s (cons (f i (first s)) (walk (inc i) (rest s)))))))]
     (walk 0 coll))))

(defn- lazy-filter [pred coll keep?]
  (lazy-seq
   (loop [s (seq coll)]
     (when s
       (let [x (first s)]
         (if (= keep? (if (pred x) true false))
           (cons x (lazy-filter pred (rest s) keep?))
           (recur (next s))))))))

(defn filter
  "A lazy seq of the elements for which pred is true, or a transducer."
  ([pred] (fn [rf] (fn ([] (rf)) ([acc] (rf acc)) ([acc x] (if (pred x) (rf acc x) acc)))))
  ([pred coll] (lazy-filter pred coll true)))

(defn filterv "filter, as a vector." [pred coll] (into [] (lazy-filter pred coll true)))

(defn remove
  "A lazy seq of the elements for which pred is false, or a transducer."
  ([pred] (fn [rf] (fn ([] (rf)) ([acc] (rf acc)) ([acc x] (if (pred x) acc (rf acc x))))))
  ([pred coll] (lazy-filter pred coll false)))

(defn keep
  "A lazy seq of the non-nil results of f, or a transducer."
  ([f] (fn [rf] (fn ([] (rf)) ([acc] (rf acc))
                  ([acc x] (let [v (f x)] (if (nil? v) acc (rf acc v)))))))
  ([f coll]
   (letfn [(walk [coll]
             (lazy-seq (loop [s (seq coll)]
                         (when s
                           (let [v (f (first s))]
                             (if (nil? v) (recur (next s)) (cons v (walk (rest s)))))))))]
     (walk coll))))

(defn take
  "A lazy seq of the first n elements, or a transducer."
  ([n] (fn [rf]
         (let [left (atom n)]
           (fn ([] (rf)) ([acc] (rf acc))
             ([acc x] (let [acc (if (pos? @left) (rf acc x) acc)]
                        (swap! left dec)
                        (cond (pos? @left) acc
                              (reduced? acc) acc
                              :else (reduced acc))))))))
  ([n coll]
   (letfn [(walk [n coll]
             (lazy-seq (when (pos? n)
                         (let [s (seq coll)]
                           (when s (cons (first s) (walk (dec n) (rest s))))))))]
     (walk n coll))))

(defn drop
  "A lazy seq of all but the first n elements, or a transducer."
  ([n] (fn [rf]
         (let [left (atom n)]
           (fn ([] (rf)) ([acc] (rf acc))
             ([acc x] (if (pos? @left) (do (swap! left dec) acc) (rf acc x)))))))
  ([n coll]
   (lazy-seq (loop [s (seq coll) i 0]
               (if (and s (< i n)) (recur (next s) (inc i)) s)))))

(defn take-while
  "A lazy seq of the elements while pred is true, or a transducer."
  ([pred] (fn [rf] (fn ([] (rf)) ([acc] (rf acc))
                     ([acc x] (if (pred x) (rf acc x) (reduced acc))))))
  ([pred coll]
   (letfn [(walk [coll]
             (lazy-seq (let [s (seq coll)]
                         (when (and s (pred (first s)))
                           (cons (first s) (walk (rest s)))))))]
     (walk coll))))

(defn drop-while
  "A lazy seq of the elements from the first one for which pred is false, or a
transducer."
  ([pred] (fn [rf]
            (let [dropping (atom true)]
              (fn ([] (rf)) ([acc] (rf acc))
                ([acc x] (if (and @dropping (pred x))
                           acc
                           (do (reset! dropping false) (rf acc x))))))))
  ([pred coll]
   (lazy-seq (loop [s (seq coll)]
               (if (and s (pred (first s))) (recur (next s)) s)))))

(defn- lazy-concat [colls]
  (lazy-seq
   (loop [colls (seq colls)]
     (when colls
       (let [s (seq (first colls))]
         (if s
           (cons (first s) (lazy-concat (cons (rest s) (next colls))))
           (recur (next colls))))))))

(defn concat "A lazy seq of the elements of each coll in turn." [& colls] (lazy-concat colls))

(defn- lazy-concat-seq
  "Concatenate a (possibly lazy, possibly infinite) seq of collections."
  [seqs]
  (letfn [(walk [current more]
            (lazy-seq
             (loop [current current more more]
               (let [s (seq current)]
                 (if s
                   (cons (first s) (walk (rest s) more))
                   (let [m (seq more)]
                     (when m (recur (first m) (rest m)))))))))]
    (walk nil seqs)))

(defn cat
  "A transducer that concatenates the collections passing through it."
  [rf]
  (fn ([] (rf)) ([acc] (rf acc))
    ([acc x] (reduce (fn [a y] (let [r (rf a y)] (if (reduced? r) (reduced r) r))) acc x))))

(defn mapcat
  "The concatenation of map's results, or a transducer."
  ([f] (fn [rf] ((map f) (cat rf))))
  ([f & colls] (lazy-concat-seq (lazy-map f colls))))

(defn- range-from [i end step]
  (lazy-seq
   (when (or (nil? end)
             (cond (pos? step) (< i end) (neg? step) (> i end) :else true))
     (cons i (range-from (+ i step) end step)))))

(defn range
  "A lazy seq of numbers: from 0, from 0 below end, or from start below end by step."
  ([] (range-from 0 nil 1))
  ([end] (range-from 0 end 1))
  ([start end] (range-from start end 1))
  ([start end step] (range-from start end step)))

(defn- repeat-from [n x]
  (lazy-seq (when (or (nil? n) (pos? n))
              (cons x (repeat-from (when n (dec n)) x)))))

(defn repeat
  "An infinite lazy seq of x, or n of them."
  ([x] (repeat-from nil x))
  ([n x] (repeat-from n x)))

(defn- repeatedly-from [n f]
  (lazy-seq (when (or (nil? n) (pos? n))
              (cons (f) (repeatedly-from (when n (dec n)) f)))))

(defn repeatedly
  "An infinite lazy seq of calls of f, or n of them."
  ([f] (repeatedly-from nil f))
  ([n f] (repeatedly-from n f)))

(defn iterate
  "x, (f x), (f (f x)), ..."
  [f x]
  (lazy-seq (cons x (iterate f (f x)))))

(defn cycle
  "The elements of coll, repeated forever."
  [coll]
  (if (nil? (seq coll))
    '()
    (letfn [(walk [s] (lazy-seq (let [s (or (seq s) (seq coll))]
                                  (cons (first s) (walk (rest s))))))]
      (walk coll))))

(defn interleave
  "A lazy seq of the first element of each coll, then the second, ..."
  [& colls]
  (letfn [(walk [colls]
            (lazy-seq
             (let [seqs (all-seqs colls)]
               (when (and seqs (pos? (count seqs)))
                 (cons-all (map-firsts seqs) (walk (map-rests seqs)))))))]
    (walk colls)))

(defn interpose
  "A lazy seq of the elements with sep between them, or a transducer."
  ([sep] (fn [rf]
           (let [started (atom false)]
             (fn ([] (rf)) ([acc] (rf acc))
               ([acc x] (if @started
                          (let [r (rf acc sep)] (if (reduced? r) r (rf r x)))
                          (do (reset! started true) (rf acc x))))))))
  ([sep coll]
   (lazy-seq (let [s (seq coll)]
               (when s
                 (cons (first s)
                       (lazy-concat-seq (lazy-map (fn [x] (list sep x)) [(rest s)]))))))))

(defn- take-items
  "Up to n elements of the seq s, as a vector."
  [n s]
  (loop [s s items []]
    (if (and s (< (count items) n)) (recur (next s) (conj items (first s))) items)))

(defn- list-of [items] (apply list items))

(defn partition
  "A lazy seq of lists of n elements, step apart (default n); a short last one is
dropped."
  ([n coll] (partition n n coll))
  ([n step coll]
   (letfn [(walk [coll]
             (lazy-seq (let [items (take-items n (seq coll))]
                         (when (= (count items) n)
                           (cons (list-of items) (walk (drop step coll)))))))]
     (walk coll))))

(defn partition-all
  "partition, keeping a short last one; or a transducer giving vectors."
  ([n] (fn [rf]
         (let [buffer (atom [])]
           (fn ([] (rf))
             ([acc] (let [acc (if (pos? (count @buffer))
                                (let [v @buffer]
                                  (reset! buffer [])
                                  (unreduced (rf acc v)))
                                acc)]
                      (rf acc)))
             ([acc x] (swap! buffer conj x)
              (if (= (count @buffer) n)
                (let [v @buffer] (reset! buffer []) (rf acc v))
                acc))))))
  ([n coll] (partition-all n n coll))
  ([n step coll]
   (letfn [(walk [coll]
             (lazy-seq (let [items (take-items n (seq coll))]
                         (when (pos? (count items))
                           (cons (list-of items) (walk (drop step coll)))))))]
     (walk coll))))

(defn distinct
  "A lazy seq of the elements without repeats, or a transducer."
  ([] (fn [rf]
        (let [seen (atom #{})]
          (fn ([] (rf)) ([acc] (rf acc))
            ([acc x] (if (contains? @seen x)
                       acc
                       (do (swap! seen conj x) (rf acc x))))))))
  ([coll]
   (letfn [(walk [coll seen]
             (lazy-seq (loop [s (seq coll)]
                         (when s
                           (let [x (first s)]
                             (if (contains? seen x)
                               (recur (next s))
                               (cons x (walk (rest s) (conj seen x)))))))))]
     (walk coll #{}))))

(defn dedupe
  "A lazy seq without consecutive repeats, or a transducer."
  ([] (fn [rf]
        (let [prev (atom ::none)]
          (fn ([] (rf)) ([acc] (rf acc))
            ([acc x] (if (and (not= @prev ::none) (= @prev x))
                       acc
                       (do (reset! prev x) (rf acc x))))))))
  ([coll] (transformed-seq (dedupe) coll)))

;;; Sorting: a stable merge sort, as Phase 0's stable-sort.

(defn- comparator-less
  "A test of a < b from a comparator returning a number or a boolean."
  [cmp]
  (fn [a b] (let [r (cmp a b)] (if (number? r) (neg? r) (if r true false)))))

(defn- merge-sorted [a b less? key]
  (loop [i 0 j 0 out (transient [])]
    (cond (= i (count a)) (persistent! (reduce conj! out (drop j b)))
          (= j (count b)) (persistent! (reduce conj! out (drop i a)))
          ;; Stable: take from b only when it is strictly less.
          (less? (key (nth b j)) (key (nth a i))) (recur i (inc j) (conj! out (nth b j)))
          :else (recur (inc i) j (conj! out (nth a i))))))

(defn- subvec* [v start end]
  (loop [i start out (transient [])]
    (if (< i end) (recur (inc i) (conj! out (nth v i))) (persistent! out))))

(defn- merge-sort [v less? key]
  (if (< (count v) 2)
    v
    (let [mid (quot (count v) 2)]
      (merge-sorted (merge-sort (subvec* v 0 mid) less? key)
                    (merge-sort (subvec* v mid (count v)) less? key)
                    less? key))))

(defn sort
  "The elements sorted by compare, or by a comparator, as a list."
  ([coll] (sort compare coll))
  ([cmp coll] (list-of (merge-sort (into [] coll) (comparator-less cmp) identity))))

(defn sort-by
  "The elements sorted by (keyfn x), as a list."
  ([keyfn coll] (sort-by keyfn compare coll))
  ([keyfn cmp coll] (list-of (merge-sort (into [] coll) (comparator-less cmp) keyfn))))

;;; Eager seq functions

(defn flatten
  "The non-sequential elements nested anywhere in coll, as a list."
  [coll]
  (letfn [(walk [x acc]
            (if (sequential? x)
              (reduce (fn [acc y] (walk y acc)) acc x)
              (conj! acc x)))]
    (list-of (persistent! (reduce (fn [acc x] (walk x acc)) (transient []) coll)))))

(defn frequencies
  "A map from each distinct element to how many times it appears."
  [coll]
  (persistent! (reduce (fn [t x] (assoc! t x (inc (get t x 0)))) (transient {}) coll)))

(defn index-of
  "The index of the first element of coll that is = to x, or nil."
  [coll x]
  (loop [s (seq coll) i 0]
    (cond (nil? s) nil
          (= x (first s)) i
          :else (recur (next s) (inc i)))))

(defn group-by
  "A map from each (f x) to the vector of elements that gave it."
  [f coll]
  (persistent! (reduce (fn [t x] (let [k (f x)] (assoc! t k (conj (get t k []) x))))
                       (transient {}) coll)))

(defn some
  "The first true result of pred, or nil."
  [pred coll]
  (loop [s (seq coll)]
    (when s (or (pred (first s)) (recur (next s))))))

(defn every?
  "True if pred is true for every element."
  [pred coll]
  (loop [s (seq coll)]
    (cond (nil? s) true
          (pred (first s)) (recur (next s))
          :else false)))

(defn not-every? "True unless pred is true for every element." [pred coll]
  (not (every? pred coll)))

(defn not-any? "True if pred is false for every element." [pred coll]
  (loop [s (seq coll)]
    (cond (nil? s) true
          (pred (first s)) false
          :else (recur (next s)))))

(defn nthrest "coll with its first n elements rest'ed off." [coll n]
  (loop [s coll n n] (if (pos? n) (recur (rest s) (dec n)) s)))

(defn nthnext "The seq after the first n elements, or nil." [coll n]
  (loop [s (seq coll) n n] (if (and s (pos? n)) (recur (next s) (dec n)) s)))

(defn split-at "[(take n coll) (drop n coll)]" [n coll] [(take n coll) (drop n coll)])

(defn split-with "[(take-while pred coll) (drop-while pred coll)]" [pred coll]
  [(take-while pred coll) (drop-while pred coll)])

(defn doall "Realize every element of coll; returns coll." [coll]
  (loop [s (seq coll)] (when s (recur (next s))))
  coll)

(defn dorun "Realize every element of coll; returns nil." [coll]
  (loop [s (seq coll)] (when s (recur (next s))))
  nil)

(defn set "The elements of coll as a set." [coll] (if (set? coll) coll (into #{} coll)))

;;; ------------------------------------------------------------------------------------
;;; Maps and nested collections (step 3 of M1.8, D-053): ports of Phase 0's.

(defn get-in
  "The value at the path of keys in nested collections, or not-found."
  ([m ks] (get-in m ks nil))
  ([m ks not-found]
   (loop [x m ks (seq ks)]
     (if ks
       (let [v (get x (first ks) ::not-found)]
         (if (= v ::not-found) not-found (recur v (next ks))))
       x))))

(defn assoc-in
  "m with the value at the path of keys set, making maps as needed."
  [m ks v]
  (let [k (first ks) more (next ks)]
    (assoc m k (if more (assoc-in (get m k) more v) v))))

(defn update-in
  "m with the value at the path of keys replaced by (f old args...)."
  [m ks f & args]
  (let [k (first ks) more (next ks)]
    (assoc m k (if more
                 (apply update-in (get m k) more f args)
                 (apply f (get m k) args)))))

(defn merge
  "The maps merged left to right (later keys win), or nil if all are nil."
  [& maps]
  (when (some identity maps)
    (reduce (fn [acc m] (if m (conj (or acc {}) m) acc)) maps)))

(defn merge-with
  "The maps merged, combining the values of a key in several with f."
  [f & maps]
  (when (some identity maps)
    (reduce (fn [acc m]
              (if (nil? m)
                acc
                (reduce (fn [result [k v]]
                          (assoc result k (if (contains? result k) (f (get result k) v) v)))
                        (or acc {}) m)))
            maps)))

(defn select-keys
  "A map of the entries of m whose keys are in ks."
  [m ks]
  (reduce (fn [result k] (if (contains? m k) (assoc result k (get m k)) result)) {} ks))

(defn zipmap
  "A map of keys to vals, pairing them in order."
  [ks vs]
  (loop [t (transient {}) ks (seq ks) vs (seq vs)]
    (if (and ks vs)
      (recur (assoc! t (first ks) (first vs)) (next ks) (next vs))
      (persistent! t))))

(defn find
  "The [key value] entry for key in the map m, or nil."
  [m k]
  (when (and m (contains? m k)) [k (get m k)]))

(defn key "The key of a map entry." [entry] (nth entry 0))
(defn val "The value of a map entry." [entry] (nth entry 1))

(defn empty
  "An empty collection of the same kind, or nil."
  [coll]
  (let [e (cond (vector? coll) []
                (sorted? coll) (%sorted-empty coll)
                (map? coll) {}
                (set? coll) #{}
                (seq? coll) '()
                :else nil)]
    ;; It keeps coll's metadata (M2.11).
    (if (and e (meta coll)) (with-meta e (meta coll)) e)))

(defn not-empty "coll, or nil if it is empty." [coll] (when (seq coll) coll))

;;; ------------------------------------------------------------------------------------
;;; Data parallelism (step 6 of M1.8): ports of Phase 0's concurrency.lisp. Tasks,
;;; nurseries and channels themselves are in the Zig runtime (runtime/src/tasks.zig).

(defn- parallel-ranges
  "Call (f start end) for ranges covering 0..n, at most one per CPU, in parallel. Returns
the results in order, as a vector."
  [n f]
  (if (zero? n)
    []
    (let [parts (max 1 (min n (cpu-count)))
          size (quot (+ n parts -1) parts)
          ranges (loop [start 0 acc []]
                   (if (< start n)
                     (recur (+ start size) (conj acc [start (min n (+ start size))]))
                     acc))]
      (if (<= (count ranges) 1)
        (mapv (fn [[start end]] (f start end)) ranges)
        (with-nursery [nursery]
          (mapv deref (mapv (fn [[start end]] (spawn nursery (f start end))) ranges)))))))

(defn pmap
  "(f x) for each x in coll, computed in parallel. Returns an eager list, in order."
  [f coll]
  (let [items (vec coll)
        chunks (parallel-ranges (count items)
                                (fn [start end]
                                  (loop [i start acc []]
                                    (if (< i end)
                                      (recur (inc i) (conj acc (f (nth items i))))
                                      acc))))
        all (reduce into [] chunks)]
    (loop [i (dec (count all)) acc ()]
      (if (neg? i) acc (recur (dec i) (cons (nth all i) acc))))))

(defn preduce
  "Reduce coll with f from init in parallel chunks, then reduce the chunks' results with
f from init: f must be associative, with init as its identity."
  [f init coll]
  (let [items (vec coll)]
    (reduce f init (parallel-ranges (count items)
                                    (fn [start end]
                                      (loop [i start acc init]
                                        (if (< i end)
                                          (recur (inc i) (f acc (nth items i)))
                                          acc)))))))

(defn %declaim
  "declaim's work at run time (D-056's native typed code): the declaration's form is
checked, as Phase 0 checks it; the native compiler doesn't use ftype declarations yet."
  [spec]
  (when-not (and (seq? spec) (symbol? (first spec)) (= "ftype" (name (first spec))))
    (error (str "declaim supports (ftype (fn [arg-types] return-type) names...), not "
                (pr-str spec))))
  nil)

(defn %pdotimes
  "pdotimes: call (f i) for each i from 0 below n, in parallel."
  [n f]
  (when-not (and (integer? n) (not (neg? n)))
    (error (str "pdotimes needs a non-negative count, not " (pr-str n))))
  (parallel-ranges n (fn [start end]
                       (loop [i start]
                         (when (< i end)
                           (f i)
                           (recur (inc i))))))
  nil)

;;; ------------------------------------------------------------------------------------
;;; Destructuring (DESIGN §5.4): skein.core's destructure, which the let, loop, doseq and
;;; for macros call. It works on plain data. Phase 0 has it in CL
;;; (host/src/expander/destructure.lisp); natively the macros compiled into the compiler
;;; call this one (M1.9, D-060). It was ported in M1.7, in skein.compiler.expander.

(defn- d-sym [nm] (symbol "skein.core" nm))

(defn- d-error [& parts] (error (apply str parts)))

(defn- keyword-named? [x nm]
  (and (keyword? x) (nil? (namespace x)) (= (name x) nm)))

(defn- named-key
  "For an entry s of a :keys, :strs or :syms vector (kind is that keyword, possibly
namespaced, as in :ns/keys): [local-symbol lookup-key-form]."
  [kind s]
  (let [s-ns (cond (symbol? s) (namespace s)
                   (keyword? s) (namespace s)
                   :else (d-error (pr-str kind) " needs symbols, not " (pr-str s)))
        ns (or (namespace kind) s-ns)
        nm (name s)
        local (if (and (symbol? s) (nil? s-ns)) s (symbol nm))]
    [local (case (name kind)
             "keys" (keyword ns nm)
             "strs" nm
             (list 'quote (symbol ns nm)))]))

(defn destructure
  "A binding vector that may contain destructuring patterns, turned into one that binds
only symbols."
  [bindings]
  (let [out (transient [])
        bind (fn [nm init] (conj! out nm) (conj! out init))
        fresh (fn [prefix] (symbol (name (gensym prefix))))]
    (letfn [(pb [pattern value]
              (cond (symbol? pattern)
                    (do (when (= (name pattern) "&")
                          (d-error "& must be followed by a binding inside a vector pattern"))
                        (bind pattern value))
                    (vector? pattern) (pvec pattern value)
                    (map? pattern) (pmap pattern value)
                    :else (d-error "unsupported binding form: " (pr-str pattern))))
            (pvec [pattern value]
              (let [g (fresh "vec__")]
                (bind g value)
                (loop [items (seq pattern) n 0]
                  (when items
                    (let [item (first items)]
                      (cond (and (symbol? item) (= (name item) "&") (nil? (namespace item)))
                            (do (when-not (next items) (d-error "& must be followed by a binding"))
                                (pb (second items) (list (d-sym "nthnext") g n))
                                (recur (nnext items) n))
                            (keyword-named? item "as")
                            (do (when-not (and (next items) (symbol? (second items)))
                                  (d-error ":as must be followed by a symbol"))
                                (bind (second items) g)
                                (recur (nnext items) n))
                            :else (do (pb item (list (d-sym "nth") g n nil))
                                      (recur (next items) (inc n)))))))))
            (pmap [pattern value]
              (let [g (fresh "map__")
                    entries (seq pattern)
                    find-key (fn [k] (some (fn [[ek ev]] (when (keyword-named? ek k) ev)) entries))
                    as (find-key "as")
                    defaults (find-key "or")]
                (bind g value)
                (bind g (list 'if (list (d-sym "seq?") g)
                              (list (d-sym "apply") (d-sym "hash-map") g)
                              g))
                (when as (bind as g))
                (let [lookup (fn [local key]
                               (if (and defaults (symbol? local) (contains? defaults local))
                                 (list (d-sym "get") g key (get defaults local))
                                 (list (d-sym "get") g key)))]
                  (doseq [[k v] entries]
                    (cond (or (keyword-named? k "as") (keyword-named? k "or")) nil
                          (and (keyword? k) (contains? #{"keys" "strs" "syms"} (name k)))
                          (do (when-not (vector? v)
                                (d-error (pr-str k) " needs a vector of names"))
                              (doseq [s v]
                                (let [[local key] (named-key k s)]
                                  (bind local (lookup local key)))))
                          (symbol? k) (bind k (lookup k v))
                          :else (pb k (list (d-sym "get") g v)))))))]
      (when-not (vector? bindings)
        (d-error "bindings must be a vector, not " (pr-str bindings)))
      (when (odd? (count bindings))
        (d-error "a binding vector needs an even number of forms"))
      (doseq [[pattern init] (partition 2 bindings)]
        (pb pattern init))
      (persistent! out))))

;;; ------------------------------------------------------------------------------------
;;; More of Clojure's functions (M2.11 step 3, D-093). Native only: Phase 0 doesn't have
;;; them (D-072), and their fixture is native.

(defn partition-by
  "A lazy seq of runs of consecutive elements for which f gives the same value."
  [f coll]
  (lazy-seq
   (when-let [s (seq coll)]
     (let [v (f (first s))
           run (cons (first s) (take-while (fn [x] (= v (f x))) (rest s)))]
       (cons run (partition-by f (drop (count run) s)))))))

(defn take-nth
  "A lazy seq of every nth element, starting with the first."
  [n coll]
  (when-not (pos? n) (error "take-nth needs a positive step, not" n))
  (lazy-seq
   (when-let [s (seq coll)]
     (cons (first s) (take-nth n (drop n s))))))

(defn take-last
  "A seq of the last n elements, or nil if there are none."
  [n coll]
  (let [v (vec coll)]
    (seq (subvec* v (max 0 (- (count v) n)) (count v)))))

(defn drop-last
  "A lazy seq of the elements but the last n (1)."
  ([coll] (drop-last 1 coll))
  ([n coll] (map (fn [x _] x) coll (drop n coll))))

(defn keep-indexed
  "A lazy seq of the non-nil results of (f index element)."
  [f coll]
  (keep (fn [[i x]] (f i x)) (map-indexed vector coll)))

(defn reductions
  "A lazy seq of the intermediate values of (reduce f init coll), init first."
  ([f coll]
   (lazy-seq
    (if-let [s (seq coll)]
      (reductions f (first s) (rest s))
      (list (f)))))
  ([f init coll]
   (cons init
         (lazy-seq
          (when-let [s (seq coll)]
            (reductions f (f init (first s)) (rest s)))))))

(defn tree-seq
  "A lazy seq of the nodes of a tree, depth first: branch? says whether a node has
children, which (children node) gives."
  [branch? children root]
  (letfn [(walk [node]
            (lazy-seq
             (cons node (when (branch? node) (mapcat walk (children node))))))]
    (walk root)))

(defn shuffle
  "The elements of coll in a random order, as a vector."
  [coll]
  (loop [v (vec coll) i (dec (count v))]
    (if (pos? i)
      (let [j (rand-int (inc i))]
        (recur (assoc v i (nth v j) j (nth v i)) (dec i)))
      v)))

(defn rand-nth
  "A random element of coll, which must not be empty."
  [coll]
  (nth coll (rand-int (count coll))))

(defn subvec
  "The elements of the vector v from index start up to end (or its end), as a vector."
  ([v start] (subvec v start (count v)))
  ([v start end]
   (when-not (<= 0 start end (count v))
     (error "subvec: no range" start "to" end "in a vector of" (count v)))
   (subvec* v start end)))

(defn rseq
  "The elements of a vector, or of a sorted map or set, in reverse order, or nil if it is
empty."
  [v]
  (if (sorted? v) (%sorted-seq v true) (seq (reverse v))))

(defn update-vals
  "m with f applied to each value."
  [m f]
  (persistent! (reduce-kv (fn [acc k v] (assoc! acc k (f v))) (transient {}) m)))

(defn update-keys
  "m with f applied to each key."
  [m f]
  (persistent! (reduce-kv (fn [acc k v] (assoc! acc (f k) v)) (transient {}) m)))

(defn run!
  "Call f on each element of coll, for its effects; nil."
  [f coll]
  (reduce (fn [_ x] (f x) nil) nil coll)
  nil)

(defn distinct?
  "True if no two of the arguments are equal."
  [& xs]
  (= (count xs) (count (set xs))))

(defn some-fn
  "A function that is true (the first true result) if any of the predicates is true of
any of its arguments."
  [& preds]
  (fn [& args] (some (fn [p] (some p args)) preds)))

(defn every-pred
  "A function that is true if every predicate is true of every one of its arguments."
  [& preds]
  (fn [& args] (boolean (every? (fn [p] (every? p args)) preds))))

(defn memoize
  "A function like f that keeps each result by its arguments and returns it again."
  [f]
  (let [cache (atom {})]
    (fn [& args]
      (if-let [e (find @cache args)]
        (val e)
        (let [v (apply f args)]
          (swap! cache assoc args v)
          v)))))

(defn trampoline
  "Call f (with args); while the result is a function, call it with no arguments. For
mutual recursion without growing the stack."
  ([f] (loop [r (f)] (if (fn? r) (recur (r)) r)))
  ([f & args] (trampoline (fn [] (apply f args)))))

(defn max-key
  "The x for which (k x) is greatest (the last of several)."
  [k x & more]
  (reduce (fn [a b] (if (>= (k b) (k a)) b a)) x more))

(defn min-key
  "The x for which (k x) is least (the last of several)."
  [k x & more]
  (reduce (fn [a b] (if (<= (k b) (k a)) b a)) x more))

;;; ------------------------------------------------------------------------------------
;;; References (step 5 of M2.11, D-093)

(defn vary-meta
  "x with the metadata (apply f (meta x) args)."
  [x f & args]
  (with-meta x (apply f (meta x) args)))

(defn- sorted-key
  "The key of an element of the seq of the sorted map or set sc."
  [sc x]
  (if (map? sc) (nth x 0) x))

(defn subseq
  "The elements of the sorted map or set sc whose keys pass (test key k), for test one of
<, <=, > and >=, in order; or between two bounds: (subseq sc >= 3 < 7)."
  ([sc test k]
   (let [include? (fn [x] (test (%sorted-compare sc (sorted-key sc x) k) 0))]
     (if (or (identical? test >) (identical? test >=))
       (when-let [s (%sorted-seq-from sc k false)]
         (if (include? (first s)) s (next s)))
       (take-while include? (%sorted-seq sc false)))))
  ([sc start-test start-k end-test end-k]
   (when-let [s (%sorted-seq-from sc start-k false)]
     (let [s (if (start-test (%sorted-compare sc (sorted-key sc (first s)) start-k) 0)
               s
               (next s))]
       (take-while (fn [x] (end-test (%sorted-compare sc (sorted-key sc x) end-k) 0)) s)))))

(defn rsubseq
  "The elements of the sorted map or set sc whose keys pass (test key k), in reverse
order; or between two bounds: (rsubseq sc > 3 <= 7)."
  ([sc test k]
   (let [include? (fn [x] (test (%sorted-compare sc (sorted-key sc x) k) 0))]
     (if (or (identical? test <) (identical? test <=))
       (when-let [s (%sorted-seq-from sc k true)]
         (if (include? (first s)) s (next s)))
       (take-while include? (%sorted-seq sc true)))))
  ([sc start-test start-k end-test end-k]
   (when-let [s (%sorted-seq-from sc end-k true)]
     (let [s (if (end-test (%sorted-compare sc (sorted-key sc (first s)) end-k) 0)
               s
               (next s))]
       (take-while (fn [x] (start-test (%sorted-compare sc (sorted-key sc x) start-k) 0))
                   s)))))

(defn force
  "The value of the delay x (running its body if no deref has); x itself if it isn't a
delay."
  [x]
  (if (delay? x) (deref x) x))

;;; ------------------------------------------------------------------------------------
;;; Numbers and printing (step 4 of M2.11, D-093)

(defn int?
  "True for an integer that fits in 64 bits, as Clojure's long."
  [x]
  (and (integer? x) (<= -9223372036854775808 x 9223372036854775807)))

(defn pos-int? "True for a positive int?." [x] (and (int? x) (pos? x)))
(defn neg-int? "True for a negative int?." [x] (and (int? x) (neg? x)))
(defn nat-int? "True for a non-negative int?." [x] (and (int? x) (not (neg? x))))

(defn parse-boolean
  "true for \"true\", false for \"false\", else nil."
  [s]
  (cond (not (string? s)) (error "parse-boolean needs a string, not" (pr-str s))
        (= s "true") true
        (= s "false") false
        :else nil))

(defn hash
  "x's hash, the one hash maps use: equal values have equal hashes (hash-of, for
instances of classes that specialize it)."
  [x]
  (hash-of x))

(def ^:private hex-digits "0123456789abcdef")

(defn random-uuid
  "A random (version 4) UUID, as its string: xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx."
  []
  (let [digit (fn [i]
                (cond (contains? #{8 13 18 23} i) "-"
                      (= i 14) "4"
                      (= i 19) (nth hex-digits (+ 8 (rand-int 4)))
                      :else (nth hex-digits (rand-int 16))))]
    (apply str (map digit (range 36)))))

(def ^:dynamic *print-length*
  "When bound to a non-negative integer n, collections print their first n elements and
then ..., so an infinite seq prints. nil prints them all."
  nil)

(%set-print-length-fn! (fn [] *print-length*))

(defn prn-str
  "What prn prints of xs, as a string."
  [& xs]
  (with-out-str (apply prn xs)))

(defn print-str
  "What print prints of xs, as a string."
  [& xs]
  (with-out-str (apply print xs)))

(defn println-str
  "What println prints of xs, as a string."
  [& xs]
  (with-out-str (apply println xs)))

(defn eprint
  "Print xs as print does, to stderr (D-112)."
  [& xs]
  (%write-stderr (with-out-str (apply print xs))))

(defn eprintln
  "Print xs as println does, to stderr (D-112)."
  [& xs]
  (%write-stderr (with-out-str (apply println xs))))

(defn slurp
  "The text of the file at path (UTF-8)."
  [path]
  (%read-file path))

(defn spit
  "Write the text of x (as str prints it) to the file at path, replacing it, or after
what it holds with :append true. Returns nil."
  [path x & {:keys [append]}]
  (%write-file path (if (and append (%file-exists? path))
                      (str (%read-file path) x)
                      (str x)))
  nil)

;;; format: Java's directives for the common cases.

(defn- pad
  "text padded to width with ch, at the left unless left?."
  [text width left? ch]
  (let [n (- width (count text))]
    (if (pos? n)
      (let [fill (apply str (repeat n ch))] (if left? (str text fill) (str fill text)))
      text)))

(defn- digits-of
  "The digits of the integer n in base radix (n not negative)."
  [n radix]
  (if (zero? n)
    "0"
    (loop [n n out ()]
      (if (zero? n)
        (apply str out)
        (recur (quot n radix) (cons (nth hex-digits (rem n radix)) out))))))

(defn- group-thousands
  "The digits text with a comma between each group of three."
  [text]
  (let [n (count text)]
    (apply str (map-indexed (fn [i ch]
                              (if (and (pos? i) (zero? (rem (- n i) 3))) (str "," ch) ch))
                            text))))

(defn- upper-case* [s]
  (apply str (map (fn [ch] (if (<= (int \a) (int ch) (int \z)) (char (- (int ch) 32)) ch)) s)))

(defn- format-integer [x radix flags]
  (when-not (integer? x)
    (error "format needs an integer for %d, %x, %o or %b, not" (pr-str x)))
  (let [text (digits-of (abs x) radix)
        text (if (contains? flags \,) (group-thousands text) text)]
    (cond (neg? x) (str "-" text)
          (contains? flags \+) (str "+" text)
          (contains? flags \space) (str " " text)
          :else text)))

(defn- format-float [x kind precision flags]
  (when-not (number? x) (error "format needs a number for %f or %e, not" (pr-str x)))
  (let [text (%format-number x kind (or precision 6))]
    (cond (and (not= (first text) \-) (contains? flags \+)) (str "+" text)
          (and (not= (first text) \-) (contains? flags \space)) (str " " text)
          :else text)))

(defn- format-one [conversion flags width precision x]
  (let [text (case conversion
               \s (let [t (print-str x)] (if precision (subs t 0 (min precision (count t))) t))
               \S (upper-case* (print-str x))
               \d (format-integer x 10 flags)
               \x (format-integer x 16 flags)
               \X (upper-case* (format-integer x 16 flags))
               \o (format-integer x 8 flags)
               \b (if (contains? #{nil false} x) "false" "true")
               \c (str (if (integer? x) (char x) x))
               \f (format-float x 0 precision flags)
               \e (format-float x 1 precision flags)
               (error (str "format has no conversion %" conversion)))
        left? (contains? flags \-)
        zero-pad? (and (contains? flags \0) (not left?)
                       (contains? #{\d \x \X \o \f \e} conversion))]
    (if (and zero-pad? width (contains? #{\- \+ \space} (first text)))
      (str (first text) (pad (subs text 1) (dec width) false \0))
      (pad text (or width 0) left? (if zero-pad? \0 \space)))))

(defn format
  "fmt with each directive replaced by the next of args, as Java's String.format writes
it: %s (as print), %S, %d, %x, %X, %o, %b, %c, %f and %e, with flags (- + space 0 ,), a
width and a precision (%-8s, %05d, %.2f), and %% and %n."
  [fmt & args]
  (let [n (count fmt)
        digit? (fn [ch] (and ch (<= (int \0) (int ch) (int \9))))]
    (loop [i 0 args args out []]
      (if (>= i n)
        (apply str out)
        (let [ch (nth fmt i)]
          (if (not= ch \%)
            (recur (inc i) args (conj out ch))
            (let [at (fn [j] (when (< j n) (nth fmt j)))
                  [flags j] (loop [j (inc i) flags #{}]
                              (if (contains? #{\- \+ \space \0 \,} (at j))
                                (recur (inc j) (conj flags (at j)))
                                [flags j]))
                  [width j] (loop [j j w nil]
                              (if (digit? (at j))
                                (recur (inc j) (+ (* 10 (or w 0)) (- (int (at j)) (int \0))))
                                [w j]))
                  [precision j] (if (= \. (at j))
                                  (loop [j (inc j) p 0]
                                    (if (digit? (at j))
                                      (recur (inc j) (+ (* 10 p) (- (int (at j)) (int \0))))
                                      [p j]))
                                  [nil j])
                  conversion (at j)]
              (cond
                (nil? conversion) (error "format's text ends inside a directive:" (pr-str fmt))
                (= conversion \%) (recur (inc j) args (conj out "%"))
                (= conversion \n) (recur (inc j) args (conj out "\n"))
                :else
                (do (when (empty? args)
                      (error (str "format has too few arguments for %" conversion)))
                    (recur (inc j) (rest args)
                           (conj out (format-one conversion flags width precision
                                                 (first args)))))))))))))

;;; ------------------------------------------------------------------------------------
;;; Regular expressions (M3.3, D-105): re-pattern and the matcher are the runtime's
;;; (regex.zig); these give Clojure's results. A result is the match's text when the
;;; pattern has no groups, else a vector of it and its groups (nil for one that didn't
;;; take part).

(defn- re-result [v]
  (if (= 2 (count v)) (nth v 1) (subvec v 1)))

(defn re-matches
  "The match of the pattern re (or a string, compiled) with the whole string s, or nil."
  [re s]
  (when-let [v (%re-exec (re-pattern re) s 0 true)]
    (re-result v)))

(defn- re-step
  "Where a search goes on after the match v: past it, or a character on after an empty
match; nil at the end."
  [s v]
  (let [end (nth v 0)]
    (if (= "" (nth v 1))
      (when (< end (%string-end s)) (%string-next s end))
      end)))

(defn re-seq
  "A lazy seq of the successive matches of the pattern re in the string s."
  [re s]
  (let [re (re-pattern re)]
    ((fn step [start]
       (lazy-seq
        (when-let [v (%re-exec re s start false)]
          (cons (re-result v) (when-let [next (re-step s v)] (step next))))))
     0)))

(defn re-matcher
  "A matcher of the pattern re over the string s, which re-find advances a match at a
time and re-groups reads the last match of."
  [re s]
  (atom {::matcher true ::re (re-pattern re) ::s s ::next 0 ::last nil}))

(defn re-find
  "The first match of the pattern re (or a string, compiled) in the string s, or nil;
with a matcher (re-matcher), its next match, or nil once there are no more."
  ([m]
   (let [{re ::re s ::s start ::next} @m]
     (when-not (and (map? @m) (::matcher @m))
       (error (str "re-find needs a matcher, not " (pr-str m))))
     (when start
       (if-let [v (%re-exec re s start false)]
         (do (swap! m assoc ::next (re-step s v) ::last v)
             (re-result v))
         (do (swap! m assoc ::next nil ::last nil) nil)))))
  ([re s]
   (when-let [v (%re-exec (re-pattern re) s 0 false)]
     (re-result v))))

(defn re-groups
  "The last match a matcher (re-matcher) found with re-find, as re-find gave it."
  [m]
  (let [v (::last @m)]
    (when-not v (error "re-groups: the matcher has no match"))
    (re-result v)))
