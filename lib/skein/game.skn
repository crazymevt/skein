(ns skein.game
  "Game-loop helpers (DESIGN §10, §15). Each frame runs with two restarts, so an error in
a frame can be fixed while the game is paused in the debugger:
  retry-frame  run the frame again from the start (after reloading the fix)
  skip-frame   give up on this frame and go on with the next"
  (:require [skein.time]))

(defmacro with-frame-restarts
  "Run body as one frame, with the retry-frame and skip-frame restarts established.
Returns the body's value, or nil if the frame was skipped."
  [& body]
  `(loop []
     (let [result# (restart-case [:done (do ~@body)]
                     (~'retry-frame [] :report "Run this frame again" [:retry nil])
                     (~'skip-frame [] :report "Skip the rest of this frame" [:skip nil]))]
       (if (= (first result#) :retry)
         (recur)
         (second result#)))))

(defn run-loop
  "Run a game loop until (running?) returns false; returns nil. Options:
  :frame    (fn []) called once per frame first, e.g. to handle input events
  :update   (fn [dt]) called at a fixed rate, dt = :step seconds each time
  :render   (fn [alpha]) called once per frame after the updates; alpha (0 to 1) is how
            far the clock is into the next step, for interpolating positions
  :step     the fixed timestep in seconds (default 1/60)
  :max-steps  the most updates per frame (default 5), so that a slow frame or a pause
            in the debugger doesn't make the game race to catch up
  :running? (fn []) the loop goes on while it returns true (default: always)
Each call of :frame, :update and :render runs with the retry-frame and skip-frame
restarts; retry-frame runs that call again. Without :update, only :frame and :render are
called, once per frame."
  [{:keys [frame update render step max-steps running?]
    :or {step (/ 1.0 60.0) max-steps 5 running? (constantly true)}}]
  (when-not (or frame update render)
    (error "run-loop needs a :frame, :update or :render function"))
  (when-not (pos? step)
    (error "run-loop's :step must be a positive number of seconds"))
  (let [step (f64 step)
        last-time (atom (skein.time/now))
        lag (atom 0.0)]
    (loop []
      (when (running?)
        (when frame (with-frame-restarts (frame)))
        (let [now (skein.time/now)]
          (swap! lag + (min (- now @last-time) (* step max-steps)))
          (reset! last-time now))
        (if update
          (loop []
            (when (>= @lag step)
              (with-frame-restarts (update step))
              (swap! lag - step)
              (recur)))
          (reset! lag 0.0))
        (when render (with-frame-restarts (render (if update (/ @lag step) 1.0))))
        (recur)))))
