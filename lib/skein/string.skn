(ns skein.string
  "String functions, after clojure.string (DESIGN §21, M2.11, D-093), and the cursors of
D-019. split, replace and replace-first take a string, a character or a regex pattern
(D-105) to match; the rest take a string or a character. Case functions change ASCII
letters only.

A cursor is a position in a string, at the start of a character or at its end: (cursor s)
is the start, (next s c) the cursor after the character at c, (char-at s c) that
character, (slice s from to) the text between two cursors. Walking a string by cursors
takes O(1) a step even where it isn't ASCII, where nth takes O(n). Cursors are opaque:
natively a byte offset, in Phase 0 a character index.")

;;; ------------------------------------------------------------------------------------
;;; Cursors

(defn cursor
  "The cursor at the start of s, or before the character at index i."
  ([s] (if (string? s) 0 (error "cursor needs a string, not" (pr-str s))))
  ([s i] (%string-index->cursor s i)))

(defn end
  "The cursor at the end of s."
  [s]
  (%string-end s))

(defn end?
  "True if the cursor c is at the end of s."
  [s c]
  (= c (%string-end s)))

(defn next
  "The cursor after the character at the cursor c of s (c itself at the end)."
  [s c]
  (%string-next s c))

(defn char-at
  "The character at the cursor c of s, or nil at the end."
  [s c]
  (%string-char-at s c))

(defn slice
  "The text of s from the cursor from to the cursor to (or to the end)."
  ([s from] (%string-slice s from (%string-end s)))
  ([s from to] (%string-slice s from to)))

(defn cursor->index
  "The index of the character at the cursor c of s."
  [s c]
  (%string-cursor->index s c))

;;; ------------------------------------------------------------------------------------
;;; Building strings

(defn builder
  "A string builder: append! adds text to it, and build gives the string."
  []
  {::parts (atom [])})

(defn append!
  "Add the text of each of xs (as str prints it) to the builder b; returns b."
  [b & xs]
  (swap! (::parts b) into (map str xs))
  b)

(defn build
  "The text added to the builder b so far."
  [b]
  (apply str @(::parts b)))

;;; ------------------------------------------------------------------------------------
;;; Looking at strings

(defn- text-of
  "The string a string or character x matches."
  [x what]
  (cond (string? x) x
        (char? x) (str x)
        :else (error (str what " needs a string or a character to match, not " (pr-str x)))))

(defn starts-with?
  "True if s starts with the string prefix."
  [s prefix]
  (= 0 (%string-find s prefix 0)))

(defn ends-with?
  "True if s ends with the string suffix."
  [s suffix]
  ;; Its last occurrence starts where a suffix would.
  (let [at (%string-find s suffix nil true)]
    (and (some? at) (= at (- (%string-end s) (%string-end suffix))))))

(defn includes?
  "True if s contains the string or character part."
  [s part]
  (some? (%string-find s (text-of part "includes?") 0)))

(defn index-of
  "The index of the first part (a string or character) in s, at or after the index from,
or nil."
  ([s part] (index-of s part 0))
  ([s part from]
   (when-let [c (%string-find s (text-of part "index-of") (%string-index->cursor s from))]
     (%string-cursor->index s c))))

(defn last-index-of
  "The index of the last part (a string or character) in s, or nil."
  [s part]
  (when-let [c (%string-find s (text-of part "last-index-of") nil true)]
    (%string-cursor->index s c)))

(defn- whitespace? [ch]
  (contains? #{\space \tab \newline \return \formfeed (char 11)} ch))

(defn blank?
  "True if s is nil, empty, or only whitespace."
  [s]
  (or (nil? s)
      (loop [c 0]
        (cond (end? s c) true
              (whitespace? (char-at s c)) (recur (next s c))
              :else false))))

;;; ------------------------------------------------------------------------------------
;;; Making strings

(defn upper-case
  "s with its ASCII letters in upper case."
  [s]
  (%string-ascii-case s true))

(defn lower-case
  "s with its ASCII letters in lower case."
  [s]
  (%string-ascii-case s false))

(defn capitalize
  "s with its first character in upper case and the rest in lower case (ASCII letters)."
  [s]
  (if (end? s 0)
    s
    (let [c (next s 0)]
      (str (upper-case (slice s 0 c)) (lower-case (slice s c))))))

(defn join
  "The strings of the elements of coll (as str prints them), with separator between them."
  ([coll] (apply str coll))
  ([separator coll] (apply str (interpose separator coll))))

(defn- first-non-blank [s]
  (loop [c 0]
    (if (and (not (end? s c)) (whitespace? (char-at s c))) (recur (next s c)) c)))

(defn- after-last-non-blank [s]
  (loop [c 0 after 0]
    (cond (end? s c) after
          (whitespace? (char-at s c)) (recur (next s c) after)
          :else (let [n (next s c)] (recur n n)))))

(defn triml
  "s without the whitespace at its start."
  [s]
  (slice s (first-non-blank s)))

(defn trimr
  "s without the whitespace at its end."
  [s]
  (slice s 0 (after-last-non-blank s)))

(defn trim
  "s without the whitespace at either end."
  [s]
  (let [start (first-non-blank s)]
    (if (end? s start) "" (slice s start (after-last-non-blank s)))))

(defn trim-newline
  "s without the newlines and carriage returns at its end."
  [s]
  (loop [c 0 after 0]
    (cond (end? s c) (slice s 0 after)
          (contains? #{\newline \return} (char-at s c)) (recur (next s c) after)
          :else (let [n (next s c)] (recur n n)))))

(defn reverse
  "The characters of s in the opposite order."
  [s]
  (loop [c 0 out ()]
    (if (end? s c) (apply str out) (recur (next s c) (cons (char-at s c) out)))))

(defn- replace-all [s match replacement first-only?]
  (let [match (text-of match "replace")
        replacement (str replacement)
        b (builder)]
    (when (= "" match) (error "replace needs something to match, not an empty string"))
    (loop [from 0]
      (let [at (%string-find s match from)]
        (if (nil? at)
          (do (append! b (slice s from)) (build b))
          (let [after (+ at (%string-end match))]
            (append! b (slice s from at) replacement)
            (if first-only?
              (do (append! b (slice s after)) (build b))
              (recur after))))))))

;;; Patterns (M3.3, D-105). A match from the runtime is [end g0 g1 ...]: where it ends (a
;;; cursor) and its groups' text, nil for a group that didn't take part.

(defn- match-start [v]
  (- (nth v 0) (%string-end (nth v 1))))

(defn- match-next
  "Where a search goes on after the match v: past it, or a character on after an empty
match (as Java's); nil at the end of s."
  [s v]
  (let [end (nth v 0)]
    (if (= "" (nth v 1))
      (when (< end (%string-end s)) (%string-next s end))
      end)))

(defn- digit [ch]
  (when (and ch (<= (int \0) (int ch) (int \9))) (- (int ch) (int \0))))

(defn- name-char? [ch first?]
  (let [i (int ch)]
    (or (<= (int \a) i (int \z)) (<= (int \A) i (int \Z)) (and (not first?) (digit ch)))))

(defn- template
  "The parts of the replacement string r, as Java's Matcher reads it for a pattern with
groups groups and the group names names: strings, and the numbers of groups. $n is group
n (as many digits as make a group), ${name} the named group, and a backslash takes the
character after it as it is."
  [r groups names]
  (let [n (end r)
        at (fn [c] (when (< c n) (char-at r c)))
        with-text (fn [parts text] (if (empty? text) parts (conj parts (apply str text))))
        fail (fn [why] (error (str "replace: " why " in the replacement " (pr-str r))))]
    (loop [c 0 text [] parts []]
      (let [ch (at c)]
        (cond
          (nil? ch) (with-text parts text)
          (= ch \\) (let [x (at (next r c))]
                      (when-not x (fail "a backslash with nothing after it"))
                      (recur (next r (next r c)) (conj text x) parts))
          (not= ch \$) (recur (next r c) (conj text ch) parts)
          :else
          (let [c (next r c)
                x (at c)]
            (cond
              (nil? x) (fail "a $ with no group after it")
              (= x \{)
              (let [close (%string-find r "}" c)
                    nm (when close (slice r (next r c) close))]
                (when-not close (fail "a ${ with no }"))
                (when-not (and (not= "" nm) (name-char? (char-at nm 0) true)
                               (every? (fn [ch] (name-char? ch false)) nm))
                  (fail (str "a group name that isn't one, " (pr-str nm))))
                (let [g (get names nm)]
                  (when-not g (fail (str "no group named " nm)))
                  (recur (next r close) [] (conj (with-text parts text) g))))
              (digit x)
              (let [first-g (digit x)]
                (when (> first-g groups) (fail (str "no group " first-g)))
                ;; Java's rule: more digits while they still make a group the pattern has.
                (let [[g c] (loop [g first-g c (next r c)]
                              (let [d (digit (at c))
                                    more (when d (+ (* 10 g) d))]
                                (if (and more (<= more groups))
                                  (recur more (next r c))
                                  [g c])))]
                  (recur c [] (conj (with-text parts text) g))))
              :else (fail (str "a $ followed by " (pr-str x))))))))))

(defn- replace-pattern [s re replacement first-only?]
  (let [re (re-pattern re)
        names (%re-names re)
        by-fn? (not (string? replacement))]
    (when (and by-fn? (not (ifn? replacement)))
      (error (str "replace needs a string or a function to replace a pattern's matches "
                  "with, not " (pr-str replacement))))
    ;; out gathers the pieces of the result; a template is read at the first match, as
    ;; Java's is, once the number of groups is known.
    (loop [search 0 copied 0 parts nil out (transient [])]
      (let [v (when search (%re-exec re s search false))]
        (if (nil? v)
          (apply str (persistent! (conj! out (slice s copied))))
          (let [out (conj! out (slice s copied (match-start v)))
                parts (if (or by-fn? parts)
                        parts
                        (template replacement (- (count v) 2) names))
                out (if by-fn?
                      (conj! out (str (replacement (if (= 2 (count v)) (nth v 1) (vec (rest v))))))
                      (reduce (fn [out p]
                                (if (string? p)
                                  (conj! out p)
                                  (if-let [g (nth v (inc p))] (conj! out g) out)))
                              out parts))]
            (if first-only?
              (apply str (persistent! (conj! out (slice s (nth v 0)))))
              (recur (match-next s v) (nth v 0) parts out))))))))

(defn replace
  "s with every match replaced. match is a string or character, replaced by the string
replacement as it is; or a pattern (#\"...\"), replaced by a string in which $1 is group 1,
${name} the named group and \\$ a dollar sign, or by (replacement m), m the match as
re-find gives it."
  [s match replacement]
  (if (%pattern? match)
    (replace-pattern s match replacement false)
    (replace-all s match replacement false)))

(defn replace-first
  "s with the first match replaced, as replace does."
  [s match replacement]
  (if (%pattern? match)
    (replace-pattern s match replacement true)
    (replace-all s match replacement true)))

(defn- drop-trailing-empty [parts]
  (loop [parts parts]
    (if (and (seq parts) (= "" (peek parts))) (recur (pop parts)) parts)))

(defn- split-pattern
  "The parts of s between the pattern re's matches, as Java's Pattern.split makes them:
no empty first part for an empty match at the start, and s itself if nothing matches."
  [s re limit]
  (let [re (re-pattern re)]
    (loop [search 0 from 0 parts []]
      (let [v (when (and search (or (<= limit 0) (< (inc (count parts)) limit)))
                (%re-exec re s search false))]
        (cond
          (nil? v) (if (and (= 0 from) (empty? parts)) [s] (conj parts (slice s from)))
          ;; An empty match at the very start splits off nothing.
          (and (= 0 from) (= 0 (nth v 0))) (recur (match-next s v) from parts)
          :else (recur (match-next s v) (nth v 0)
                       (conj parts (slice s from (match-start v)))))))))

(defn split
  "The parts of s between the separators (a string, a character or a pattern), as a
vector. Empty parts at the end are dropped, as Clojure's split drops them, unless limit
is given: then at most limit parts, the last holding the rest of s."
  ([s separator]
   (let [parts (split s separator 0)]
     ;; A pattern that matches nothing gives s itself, even "", as Java's split does.
     (if (and (%pattern? separator) (= 1 (count parts))) parts (drop-trailing-empty parts))))
  ([s separator limit]
   (if (%pattern? separator)
     (split-pattern s separator limit)
     (let [sep (text-of separator "split")]
       (when (= "" sep) (error "split needs a separator, not an empty string"))
       (loop [from 0 parts []]
         (let [at (when (or (<= limit 0) (< (inc (count parts)) limit))
                    (%string-find s sep from))]
           (if (nil? at)
             (conj parts (slice s from))
             (recur (+ at (%string-end sep)) (conj parts (slice s from at))))))))))

(defn split-lines
  "The lines of s, split at newlines (and a carriage return before one)."
  [s]
  (mapv (fn [line] (if (ends-with? line "\r") (slice line 0 (- (end line) 1)) line))
        (split s \newline)))

(defn escape
  "s with each character that the map cmap has a key for replaced by (str (cmap ch))."
  [s cmap]
  (let [b (builder)]
    (loop [c 0]
      (if (end? s c)
        (build b)
        (let [ch (char-at s c)]
          (append! b (if-let [r (get cmap ch)] r ch))
          (recur (next s c)))))))
