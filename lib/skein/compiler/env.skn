(ns skein.compiler.env
  "The compile-time environment of the native compiler (M1.9 step 3, D-060): the
namespaces and vars that the expander and the C backend see while they compile a
program, as skein.core's internal % functions.

In Phase 0 these functions reach the image the compiler runs in
(host/src/runtime/compile-env.lisp, namespaces.lisp). Natively, the program being
compiled must not share vars with the compiler that compiles it (DESIGN §4.4), so this
namespace models them instead: a namespace and a var are atoms holding maps. The C backend
sends calls of these skein.core functions here, as it sends the library's to
skein.core.native.

skein.core here holds the runtime's functions, the public functions of skein.core.native
(which also get their own namespace, as on the host),
the macros of lib/skein/core.skn compiled into the program (the runtime lists those it
registered), the built-in condition types, and the built-in macros ns, defmacro, defn and
defn-, which the expander implements. The runtime's functions get their docstrings and
argument lists from skein.core.docs (M2.11, D-093)."
  (:require [skein.core.docs :as docs]))

;;; ------------------------------------------------------------------------------------
;;; Namespaces and vars

(def ^:private unbound
  "The value of a var that has been declared but not defined."
  (gensym "unbound"))

(def ^:private namespaces
  "Namespace name -> namespace, or nil before the first use."
  (atom nil))

(def ^:private current
  "The current namespace, in an atom, unless the namespace-cell hook gives the code running
now its own."
  (atom nil))

(def ^:private namespace-cell
  "nil, or a function that returns the atom holding the current namespace of the code
running now, or nil for the global one: skein.dev's, so that REPLs evaluating at the same
time don't change each other's (D-083)."
  (atom nil))

(defn %set-namespace-cell-hook!
  "Make f (of no arguments) give the atom that holds the current namespace of the code
running now, or nil for the shared one (D-083)."
  [f]
  (reset! namespace-cell f))

(defn- current-cell []
  (or (when-let [f @namespace-cell] (f)) current))

(def ^:private eval-program
  "True in a program built with --eval (D-078), whose vars are the program's own: each
model var of the program points at a real var (:rt)."
  (atom false))

(def namespace-loader
  "An atom holding a function of a namespace name that loads its source: set by the
compiler's driver."
  (atom nil))

(def ^:private builtin-condition-types
  ["arithmetic-error" "type-error" "index-error" "arity-error" "unbound-var-error"
   "not-callable-error" "unsupported-operation-error" "transient-error" "namespace-error"
   "cancelled" "timeout" "task-cancelled-error" "stack-overflow"])

(def ^:private builtin-macros ["ns" "defmacro" "defn" "defn-"])

(def ^:private other-core-names
  "The rest of Phase 0's public skein.core names, which only Phase 0 has a value for.
They resolve as in Phase 0, unbound. (%define-method, %define-struct and %define-soa are
defined below, for phase-1 code.) The C backend compiles calls to %with-bindings and
%set-dynamic! itself (D-076)."
  ["%declaim" "%error" "%var-bound?" "*1" "*2" "*3" "*e" "%with-bindings"
   "%set-dynamic!"])

(defn- make-namespace [nm]
  (atom {:name nm :mappings {} :refers {} :aliases {} :loaded false :requires []
         :syntax-requires []}))

(defn- make-var [ns nm]
  (atom {:ns ns :name nm :value unbound :macro nil :dynamic false :private false :doc nil}))

(def ^:private ensure-namespace)

(defn- define-core!
  "Give skein.core the var nm with value; macro is nil, true or :syntax. rt is the
program's dynamic var it stands for, as *print-length*, which code evaluated reads and
binds (M2.11)."
  ([core nm value macro] (define-core! core nm value macro nil))
  ([core nm value macro rt]
   (let [var (make-var core nm)]
     (swap! var assoc :value value :macro macro)
     (when rt (swap! var assoc :rt rt :dynamic true))
     (swap! core assoc-in [:mappings nm] var))))

(def ^:private init-ffi!)
(def ^:private init-type-lookups!)

(def ^:private load-program-registry!)

(defn- init!
  "Make skein.core and user, the first time the environment is used."
  []
  (when (nil? @namespaces)
    (reset! namespaces {})
    (let [core (ensure-namespace "skein.core")]
      (swap! core assoc :loaded true)
      (doseq [nm (%core-function-names)]
        ;; Other namespaces' functions are in the table as <namespace>/<name>: skein.ffi's
        ;; (D-065), skein.math's and skein.time's (M1.12).
        (let [slash (count (take-while (fn [c] (not= c \/)) nm))]
          (if (< 0 slash (count nm))
            (define-core! (ensure-namespace (subs nm 0 slash)) (subs nm (inc slash))
                          (%core-function nm) nil)
            (define-core! core nm (%core-function nm) nil))))
      (init-ffi!)
      (init-type-lookups!)
      (doseq [nm builtin-condition-types]
        (define-core! core nm (%condition-type (symbol nm)) nil))
      (doseq [[ns-name nm value macro? rt] (%registered-core-vars)]
        (define-core! core nm value (when (and macro? (= ns-name "skein.core")) true) rt)
        ;; The library's own namespace too, as on the host once it is loaded: the C
        ;; backend looks its functions up there (D-051).
        (when (= ns-name "skein.core.native")
          (define-core! (ensure-namespace "skein.core.native") nm value nil rt)))
      (doseq [nm builtin-macros]
        (define-core! core nm nil :syntax))
      ;; The runtime's functions' docs (M2.11), for describe and autodoc (D-086).
      (doseq [[qualified arglists doc] docs/entries]
        (let [slash (count (take-while (fn [c] (not= c \/)) qualified))
              [ns-name nm] (if (< slash (count qualified))
                             [(subs qualified 0 slash) (subs qualified (inc slash))]
                             ["skein.core" qualified])]
          (when-let [var (some-> (get @namespaces ns-name) (%find-own-var nm))]
            (swap! var assoc :doc doc :arglists arglists))))
      (doseq [nm other-core-names]
        (define-core! core nm unbound nil))
      ;; For code evaluated in a program (D-078): in-ns as Phase 0's.
      (define-core! core "in-ns" (fn in-ns [nm] (%in-ns nm)) nil)
      (load-program-registry!)
      (reset! current (ensure-namespace "user")))))

(defn- ensure-namespace* [nm]
  (or (get @namespaces nm)
      (let [ns (make-namespace nm)]
        (swap! namespaces assoc nm ns)
        ns)))

(def ^:private ensure-namespace ensure-namespace*)

(defn- sym-string
  "The name of the symbol x, which names what."
  [x what]
  (when-not (symbol? x)
    (error (str "expected a symbol for " what ", not " (pr-str x))))
  (name x))

(defn %find-namespace
  "The namespace called nm (a string), or nil."
  [nm]
  (init!)
  (get @namespaces nm))

(defn %ensure-namespace
  "The namespace called nm, made if needed."
  [nm]
  (init!)
  (ensure-namespace nm))

(defn %current-namespace "The namespace top-level forms are expanded in." []
  (init!)
  @(current-cell))

(defn %current-namespace-name "The name of the current namespace." []
  (:name @(%current-namespace)))

(defn %namespace-name "A namespace's name." [ns] (:name @ns))

(defn %all-namespaces
  "Every namespace."
  []
  (init!)
  (vec (vals @namespaces)))

(defn %namespace-file
  "The source file a namespace was loaded from, or nil (in a program built with --eval)."
  [ns]
  (:file @ns))

(defn %set-namespace-file!
  "Record that a namespace was loaded from file (load-file does, for reload)."
  [ns file]
  (swap! ns assoc :file file)
  nil)

(defn %namespace-requires
  "The namespaces ns requires at run time, in the order its ns form requires them."
  [ns]
  (:requires @ns))

(defn %namespace-syntax-requires
  "The namespaces ns requires for syntax, in the order its ns form requires them."
  [ns]
  (:syntax-requires @ns))

(defn %find-alias "The namespace that alias names in ns, or nil." [ns alias]
  (get (:aliases @ns) alias))

(defn %find-own-var "ns's own var called nm, or nil." [ns nm]
  (get (:mappings @ns) nm))

(defn %intern-var
  "ns's own var called nm, made unbound if needed; in a program built with --eval, with a
real var of its own (D-078)."
  [ns nm]
  (or (%find-own-var ns nm)
      (let [var (make-var ns nm)]
        (when @eval-program
          (swap! var assoc :rt (%make-runtime-var (:name @ns) nm)))
        (swap! ns assoc-in [:mappings nm] var)
        var)))

(defn %runtime-var-of
  "In a program built with --eval: var's real var, or nil for a skein.core function
(D-078)."
  [var]
  (:rt @var))

(defn %runtime-var
  "In a program built with --eval: var's real var, made if it has none (D-078)."
  [var]
  (or (:rt @var)
      (let [rt (%make-runtime-var (:name @(:ns @var)) (:name @var))]
        (when (:dynamic @var) (%set-runtime-var-dynamic! rt))
        (swap! var assoc :rt rt)
        rt)))

(defn %resolve-var
  "The var that the unqualified nm means in ns: its own var, then a referred var, then
a public var of skein.core; nil if there is none."
  [ns nm]
  (or (%find-own-var ns nm)
      (get (:refers @ns) nm)
      (let [core (%find-own-var (%find-namespace "skein.core") nm)]
        (when (and core (not (:private @core))) core))))

(defn %var-name "A var's unqualified name." [var] (:name @var))
(defn %var-namespace "A var's namespace." [var] (:ns @var))
(defn %var-qualified-name "\"ns/name\" for var." [var]
  (str (:name @(:ns @var)) "/" (:name @var)))
(defn %var-value
  "A var's value, or the unbound marker. In a program built with --eval, a var of the
program is its real var (D-078)."
  [var]
  (if-let [rt (:rt @var)]
    (%runtime-var-value rt unbound)
    (:value @var)))
(defn %var-private? "True if the var is private." [var] (boolean (:private @var)))
(defn %var-dynamic? "True if the var is ^:dynamic." [var] (boolean (:dynamic @var)))

(defn %dynamic-var?
  "For the binding macro (D-076): whether the var that the symbol sym means in the
namespace called ns-name is ^:dynamic, or nil if there is no such var yet."
  [sym ns-name]
  (let [ns (%find-namespace ns-name)
        var (when ns
              (if (namespace sym)
                (when-let [target (or (%find-alias ns (namespace sym))
                                      (%find-namespace (namespace sym)))]
                  (%find-own-var target (name sym)))
                (%resolve-var ns (name sym))))]
    (when var (%var-dynamic? var))))
(defn %var-macro
  "true for a macro written in Skein, :syntax for a built-in one (ns, defmacro, defn,
defn-), else nil."
  [var]
  (:macro @var))

(defn %set-var-flags!
  "What def does when it is expanded: the var is no longer a macro, and its dynamic and
private flags and docstring come from the def form."
  [var dynamic private doc]
  (swap! var assoc :macro nil :dynamic (boolean dynamic) :private (boolean private) :doc doc)
  (when (and dynamic (:rt @var)) (%set-runtime-var-dynamic! (:rt @var)))
  var)

(defn %set-var-info!
  "Record what documentation shows of a var def defines: its argument lists, as text like
\"([x] [x y])\" (or nil), and the location of its definition, as \"file:line:column\" (D-086)."
  [var arglists location]
  (swap! var assoc :arglists arglists :loc location)
  var)

(defn %var-info
  "{:doc :arglists :loc} of a var: its docstring, argument lists and location, or nils."
  [var]
  (select-keys @var [:doc :arglists :loc]))

(defn %set-var-value!
  "def at phase 1 (the interpreter, D-061): set var's value."
  [var value]
  (if-let [rt (:rt @var)]
    (%set-runtime-var-value! rt value)
    (swap! var assoc :value value))
  value)

(defn %var-defined? "True if var has a value." [var]
  (not (identical? (%var-value var) unbound)))

(defn %set-macro!
  "Mark the current namespace's var nm (a symbol) as a macro."
  [nm]
  (let [var (%find-own-var (%current-namespace) (sym-string nm "a macro name"))]
    (swap! var assoc :macro true)
    var))

(defn- load-program-registry!*
  "In a program built with --eval (D-078): the program's own namespaces and vars, from
what its start-up code registered with the runtime. Each var points at the program's real
var (:rt), through which its value is read and set."
  []
  (when-let [[infos vars] (%eval-registry)]
    (doseq [[ns-name nm rt macro? private? dynamic?] vars]
      (let [var (%intern-var (ensure-namespace ns-name) nm)]
        ;; ns, defmacro, defn and defn- stay built-in macros.
        (when-not (= :syntax (:macro @var))
          (swap! var assoc :macro (when macro? true) :private private? :dynamic dynamic?))
        (when rt (swap! var assoc :rt rt))))
    (doseq [info infos]
      ;; Docstrings, argument lists and locations (D-086).
      (doseq [[nm [doc arglists loc]] (:vars info)]
        (swap! (%intern-var (ensure-namespace (:name info)) nm) assoc
               :doc doc :arglists arglists :loc loc))
      (let [ns-of ensure-namespace]
        (swap! (ensure-namespace (:name info)) assoc
               :loaded true
               :file (:file info)
               :requires (mapv ns-of (:requires info))
               :syntax-requires (mapv ns-of (:syntax-requires info))
               :aliases (reduce-kv (fn [m alias nm] (assoc m alias (ns-of nm)))
                                   {} (:aliases info))
               :refers (reduce-kv (fn [m nm target] (assoc m nm (%intern-var (ns-of target) nm)))
                                  {} (:refers info)))))
    ;; From now on, vars the program defines get real vars.
    (reset! eval-program true)))

(def ^:private load-program-registry! load-program-registry!*)

;;; ------------------------------------------------------------------------------------
;;; ns forms

(defn %in-ns
  "Make the namespace nm (a symbol) current, creating it if needed."
  [nm]
  (let [ns (%ensure-namespace (sym-string nm "a namespace name"))]
    (swap! ns assoc :loaded true)
    (reset! (current-cell) ns)
    ns))

(defn- require-namespace
  "The namespace called nm, loaded with the driver's loader if it isn't yet."
  [nm]
  (let [ns (%find-namespace nm)]
    (if (and ns (:loaded @ns))
      ns
      (let [load @namespace-loader]
        (when-not load
          (error (str "cannot load namespace " nm ": no loader")))
        (load nm)
        (or (%find-namespace nm)
            (error (str "loading " nm " did not define namespace " nm)))))))

(defn- add-require! [key nm alias]
  (let [ns (require-namespace (sym-string nm "a namespace name"))
        here (%current-namespace)]
    (swap! here update key (fn [rs] (if (some (fn [r] (identical? r ns)) rs) rs (conj rs ns))))
    (when alias
      (swap! here assoc-in [:aliases (sym-string alias "an alias")] ns))
    nil))

(defn %require
  "(:require [nm :as alias]): load the namespace nm and record it."
  [nm alias]
  (add-require! :requires nm alias))

(defn %require-for-syntax
  "(:require-for-syntax [nm :as alias]): as %require, for phase 1 (DESIGN §4.4)."
  [nm alias]
  (add-require! :syntax-requires nm alias))

(defn %refer
  "Make the public var nm of namespace ns-name visible in the current namespace."
  [ns-name nm]
  (let [ns (require-namespace (sym-string ns-name "a namespace name"))
        var-name (sym-string nm "a referred name")
        var (%find-own-var ns var-name)]
    (when-not (and var (not (:private @var)))
      (error (str (:name @ns) "/" var-name (if var " is private" " does not exist"))))
    (swap! (%current-namespace) assoc-in [:refers var-name] var)
    nil))

;;; ------------------------------------------------------------------------------------
;;; Macros

(def ^:private syntax-meta-lookup
  "While a macro runs, a function from a form it received to that form's metadata."
  (atom nil))

(def ^:private expansion-context
  "While a macro written in Skein runs, [its var, the location of the form]."
  (atom nil))

(defn %call-macro
  "Call the macro in var with the form, &env and the arguments, as the expander does.
While it runs, the interpreter checks the phase rules (%check-phase) against location."
  [var form env args location meta-lookup]
  (let [saved-lookup @syntax-meta-lookup
        saved-context @expansion-context]
    (reset! syntax-meta-lookup meta-lookup)
    (reset! expansion-context [var location])
    (try
      (apply (%var-value var) form env args)
      (finally
        (reset! syntax-meta-lookup saved-lookup)
        (reset! expansion-context saved-context)))))

;;; Phases (DESIGN §4.4, D-033): a macro defined in namespace M may use, while it runs,
;;; vars of skein.core, of M itself, and of the namespaces M requires for syntax together
;;; with everything those require. Anything else is a phase violation, which is warned
;;; about as in Phase 0 (D-061).

(defn- syntax-namespaces
  "The namespaces whose vars a macro defined in ns may use while it runs."
  [ns]
  (loop [todo (:syntax-requires @ns)
         seen [(%find-namespace "skein.core") ns]]
    (if (empty? todo)
      seen
      (let [n (first todo)]
        (if (some (fn [s] (identical? s n)) seen)
          (recur (rest todo) seen)
          (recur (concat (rest todo) (:requires @n) (:syntax-requires @n)) (conj seen n)))))))

(def ^:private phase-warned (atom #{}))

(defn- format-location [loc]
  (str (or (:file loc) "<input>") ":" (:line loc) ":" (:column loc)))

(defn %check-phase
  "While a macro written in Skein runs, warn if it uses var against DESIGN §4.4."
  [var]
  (when-let [[macro location] @expansion-context]
    (let [macro-ns (:ns @macro)
          var-ns (:ns @var)]
      (when-not (some (fn [n] (identical? n var-ns)) (syntax-namespaces macro-ns))
        (let [key [(%var-qualified-name macro) (%var-qualified-name var)]]
          (when-not (contains? @phase-warned key)
            (swap! phase-warned conj key)
            (warn (str "macro " (%var-qualified-name macro) " uses " (%var-qualified-name var)
                       " while expanding; require " (:name @var-ns)
                       " with :require-for-syntax in " (:name @macro-ns)
                       (when location (str " at " (format-location location))))))))))
  nil)

(defn %syntax-meta
  "For macros: the metadata (^:blocking, ^type, ...) of a form they received, or nil."
  [form]
  (when-let [lookup @syntax-meta-lookup]
    (lookup form)))

;;; ------------------------------------------------------------------------------------
;;; The FFI at phase 1 (M1.10, D-065): skein.ffi's type definitions run at compile time,
;;; making the runtime's C types and their vars, which the C backend uses to qualify type
;;; names. C functions and callbacks aren't called at compile time; their vars get a
;;; function that says so.

(def ^:private ffi-primitive-types
  '#{i8 i16 i32 i64 u8 u16 u32 u64 f32 f64 bool void c-string ptr})

(defn- qualify-ffi-type
  "A foreign type with the struct, union and enum names in it qualified, as the C backend
qualifies them."
  [t]
  (let [ns (%current-namespace)]
    (cond (symbol? t)
          (cond (contains? ffi-primitive-types t) t
                (namespace t) (if-let [target (%find-alias ns (namespace t))]
                                (symbol (:name @target) (name t))
                                t)
                :else (if-let [var (%resolve-var ns (name t))]
                        (symbol (:name @(:ns @var)) (name t))
                        t))
          (and (list? t) (symbol? (first t)) (= (name (first t)) "array"))
          (apply list (first t) (qualify-ffi-type (second t)) (drop 2 t))
          :else t)))

(defn- ffi-define-struct [nm kind fields]
  (let [ctype ((%core-function "skein.ffi/%define-struct")
               nm kind (mapv (fn [[f t]] [f (qualify-ffi-type t)]) fields))]
    (%set-var-value! (%intern-var (%current-namespace) (name nm)) ctype)
    nil))

(defn- ffi-define-enum [nm base values]
  (let [ctype ((%core-function "skein.ffi/%define-enum") nm base values)]
    (%set-var-value! (%intern-var (%current-namespace) (name nm)) ctype)
    nil))

(defn- keep-compiled!
  "In a program built with --eval: a defcfun or defcallback needs compiled C, so evaluating
one again (reloading its namespace) keeps the var's compiled function, and a new one is an
error (D-079)."
  [nm what]
  (let [var (%intern-var (%current-namespace) (name nm))]
    (when-not (%var-defined? var)
      (error (str what " " (name nm) " can't be evaluated in a running program: it needs "
                  "compiled C, so build the program with it")))
    nil))

(defn- ffi-define-function [nm c-name return-type params blocking owned]
  (if @eval-program
    (keep-compiled! nm "defcfun")
    (%set-var-value! (%intern-var (%current-namespace) (name nm))
                     (fn [& _] (error (str "the C function " c-name
                                           " can't be called while compiling")))))
  nil)

(defn- ffi-define-callback [nm return-type params f]
  (if @eval-program
    (keep-compiled! nm "defcallback")
    (%set-var-value! (%intern-var (%current-namespace) (name nm))
                     (fn [& _] (error (str "the callback " nm " can't be used while compiling")))))
  nil)

(defn- init-ffi!* []
  (let [ffi (ensure-namespace "skein.ffi")]
    (define-core! ffi "%define-struct" ffi-define-struct nil)
    (define-core! ffi "%define-enum" ffi-define-enum nil)
    (define-core! ffi "%define-function" ffi-define-function nil)
    (define-core! ffi "%define-callback" ffi-define-callback nil)
    ;; Libraries aren't loaded at compile time; a program built with --eval loads them.
    (define-core! ffi "%load-library"
                  (if (%eval-registry) (%core-function "skein.ffi/%load-library") (fn [spec] nil))
                  nil)))

(def ^:private init-ffi! init-ffi!*)

(def ^:private phase-1-builtin-classes
  "The built-in class and condition names that %class and %condition-type find
unqualified (c.skn's builtin-class-names, and condition, error and warning)."
  #{"any" "object" "nil-class" "integer" "float" "f32" "f64" "number" "char" "string"
    "keyword" "symbol" "vector" "hash-map" "hash-set" "list" "seq" "fn" "atom" "ref" "condition"
    "error" "warning"})

(defn- phase-1-qualified
  "sym, a class or condition type named in namespace ns-name, qualified by the namespace
its var is in, as the C backend does when it compiles the call (D-047, D-054): the
runtime finds classes and condition types by their full names and knows no aliases."
  [sym ns-name]
  (let [ns (%find-namespace ns-name)]
    (cond (or (not (symbol? sym)) (nil? ns)) sym
          (namespace sym) (if-let [target (%find-alias ns (namespace sym))]
                            (symbol (%namespace-name target) (name sym))
                            sym)
          (contains? phase-1-builtin-classes (name sym)) sym
          :else (if-let [var (%resolve-var ns (name sym))]
                  (symbol (%namespace-name (%var-namespace var)) (name sym))
                  sym))))

(defn- init-type-lookups!*
  "At phase 1, %class and %condition-type qualify the name first (M1.12)."
  []
  (let [core (ensure-namespace "skein.core")]
    (doseq [nm ["%class" "%condition-type"]]
      (let [f (%core-function nm)]
        (define-core! core nm
                      (fn [sym & more] (apply f (phase-1-qualified sym (first more)) more))
                      nil)))))

(def ^:private init-type-lookups! init-type-lookups!*)

;;; ------------------------------------------------------------------------------------
;;; Definitions made at compile time

(defn %define-method
  "defmethod at phase 1 (D-061): add a method to the generic function that the symbol nm
names in the namespace ns-name, making the generic function if there is none, as the C
backend resolves it (D-054)."
  [nm ns-name qualifier specializers rest-p f]
  (let [ns (%ensure-namespace ns-name)
        found (if (namespace nm)
                (let [target (or (%find-alias ns (namespace nm)) (%find-namespace (namespace nm)))]
                  (when target (%find-own-var target (name nm))))
                (%resolve-var ns (name nm)))
        var (if (and found (%generic? (%var-value found))) found (%intern-var ns (name nm)))
        current (%var-value var)
        gf (if (%generic? current)
             current
             (let [params (into (vec (repeat (count specializers) 'p)) (when rest-p '[& more]))
                   g (%define-generic (symbol (name nm)) (:name @(:ns @var)) params)]
               (%set-var-value! var g)
               g))]
    (%add-method gf qualifier specializers rest-p f)))

(def ^:private struct-names
  "A struct's constructor, or a defsoa type, -> the qualified name of its struct type."
  (atom {}))

(defn- named-var
  "The var that the symbol sym names in ns, or nil."
  [ns sym]
  (if (namespace sym)
    (let [target (or (%find-alias ns (namespace sym)) (%find-namespace (namespace sym)))]
      (when target (%find-own-var target (name sym))))
    (%resolve-var ns (name sym))))

(defn %struct-def-name
  "The qualified name of the struct type that sym names in ns, or nil: as in Phase 0, a
symbol whose var holds a struct's constructor or a defsoa type."
  [sym ns]
  (when-let [var (named-var ns sym)]
    (when (%var-defined? var)
      (get @struct-names (%var-value var)))))

(defn- qualified-fields
  "A struct's fields ([[name type]...]) with struct types qualified, as the C backend
qualifies them (D-055), so the runtime finds them by their full names."
  [fields]
  (mapv (fn [[fname ftype :as f]]
          (if (and ftype (symbol? ftype) (nil? (namespace ftype)))
            (if-let [qualified (%struct-def-name ftype (%current-namespace))]
              (let [slash (count (take-while (fn [c] (not= c \/)) qualified))]
                [fname (symbol (subs qualified 0 slash) (subs qualified (inc slash)))])
              [fname ftype])
            (vec f)))
        fields))

(defn- define-here!
  "Give the current namespace's var nm the value v."
  [nm v]
  (%set-var-value! (%intern-var (%current-namespace) nm) v))

(defn %define-struct
  "defstruct at phase 1: define the struct type nm (a qualified symbol) natively, and the
vars Phase 0 makes for it in the current namespace: the constructor, name? and
name-field per field."
  [nm value? fields]
  (let [fields (qualified-fields fields)
        def (%make-struct-def nm value? fields)
        short (name nm)
        ctor (%struct-constructor def)]
    (swap! struct-names assoc ctor (str (namespace nm) "/" short))
    (define-here! short ctor)
    (define-here! (str short "?") (%struct-predicate def))
    (doseq [[i [fname]] (map-indexed vector fields)]
      (define-here! (str short "-" (name fname)) (%struct-accessor def i)))
    nil))

(defn %define-soa
  "defsoa at phase 1: define the defsoa type nm (a qualified symbol), with the vars name
(the type), make-name and one per field."
  [nm fields]
  (let [fields (qualified-fields fields)
        def (%make-soa-def nm fields)
        short (name nm)]
    (swap! struct-names assoc def (str (namespace nm) "/" short ".element"))
    (define-here! short def)
    (define-here! (str "make-" short) (%soa-maker def))
    (doseq [[i [fname]] (map-indexed vector fields)]
      (define-here! (name fname) (%soa-field def i)))
    nil))
