(ns skein.compiler.main
  "The native compiler's driver (M1.9 step 5, D-062): `skeinc build file.skn [-o out]
[--target T] [--profile dev|release] [--keep-c]` (M1.11, D-069). It reads a program and
the namespaces it requires, runs their phase-1 code (D-058) in the interpreter,
translates them to C with skein.compiler.c, and compiles the C with zig against the
runtime, as host/src/backend-c/build.lisp does.

Translation follows build.lisp function by function, so the C is the same:
skein.core.native first, then the program; after each ns form, the namespaces it
requires, each before the code that uses it. ns and defmacro forms run at phase 1 and
make no code; the rest is compiled, and defs of functions and the %define- forms also run
at phase 1. A program that includes skein.compiler.env gets skein.core's macros compiled
in (D-060).

Natively, required namespaces are loaded at phase 1 by this namespace's loader; on the
host, Phase 0 loads them."
  (:require [skein.io :as io]
            [skein.compiler.reader :as reader]
            [skein.compiler.expander :as expander]
            [skein.compiler.c :as c]
            [skein.compiler.interp :as interp]
            [skein.compiler.env :as env]))

;;; ------------------------------------------------------------------------------------
;;; Errors

(defcondition build-error [error]
  "A program that can't be found, translated or compiled."
  (message :reader build-error-message)
  (:report (fn [c] (build-error-message c))))

(defn- fail [& parts] (error build-error :message (apply str parts)))

;;; ------------------------------------------------------------------------------------
;;; Files and paths. Paths are strings with / separators, which every OS accepts; a
;;; directory ends with /.

(defn- index-of-last [s ch]
  (loop [i (dec (count s))]
    (cond (neg? i) nil
          (= (nth s i) ch) i
          :else (recur (dec i)))))

(defn- directory-of
  "The directory part of path, ending with / (\"\" for a bare file name)."
  [path]
  (let [path (apply str (map (fn [c] (if (= c \\) \/ c)) path))]
    (if-let [i (index-of-last path \/)] (subs path 0 (inc i)) "")))

(defn- file-name
  "The last part of path."
  [path]
  (subs path (count (directory-of path))))

(defn- stem
  "file-name without its extension."
  [path]
  (let [n (file-name path)]
    (if-let [i (index-of-last n \.)] (subs n 0 i) n)))

(defn namespace-file-name
  "The relative source path for namespace nm: a.b-c becomes a/b-c.skn."
  [nm]
  (str (apply str (map (fn [c] (if (= c \.) \/ c)) nm)) ".skn"))

(defn find-home
  "The Skein checkout the compiler uses (its lib/ and runtime/): SKEIN_HOME, else the
current directory or the nearest parent with lib/skein/core.skn."
  []
  (or (when-let [h (%getenv "SKEIN_HOME")]
        (if (= (last h) \/) h (str h "/")))
      (loop [dir "" n 0]
        (cond (io/file-exists? (str dir "lib/skein/core.skn")) dir
              (< n 8) (recur (str dir "../") (inc n))
              :else (fail "cannot find the Skein checkout: run skeinc inside it, or set "
                          "SKEIN_HOME")))))

;;; ------------------------------------------------------------------------------------
;;; The build state

(defn- make-build
  "The state of one translation: the C unit, the namespaces already in it, the source
paths, and whether lib/skein/core.skn is being translated with its macros (D-060). For a
program built with --eval (D-078): the namespaces it registers with the runtime, and the
file being translated, and whether skein.compiler.env has been (its %in-ns then runs
before the code that follows)."
  [source-paths eval?]
  {:unit (c/make-unit)
   :translated (atom #{"skein.core.native"})
   :paths source-paths
   :core-macro-mode (atom false)
   :eval eval?
   :eval-namespaces (atom [])
   :file (atom nil)
   :env-translated (atom false)})

(defn- find-namespace-file
  "The source file of namespace nm on the source paths, or nil."
  [build nm]
  (some (fn [dir]
          (let [p (str dir (namespace-file-name nm))]
            (when (io/file-exists? p) p)))
        (:paths build)))

(defn- form-head
  "The unqualified name at the head of a list form, or nil."
  [form]
  (when (and (= :list (:kind form)) (seq (:datum form)))
    (let [h (:datum (first (:datum form)))]
      (when (and (symbol? h) (nil? (namespace h))) (name h)))))

(defn- defining-call?
  "True if ir calls one of the %define- functions of skein.core (defstruct, defclass, ...)
or skein.ffi (defcstruct, defcenum, defcfun, ...)."
  [ir]
  (and (= :call (:op ir)) (= :var-ref (:op (:fn ir)))
       (contains? #{"skein.core" "skein.ffi"}
                  (%namespace-name (%var-namespace (:var (:fn ir)))))
       (let [nm (%var-name (:var (:fn ir)))]
         (and (> (count nm) 8) (= "%define-" (subs nm 0 8))))))

(defn- phase-1?
  "Whether a compiled top-level form also runs at phase 1 (D-058): a def of a function
that isn't defined yet at phase 1, or a definition of a struct, class, generic function or
condition type."
  [ir]
  (or (and (= :def (:op ir)) (:init ir) (= :fn (:op (:init ir)))
           (not (%var-defined? (:var ir))))
      (defining-call? ir)
      (and (= :def (:op ir)) (:init ir) (defining-call? (:init ir)))))

(defn- run-phase-1
  "Expand form and run all of it at phase 1, in the current namespace."
  [form]
  (let [ns (%current-namespace)
        expanded (expander/macroexpand form (expander/make-env ns))]
    (if (expander/toplevel-do? expanded)
      (doseq [sub (rest (:datum expanded))] (run-phase-1 sub))
      (interp/evaluate (expander/analyze-toplevel expanded ns)))))

(def ^:private files-read
  "The source files the translation going on has read, for the run cache (D-081)."
  (atom []))

(defn- read-file-forms
  "Call (f form) for each top-level form of the file at path, starting in namespace
user; the reader follows the namespace each form leaves current. Returns the namespace
current at the end. The namespace current before is restored."
  [path f]
  (swap! files-read conj path)
  (let [saved (%current-namespace-name)
        text (io/read-file path)
        r (reader/make-reader text {:file path :namespace "user"
                                    :resolve-alias
                                    (fn [alias]
                                      (when-let [ns (%find-alias (%current-namespace) alias)]
                                        (%namespace-name ns)))})]
    (%in-ns 'user)
    (try
      (loop []
        (reader/set-reader-namespace! r (%current-namespace-name))
        (let [form (reader/read-form r false ::eof)]
          (if (= form ::eof)
            (%current-namespace)
            (do (f form) (recur)))))
      (finally (%in-ns (symbol saved))))))

;;; ------------------------------------------------------------------------------------
;;; Phase-1 loading (native only): what %require does for a namespace not loaded yet.

(defn- load-for-syntax
  "Load namespace nm at phase 1: run its ns and defmacro forms, and the phase-1 forms
among the rest (D-058). Nothing is compiled."
  [build nm]
  (let [path (or (find-namespace-file build nm)
                 (fail "cannot find namespace " nm))]
    (read-file-forms path
                     (fn [form]
                       (if (contains? #{"ns" "defmacro"} (form-head form))
                         (run-phase-1 form)
                         (let [ns (%current-namespace)
                               expanded (expander/macroexpand form (expander/make-env ns))]
                           (loop [forms (if (expander/toplevel-do? expanded)
                                          (rest (:datum expanded))
                                          [expanded])]
                             (when (seq forms)
                               (let [e (expander/macroexpand (first forms)
                                                             (expander/make-env ns))]
                                 (if (expander/toplevel-do? e)
                                   (recur (concat (rest (:datum e)) (rest forms)))
                                   (let [ir (expander/analyze-toplevel e ns)]
                                     (when (phase-1? ir) (interp/evaluate ir))
                                     (recur (rest forms)))))))))))))

;;; ------------------------------------------------------------------------------------
;;; Translation (build.lisp)

(def ^:private translate-form)
(def ^:private translate-source)

(defn- core-source-names
  "The names that the top-level defmacro, defn, defn- and def forms of path define."
  [path]
  (let [r (reader/make-reader (io/read-file path) {:file path :namespace "skein.core"})]
    (loop [names []]
      (let [form (reader/read-form r false ::eof)]
        (if (= form ::eof)
          names
          (recur (if (contains? #{"defmacro" "defn" "defn-" "def"} (form-head form))
                   (conj names (name (:datum (second (:datum form)))))
                   names)))))))

(defn- translate-core-macros
  "Translate lib/skein/core.skn into the program with its macros compiled, so that
skein.compiler.env can give the native compiler's skein.core its macros (D-060)."
  [build]
  (let [path (or (find-namespace-file build "skein.core") (fail "cannot find skein.core"))]
    (c/note-core-names! (:unit build) (core-source-names path))
    (reset! (:core-macro-mode build) true)
    (try (translate-source build path)
         (finally (reset! (:core-macro-mode build) false)))))

(defn- translate-core-macro
  "Compile one defmacro of lib/skein/core.skn: only its function is analyzed, since
analyzing its def would clear the var's macro flag."
  [build form]
  (let [ns (%current-namespace)
        expanded (expander/macroexpand form (expander/make-env ns))
        def-items (:datum (second (:datum expanded)))
        nm (name (:datum (second def-items)))
        fn-form (last def-items)]
    (c/emit-core-macro (:unit build) (%find-own-var ns nm)
                       (expander/analyze-toplevel fn-form ns) ns)))

(defn- translate-requires
  "Translate the namespaces that ns requires and the program doesn't include yet, in the
order its ns form requires them, each one's own requires first. A program built with
--eval also includes the namespaces required for syntax, which its macros use (D-078)."
  [build ns]
  (doseq [dep (concat (%namespace-requires ns)
                      (when (:eval build) (%namespace-syntax-requires ns)))]
    (let [nm (%namespace-name dep)]
      (when-not (or (= nm "skein.core") (contains? @(:translated build) nm))
        (swap! (:translated build) conj nm)
        (let [path (or (find-namespace-file build nm)
                       (fail "cannot find namespace " nm))]
          ;; The native compiler's environment needs skein.core's macros compiled in.
          (when (= nm "skein.compiler.env")
            (translate-core-macros build))
          (translate-source build path)
          (when (= nm "skein.compiler.env")
            (reset! (:env-translated build) true)))))))

(defn- translate-compiled
  "Translate form to C, expanding it; a (do ...) expansion's forms are top-level forms."
  [build form]
  (let [ns (%current-namespace)
        expanded (expander/macroexpand form (expander/make-env ns))]
    (if (expander/toplevel-do? expanded)
      (doseq [sub (rest (:datum expanded))] (translate-form build sub))
      (let [ir (expander/analyze-toplevel expanded ns)]
        (when (and (not @(:core-macro-mode build)) (phase-1? ir))
          (interp/evaluate ir))
        (c/emit-toplevel (:unit build) ir ns)))))

(defn- syntax-list
  "A syntax object for the list of syntax objects items, at location loc."
  [loc & items]
  {:kind :list :datum (vec items) :loc loc})

(defn- translate-in-ns
  "For a program built with --eval (D-078): code that makes namespace nm current when it
runs, as Phase 0's current namespace is while a file loads."
  [build nm loc]
  (let [atom-of (fn [x] {:kind :atom :datum x :loc loc})]
    (translate-compiled build (syntax-list loc (atom-of 'skein.core/%in-ns)
                                           (syntax-list loc (atom-of 'quote)
                                                        (atom-of (symbol nm)))))))

(defn- translate-program-macro
  "For a program built with --eval (D-078): compile the macro that the defmacro form
defined at phase 1 into the program too, so that code it evaluates can use it."
  [build form]
  (let [ns (%current-namespace)
        expanded (expander/macroexpand form (expander/make-env ns))
        def-items (:datum (second (:datum expanded)))
        nm (name (:datum (second def-items)))]
    (c/emit-program-macro (:unit build) (%find-own-var ns nm)
                          (expander/analyze-toplevel (last def-items) ns) ns)))

(defn- translate-form*
  "Translate one top-level form. ns and defmacro forms run at phase 1 and make no code;
everything else becomes C. After an ns form, the namespaces it requires are translated.
A program built with --eval also compiles its macros, and records its namespaces and
makes each current while its code runs (D-078)."
  [build form]
  (let [head (form-head form)]
    (cond (and @(:core-macro-mode build) (= head "defmacro")) (translate-core-macro build form)
          (= head "ns")
          (let [_ (run-phase-1 form)
                ns (%current-namespace)]
            (translate-requires build ns)
            (when (:eval build)
              (swap! ns assoc :file @(:file build))
              (swap! (:eval-namespaces build) conj ns)
              ;; Namespaces translated before skein.compiler.env (the library, the reader)
              ;; don't need to be current while their code runs.
              (when @(:env-translated build)
                (translate-in-ns build (%namespace-name ns) (:loc form)))))
          (= head "defmacro")
          (do (run-phase-1 form)
              (when (:eval build) (translate-program-macro build form)))
          :else (translate-compiled build form))))

(def ^:private translate-form translate-form*)

(defn- translate-source* [build path]
  (let [saved @(:file build)]
    (reset! (:file build) path)
    (try (read-file-forms path (fn [form] (translate-form build form)))
         (finally (reset! (:file build) saved)))))

(def ^:private translate-source translate-source*)

(defn translate-file
  "The C program for the Skein program at path, with the namespaces it requires and
skein.core's library in Skein; source-paths are the directories searched for namespaces.
Its -main, if any, is called with the command-line arguments. Given main-name (a
project's :main), that function of the program's namespace must exist, and is called
instead."
  ([path source-paths] (translate-file path source-paths nil false))
  ([path source-paths main-name eval?]
   (reset! files-read [])
   (let [build (make-build source-paths eval?)
         library (or (find-namespace-file build "skein.core.native")
                     (fail "cannot find skein.core.native"))]
     (reset! env/namespace-loader (fn [nm] (load-for-syntax build nm)))
     (translate-source build library)
     ;; --eval (D-078, D-081): the front end, the evaluator and the REPL, before the
     ;; program.
     (when eval?
       (c/note-eval! (:unit build))
       (swap! (:translated build) conj "skein.dev")
       (translate-source build (or (find-namespace-file build "skein.dev")
                                   (fail "cannot find skein.dev"))))
     (let [ns (translate-source build path)
           main (%find-own-var ns (or main-name "-main"))]
       (when (and main-name (nil? main))
         (fail path " doesn't define " main-name ", the project's :main"))
       (when eval?
         ;; As in Phase 0, -main runs in user.
         (translate-in-ns build "user" nil)
         (c/emit-eval-registry! (:unit build) @(:eval-namespaces build) source-paths))
       (if eval?
         (c/program-text (:unit build) (file-name path) main
                         (%find-own-var (%find-namespace "skein.dev") "run-main")
                         (%namespace-name ns))
         (c/program-text (:unit build) (file-name path) main))))))

;;; ------------------------------------------------------------------------------------
;;; Compiling with zig (build.lisp). The runtime and the C file are kept in the checkout's
;;; .skein-cache/, which zig build makes; the Lisp backend keeps them in the current
;;; directory's (D-062).

(defn- zig [] (or (%getenv "SKEIN_ZIG") "zig"))

(defn- windows? [] (= (%getenv "OS") "Windows_NT"))

(defn- run-tool
  "Run argv (in dir, if given); fail with its output if it fails."
  [argv dir]
  (let [result (try (io/run-process argv (if dir {:dir dir} {}))
                    (catch io/io-error e
                      (fail "could not run " (first argv) ": " (condition-message e)
                            " (install Zig 0.17.1, or set SKEIN_ZIG)")))]
    (when-not (zero? (:exit result))
      (fail (first argv) " failed:\n" (:out result) (:err result)))
    (:out result)))

(defn- declared-namespace
  "The name of the namespace that the file at path declares in its first form, or nil."
  [path]
  (try
    (let [r (reader/make-reader (io/read-file path) {:file path :namespace "user"
                                                     :resolve-alias (fn [_] nil)})
          form (reader/read-form r false ::eof)
          nm (when (= "ns" (form-head form)) (:datum (second (:datum form))))]
      (when (symbol? nm) (name nm)))
    (catch error e nil)))

(defn- namespace-root
  "If the file at path declares a namespace whose name matches its path, as
src/game/main.skn declares game.main, the root directory (src/), else nil. (Phase 0's
skein.backend.cl:namespace-root.)"
  [path]
  (when-let [nm (declared-namespace path)]
    (let [path (apply str (map (fn [c] (if (= c \\) \/ c)) path))
          rel (namespace-file-name nm)
          root-length (- (count path) (count rel))]
      (when (and (>= root-length 0) (= rel (subs path root-length))
                 (or (zero? root-length) (= \/ (nth path (dec root-length)))))
        (subs path 0 root-length)))))

(defn- path-hash
  "A number from the characters of path, to tell apart cache files of programs that share
a file name."
  [path]
  (reduce (fn [h c] (mod (+ (* h 31) (int c)) 4294967296)) 7 path))

(def targets
  "The zig target triples skeinc builds for (DESIGN §19.1); the first three are P0."
  ["aarch64-macos" "x86_64-windows-gnu" "x86_64-linux-gnu" "x86_64-macos" "aarch64-linux-gnu"
   "aarch64-windows-gnu"])

(defn target-os
  "The operating system of a target triple: :macos, :windows or :linux."
  [target]
  (let [os (subs target (inc (count (take-while (fn [c] (not= c \-)) target))))]
    (cond (= os "macos") :macos
          (= os "windows-gnu") :windows
          :else :linux)))

(defn- zig-target
  "The triple given to zig: Linux targets link against glibc 2.28, for older distributions
(D-069)."
  [target]
  (if (= (target-os target) :linux) (str target ".2.28") target))

(def ^:private profiles
  "Each profile's zig optimize mode for the runtime and C optimization level (D-069)."
  {"dev" {:optimize "ReleaseSafe" :dir "releasesafe" :c "-O1"}
   "release" {:optimize "ReleaseFast" :dir "releasefast" :c "-O2"}})

(defn- build-runtime
  "Build the runtime library for target (nil: this machine) with zig build; return its
install prefix, relative to the current directory."
  [home target profile]
  (let [{:keys [optimize dir]} (get profiles profile)
        dir (str "runtime/" (or target "native") "-" dir "/")]
    ;; zig build runs in runtime/, so the prefix is given from there.
    (run-tool (vec (concat [(zig) "build" (str "-Doptimize=" optimize)
                            "--prefix" (str "../.skein-cache/" dir)]
                           (when target [(str "-Dtarget=" (zig-target target))])))
              (str home "runtime"))
    (str home ".skein-cache/" dir)))

(defn- runtime-library [prefix]
  (or (some (fn [n] (let [p (str prefix "lib/" n)] (when (io/file-exists? p) p)))
            ["libskein_runtime.a" "skein_runtime.lib"])
      (fail "the runtime library is missing from " prefix "lib/")))

(defn build-program
  "Compile the Skein program at path to an executable at output (default: :name, else the
file's name, in the current directory). Options: :output; :target, a triple of `targets`
(nil: this machine); :profile, \"dev\" (the default) or \"release\"; :keep-c (leave the
C file next to the executable); :eval (include the evaluator, D-078; dev profile only);
and for a project, :name, :source-paths (where its namespaces are) and :main-name (the
function to call). Returns the executable's path."
  [path {:keys [output target profile keep-c source-paths main-name] :as opts}]
  (let [home (find-home)
        profile (or profile "dev")
        _ (when-not (contains? profiles profile)
            (fail "unknown profile " profile "; use dev or release"))
        _ (when (and (:eval opts) (not= profile "dev"))
            (fail "--eval needs the dev profile"))
        _ (when (and target (not (some #{target} targets)))
            (fail "unknown target " target "; use one of " (apply str (interpose ", " targets))))
        windows (if target (= (target-os target) :windows) (windows?))
        output (or output (str (or (:name opts) (stem path)) (if windows ".exe" "")))
        ;; As Phase 0's program-source-paths: the root the file's namespace implies, its
        ;; directory, the current directory and lib/.
        source-paths (vec (distinct (concat (or source-paths
                                                (remove nil? [(namespace-root path)
                                                             (directory-of path) ""]))
                                            [(str home "lib/")])))
        c-source (translate-file path source-paths main-name (boolean (:eval opts)))
        prefix (build-runtime home target profile)
        ;; The cached C is named after the file and its path, so programs that share a file
        ;; name (every main.skn) keep their own (D-073).
        c-file (if keep-c
                 (str (directory-of output) (stem output) ".c")
                 (str home ".skein-cache/" (stem path) "-" (path-hash path) ".c"))]
    (io/write-file c-file c-source)
    ;; No fused multiply-adds: floating-point results must be exactly Phase 0's.
    (run-tool (vec (concat [(zig) "cc" "-std=c11" "-ffp-contract=off"
                            (:c (get profiles profile))]
                           (when target ["-target" (zig-target target)])
                           ["-I" (str prefix "include") c-file (runtime-library prefix)
                            "-o" output]
                           (when-not windows ["-lm"])))
              nil)
    output))

;;; ------------------------------------------------------------------------------------
;;; Projects: project.skn (DESIGN §20.2, M1.11, D-069)

(defn- directory-path
  "dir as a directory of the project in project-dir: ending with /."
  [project-dir dir]
  (let [dir (apply str (map (fn [c] (if (= c \\) \/ c)) dir))]
    (str project-dir dir (if (or (empty? dir) (= (last dir) \/)) "" "/"))))

(defn read-project
  "The project that the project.skn file at path describes, read as data (nothing in it
runs). Returns its map, with :paths (default [\"src\"]) and :assets as directories of the
project ending with /. The keys builds use are checked: :name, :main (a qualified symbol,
like game.main/-main), :paths and :assets."
  [path]
  (let [bad (fn [& parts] (fail path ": " (apply str parts)))
        r (reader/make-reader (io/read-file path) {:file path :namespace "user"
                                                   :resolve-alias (fn [_] nil)})
        form (reader/read-form r false ::eof)
        project (when-not (= form ::eof) (expander/syntax-value form))
        dirs (fn [k default]
               (let [v (get project k default)]
                 (when-not (and (vector? v) (every? string? v))
                   (bad k " must be a vector of directories, like [\"src\"]"))
                 (mapv (fn [d] (directory-path (directory-of path) d)) v)))]
    (when-not (map? project)
      (bad "expected a map, like {:name \"game\" :main game.main/-main}"))
    (when-not (= ::eof (reader/read-form r false ::eof))
      (bad "expected one map, with nothing after it"))
    (when-not (and (string? (:name project)) (seq (:name project)))
      (bad ":name must be a string, like \"game\""))
    (when-not (and (symbol? (:main project)) (namespace (:main project)))
      (bad ":main must be a qualified symbol, like game.main/-main"))
    (let [native (:native project)
          libs (:libs native)]
      (when-not (and (or (nil? native) (map? native)) (or (nil? libs) (map? libs))
                     (every? (fn [[os files]]
                               (and (contains? #{:macos :windows :linux} os) (vector? files)
                                    (every? string? files)))
                             libs))
        (bad ":native must look like {:libs {:macos [\"vendor/libfoo.dylib\"] :windows "
             "[\"vendor/foo.dll\"] :linux [\"vendor/libfoo.so\"]}}")))
    (assoc project :paths (dirs :paths ["src"]) :assets (dirs :assets []))))

(defn build-project
  "Compile the project whose project.skn is at path: its :main namespace, found in its
:paths, to an executable named after it. opts are build-program's; :output defaults to
the project's :name, in the current directory."
  [path opts]
  (let [project (read-project path)
        main (:main project)
        file (or (some (fn [dir]
                         (let [f (str dir (namespace-file-name (namespace main)))]
                           (when (io/file-exists? f) f)))
                       (:paths project))
                 (fail path ": cannot find namespace " (namespace main) " in :paths "
                       (pr-str (:paths project))))]
    (build-program file (assoc opts :name (:name project) :source-paths (:paths project)
                               :main-name (name main)))))

;;; ------------------------------------------------------------------------------------
;;; Packages (DESIGN §19.4, M1.11, D-069)

(defn- make-directories! [dir]
  (when-not (%make-directories dir) (fail "cannot make the directory " dir)))

(defn- copy-file! [from to]
  (when-not (%copy-file from to) (fail "cannot copy " from " to " to)))

(defn- copy-tree!
  "Copy the directory from into to (both ending with /), making it."
  [from to]
  (make-directories! to)
  (doseq [n (or (%list-directory from) (fail "cannot read the directory " from))]
    (if (= (last n) \/)
      (copy-tree! (str from n) (str to n))
      (copy-file! (str from n) (str to n)))))

(defn- xml-text [s]
  (apply str (map (fn [c] (case c \& "&amp;" \< "&lt;" \> "&gt;" \" "&quot;" c)) s)))

(defn- info-plist
  "A macOS app's Info.plist for project, whose executable is named exe."
  [project exe]
  (let [entry (fn [k v] (str "  <key>" k "</key>\n  <string>" (xml-text v) "</string>\n"))
        version (or (:version project) "0.0.0")]
    (str "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
         "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
         "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
         "<plist version=\"1.0\">\n<dict>\n"
         (entry "CFBundleExecutable" exe)
         (entry "CFBundleIdentifier" (or (:bundle-id project) (str "skein." (:name project))))
         (entry "CFBundleName" (:name project))
         (entry "CFBundlePackageType" "APPL")
         (entry "CFBundleShortVersionString" version)
         (entry "CFBundleVersion" version)
         "  <key>NSHighResolutionCapable</key>\n  <true/>\n"
         "</dict>\n</plist>\n")))

(defn package-project
  "Package the project whose project.skn is at path for opts' :target (default: this
machine) and :profile (default release): dist/<target>/<name>/ with the executable, the
target's :native libraries beside it and the :assets directories, or for macOS
dist/<target>/<name>.app (Contents/MacOS, Frameworks, Resources and Info.plist). Any
earlier package there is replaced. Returns the package's path."
  [path {:keys [target profile] :as opts}]
  (let [project (read-project path)
        target (or target (%host-target))
        os (target-os target)
        nm (:name project)
        exe (str nm (if (= os :windows) ".exe" ""))
        top (str "dist/" target "/" nm (if (= os :macos) ".app/" "/"))
        [exe-dir lib-dir asset-dir] (if (= os :macos)
                                      [(str top "Contents/MacOS/") (str top "Contents/Frameworks/")
                                       (str top "Contents/Resources/")]
                                      [top top top])]
    (%delete-tree top)
    (make-directories! exe-dir)
    (build-project path (assoc opts :target target :profile (or profile "release")
                               :output (str exe-dir exe)))
    ;; zig writes Windows debug information beside the executable; a package leaves it out.
    (when (= os :windows) (%delete-tree (str exe-dir nm ".pdb")))
    (doseq [lib (get (:libs (:native project)) os)]
      (make-directories! lib-dir)
      (copy-file! (str (directory-of path) lib) (str lib-dir (file-name lib))))
    (doseq [dir (:assets project)]
      (copy-tree! dir (str asset-dir (file-name (subs dir 0 (dec (count dir)))) "/")))
    (when (= os :macos)
      (io/write-file (str top "Contents/Info.plist") (info-plist project exe)))
    top))

;;; ------------------------------------------------------------------------------------
;;; Running programs: skeinc run, dev and repl (M2.6, D-081). A program is built into
;;; .skein-cache/run/, with a manifest of the files it was built from and their dates, and
;;; skeinc's own; it's built again only when one of those changed.

(defn- exe-suffix [] (if (windows?) ".exe" ""))

(defn- skeinc-path [home] (str home "build/skeinc" (exe-suffix)))

(defn- split-on
  "The non-empty parts of the string s between the characters ch."
  [s ch]
  (loop [i 0 start 0 out []]
    (cond (= i (count s)) (if (< start i) (conj out (subs s start i)) out)
          (= (nth s i) ch) (recur (inc i) (inc i) (if (< start i) (conj out (subs s start i)) out))
          :else (recur (inc i) start out))))

(defn- manifest-text
  "skeinc's date, then each file's date and path, a line each."
  [skeinc-date files]
  (apply str (str skeinc-date "\n")
         (map (fn [f] (str (%file-mtime f) " " f "\n")) (distinct files))))

(defn- built-from-current?
  "True if the executable exists and its manifest's dates are still the files' and
skeinc's."
  [exe manifest skeinc-date]
  (and (io/file-exists? exe) (io/file-exists? manifest)
       (let [[first-line & lines] (split-on (io/read-file manifest) \newline)]
         (and (= first-line (str skeinc-date))
              (every? (fn [line]
                        (let [space (count (take-while (fn [c] (not= c \space)) line))]
                          (= (subs line 0 space)
                             (str (%file-mtime (subs line (inc space)))))))
                      lines)))))

(defn- cached-program
  "The executable for the program at path built with opts (:profile, :eval): from
.skein-cache/run/ if nothing it was built from has changed since, else built now."
  [home path opts]
  (let [kind (if (:eval opts) "dev" (:profile opts))
        exe (str home ".skein-cache/run/" (stem path) "-" (path-hash path) "-" kind (exe-suffix))
        manifest (str exe ".sources")
        skeinc-date (%file-mtime (skeinc-path home))]
    (when-not (built-from-current? exe manifest skeinc-date)
      (make-directories! (directory-of exe))
      (build-program path (assoc opts :output exe))
      (io/write-file manifest (manifest-text skeinc-date @files-read)))
    exe))

(defn- run-program
  "Build (or reuse) the program at path with opts, run it with args and the environment
variables in env, and exit with its status."
  [path opts args env]
  (when-not (io/file-exists? path) (fail "skein: file not found: " path))
  (let [exe (cached-program (find-home) path opts)]
    (%exit (or (%run-attached (vec (cons exe args)) env)
               (fail "skein: cannot start " exe)))))

(defn- run-command
  "skein run [--release] <file.skn> [args...]: with --eval, so eval and reload work, as
in Phase 0; --release builds with the release profile, without the evaluator."
  [args]
  (let [release (= (first args) "--release")
        args (if release (rest args) args)]
    (when (empty? args) (fail "skein run: expected a file, e.g. `skein run hello.skn`"))
    (run-program (first args) (if release {:profile "release"} {:profile "dev" :eval true})
                 (rest args) nil)))

(defn- dev-command
  "skein dev [--port N | --no-server] <file.skn> [args...]: the program run with
SKEIN_DEV set, which starts the REPL, the server and the file watcher (skein.dev)."
  [args]
  (loop [args (seq args) port "5555"]
    (let [arg (first args)]
      (cond (= arg "--no-server") (recur (next args) "none")
            (= arg "--port")
            (if-let [n (second args)]
              (if (parse-long n) (recur (nnext args) n) (fail "skein dev: bad port " n))
              (fail "skein dev: --port needs a number"))
            (and arg (= (first arg) \-)) (fail "skein dev: unknown option " arg)
            (nil? arg) (fail "skein dev: expected a file, e.g. `skein dev game.skn`")
            :else (run-program arg {:profile "dev" :eval true} (rest args)
                               {"SKEIN_DEV" port})))))

(defn- repl-command
  "skein repl: the REPL program, skein.dev.repl."
  []
  (let [home (find-home)]
    (run-program (str home "lib/skein/dev/repl.skn") {:profile "dev" :eval true} [] nil)))

(defn- source-files
  "The files under dir (ending with /) whose names end with one of suffixes."
  [dir suffixes]
  (mapcat (fn [n]
            (cond (= (last n) \/) (source-files (str dir n) suffixes)
                  (some (fn [s] (and (>= (count n) (count s))
                                     (= s (subs n (- (count n) (count s))))))
                        suffixes)
                  [(str dir n)]
                  :else []))
          (or (%list-directory dir) [])))

(defn- compiler-current?
  "True if build/skeinc is newer than every file it's built from (as the launcher's
bootstrap checks: lib/'s Skein and the runtime's Zig, C and headers)."
  [home]
  (let [built (%file-mtime (skeinc-path home))]
    (boolean (and built
                  (every? (fn [f] (<= (or (%file-mtime f) 0) built))
                          (concat (source-files (str home "lib/") [".skn"])
                                  (source-files (str home "runtime/src/") [".zig" ".c"])
                                  (source-files (str home "runtime/include/") [".h"])
                                  (source-files (str home "runtime/platform/") [".zig" ".c"])))))))

;;; ------------------------------------------------------------------------------------
;;; The command line

(def ^:private usage
  (str "Usage: skeinc build [file.skn] [-o output] [--target T] [--profile dev|release]"
       " [--release] [--keep-c] [--eval]\n"
       "       skeinc package [--target T] [--profile dev|release]\n"
       "       skeinc run [--release] <file.skn> [args...]\n"
       "       skeinc dev [--port N | --no-server] <file.skn> [args...]\n"
       "       skeinc repl\n"
       "       skeinc current\n"
       "With no file, build builds the project that ./project.skn describes; package puts it"
       " in dist/. run, dev and repl build the program (cached in .skein-cache/run/) and run"
       " it; current exits with 0 if skeinc is newer than its sources."))

(defn- parse-build-args [args]
  (loop [args (seq args) opts {}]
    (if-let [arg (first args)]
      (cond (= arg "--release") (recur (next args) (assoc opts :profile "release"))
            (= arg "--keep-c") (recur (next args) (assoc opts :keep-c true))
            (= arg "--eval") (recur (next args) (assoc opts :eval true))
            (contains? {"-o" :output "--target" :target "--profile" :profile} arg)
            (if (next args)
              (recur (nnext args)
                     (assoc opts (get {"-o" :output "--target" :target "--profile" :profile}
                                      arg)
                            (second args)))
              (fail "skeinc build: " arg " needs a value"))
            (= (first arg) \-) (fail "skeinc build: unknown option " arg)
            (:file opts) (fail "skeinc build: expected one file")
            :else (recur (next args) (assoc opts :file arg)))
      opts)))

(defn -main
  "skeinc build [file.skn] [-o output] [--target T] [--profile dev|release] [--keep-c]
[--eval]: with no file, the project in the current directory. --eval includes the
evaluator (D-078). Also skeinc run, dev and repl, which `skein` runs (D-081), and skeinc
current, which exits with 0 if skeinc is newer than its sources."
  [& args]
  (let [[command & more] args]
    (case command
      "run" (run-command more)
      "dev" (dev-command more)
      "repl" (repl-command)
      "current" (%exit (if (compiler-current? (find-home)) 0 1))
      nil)
    (when-not (contains? #{"build" "package"} command) (fail usage))
    (let [opts (parse-build-args more)
          file (:file opts)]
      (cond (= command "package")
            (do (when (or file (:output opts) (:keep-c opts) (:eval opts))
                  (fail "skeinc package: takes only --target and --profile; it packages the "
                        "project in the current directory"))
                (when-not (io/file-exists? "project.skn")
                  (fail "skeinc package: expected a project.skn in the current directory"))
                (println "packaged" (package-project "project.skn" opts)))
            file
            (do (when-not (io/file-exists? file) (fail "skeinc build: file not found: " file))
                (println "built" (build-program file opts)))
            (io/file-exists? "project.skn")
            (println "built" (build-project "project.skn" opts))
            :else
            (fail "skeinc build: expected a file, e.g. `skeinc build hello.skn`, or a "
                  "project.skn in the current directory")))))
