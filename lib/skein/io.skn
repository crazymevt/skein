(ns skein.io
  "Files, directories, paths, streams and processes (DESIGN §21; M1.9, D-050, D-058;
M2.11, D-093). Failures signal io-error.
  (read-file path)              the file's contents, a string (UTF-8)
  (write-file path string)      write the file, replacing it
  (append-file path string)     add to the end of the file
  (read-bytes path)             the file's bytes, a u8 array
  (write-bytes path data)       write a u8 array, byte view or string
  (file-exists? path) (file? path) (directory? path) (file-size path)
  (modified-time path)          milliseconds since 1970
  (list-dir path)               the names in a directory, sorted
  (make-dirs path) (delete path) (delete-tree path) (copy-file from to) (rename from to)
  (path a b ...) (file-name p) (parent p) (extension p) (absolute? p) (absolute-path p)
  (open-reader path) (read-line r) (line-seq r) (read-text r)
  (open-writer path {:append true}?) (write w x) (flush w)
  (open-input path) (read-bytes! in array start? n?)
  (open-output path {:append true}?) (write-bytes! out data start? end?)
  (close stream), or with-open
  (run-process [program args...] {:dir path}?)
                                run a program without a shell; {:exit :out :err}
  (resource-dir)                the directory holding the program's assets
  (walk root opts?)             the paths under root, with Git's ignore rules (native)
  (ignore-matcher root) (ignored? matcher path dir?)
  (watch root opts?) (stop-watch! watcher)
                                changes under root, as maps on (:events watcher) (native)
  (temp-file prefix? suffix?) (temp-dir prefix?)
                                a new file or directory only you may use; its path
  (owner-only! path)            let only you read and write it (nothing on Windows)

Path functions take / or \\ as separators and join with /, which every OS accepts."
  (:require [skein.system :as system]))

(defcondition io-error [error]
  "A file that can't be read or written, or a program that can't be started."
  (message :reader io-error-message)
  (path :reader io-error-path)
  (:report (fn [c] (io-error-message c))))

(defn- fail [path & parts]
  (error io-error :message (apply str parts) :path path))

(defn resource-dir
  "The directory holding the program's assets (project.skn's :assets), ending with /: a
package's folder, or a macOS app's Contents/Resources; run from source, the project's
directory (the nearest one at or above the main file with a project.skn). Read an asset
with (read-file (str (resource-dir) \"assets/level1.txt\"))."
  []
  (%resource-dir))

(defn file-exists?
  "True if a file or directory exists at path."
  [path]
  (%file-exists? path))

(defn read-file
  "The contents of the file at path, decoded as UTF-8."
  [path]
  (or (%read-file path)
      (if (file-exists? path)
        (fail path "cannot read file " path)
        (fail path "file not found: " path))))

(defn write-file
  "Write string to the file at path (UTF-8), replacing it. Returns nil."
  [path string]
  (when-not (%write-file path string)
    (fail path "cannot write file " path))
  nil)

(defn run-process
  "Run a program directly, without a shell: argv is a vector of the program and its
arguments, and the only option is :dir, the directory to run it in. Waits for it and
returns {:exit code :out stdout :err stderr}. Signals io-error if the program can't be
started."
  ([argv] (run-process argv {}))
  ([argv opts]
   (or (%run-process argv (:dir opts))
       (fail (first argv) "cannot run " (first argv)))))
;;; ------------------------------------------------------------------------------------
;;; Paths (M2.11, D-093): strings; / and \ both separate, and path joins with /.

(defn- separator? [ch] (or (= ch \/) (= ch \\)))

(defn- last-separator
  "The index of the last separator in p, or nil."
  [p]
  (loop [i (dec (count p))]
    (cond (neg? i) nil
          (separator? (nth p i)) i
          :else (recur (dec i)))))

(defn- trim-separators
  "p without separators at its end, unless it is all separators."
  [p]
  (loop [n (count p)]
    (if (and (> n 1) (separator? (nth p (dec n)))) (recur (dec n)) (subs p 0 n))))

(defn path
  "The parts joined with /, as one path: (path \"assets\" \"level1.txt\")."
  [part & parts]
  (reduce (fn [acc p]
            (let [p (str p)]
              (cond (= "" acc) p
                    (= "" p) acc
                    (separator? (nth acc (dec (count acc))))
                    (str acc (if (separator? (first p)) (subs p 1) p))
                    (separator? (first p)) (str acc p)
                    :else (str acc "/" p))))
          (str part)
          parts))

(defn file-name
  "The last part of path p: (file-name \"a/b/c.txt\") is \"c.txt\"."
  [p]
  (let [p (trim-separators p)]
    (if-let [i (last-separator p)] (subs p (inc i)) p)))

(defn parent
  "The directory part of path p, or nil if it has none: (parent \"a/b/c.txt\") is \"a/b\"."
  [p]
  (let [p (trim-separators p)]
    (when-let [i (last-separator p)]
      (cond (zero? i) (subs p 0 1)
            ;; A drive's root keeps its separator: C:\
            (and (= i 2) (= \: (nth p 1))) (subs p 0 3)
            :else (subs p 0 i)))))

(defn extension
  "The extension of path p's file name, without the dot, or nil: \"gz\" for c.tar.gz. A
name that only starts with a dot (.gitignore) has none."
  [p]
  (let [n (file-name p)]
    (loop [i (dec (count n))]
      (cond (<= i 0) nil
            (= \. (nth n i)) (when (< (inc i) (count n)) (subs n (inc i)))
            :else (recur (dec i))))))

(defn absolute?
  "True if path p is absolute: it starts with a separator, or a drive (C:\\ or C:/)."
  [p]
  (or (and (pos? (count p)) (separator? (first p)))
      (and (>= (count p) 3) (= \: (nth p 1)) (separator? (nth p 2)))))

(defn absolute-path
  "Path p made absolute and with its links resolved; the file must exist."
  [p]
  (or (%absolute-path p) (fail p "file not found: " p)))

;;; ------------------------------------------------------------------------------------
;;; Files and directories (M2.11, D-093)

(defn- stat [p] (%stat p))

(defn file?
  "True if a file (not a directory) exists at path."
  [path]
  (= :file (first (stat path))))

(defn directory?
  "True if a directory exists at path."
  [path]
  (= :directory (first (stat path))))

(defn file-size
  "The size of the file at path, in bytes."
  [path]
  (if-let [s (stat path)] (nth s 1) (fail path "file not found: " path)))

(defn modified-time
  "When the file at path last changed, in milliseconds since 1970 (UTC)."
  [path]
  (if-let [s (stat path)] (nth s 2) (fail path "file not found: " path)))

(defn list-dir
  "The names of the files and directories in the directory at path, sorted."
  [path]
  (if-let [names (%list-directory path)]
    (mapv (fn [n] (if (= \/ (nth n (dec (count n)))) (subs n 0 (dec (count n))) n)) names)
    (fail path "cannot list directory " path)))

(defn make-dirs
  "Make the directory at path, and any missing directories above it. Returns nil."
  [path]
  (when-not (%make-directories path) (fail path "cannot make directory " path))
  nil)

(defn delete
  "Delete the file or empty directory at path. Returns nil."
  [path]
  (when-not (%delete-path path)
    (if (file-exists? path)
      (fail path "cannot delete " path)
      (fail path "file not found: " path)))
  nil)

(defn delete-tree
  "Delete the file, or the directory and everything in it, at path. Returns nil."
  [path]
  (when (and (file-exists? path) (not (%delete-tree path)))
    (fail path "cannot delete " path))
  nil)

(defn copy-file
  "Copy the file at from to to, replacing it. Returns nil."
  [from to]
  (when-not (%copy-file from to) (fail from "cannot copy " from " to " to))
  nil)

(defn rename
  "Move the file or directory at from to to. Returns nil."
  [from to]
  (when-not (%rename-path from to) (fail from "cannot move " from " to " to))
  nil)

(defn append-file
  "Add string to the end of the file at path (UTF-8), making it if it's missing. Returns
nil."
  [path string]
  (when-not (%write-bytes path string true) (fail path "cannot write file " path))
  nil)

(defn read-bytes
  "The bytes of the file at path, a u8 array."
  [path]
  (or (%read-bytes path)
      (if (file-exists? path)
        (fail path "cannot read file " path)
        (fail path "file not found: " path))))

(defn write-bytes
  "Write data (a u8 array, a byte view or a string) to the file at path, replacing it.
Returns nil."
  [path data]
  (when-not (%write-bytes path data false) (fail path "cannot write file " path))
  nil)

;;; ------------------------------------------------------------------------------------
;;; Temporary files and owner-only permissions (M3.5, D-107)

(defn- system-temp-dir
  "The system's directory for temporary files: TMPDIR (or /tmp), or on Windows TEMP or
TMP."
  []
  (let [dir (if (= :windows (system/os))
              (or (system/getenv "TEMP") (system/getenv "TMP")
                  (path (system/home-dir) "AppData" "Local" "Temp"))
              (let [t (system/getenv "TMPDIR")] (if (and t (not= "" t)) t "/tmp")))]
    (trim-separators dir)))

(defn- make-temp [prefix suffix directory?]
  (let [dir (system-temp-dir)]
    (or (%make-temp dir prefix suffix directory?)
        (fail dir "cannot make a temporary " (if directory? "directory" "file") " in " dir))))

(defn temp-file
  "A new, empty file in the system's directory for temporary files, made for this call
alone and only its owner may use (mode 600): prefix (\"skein\"), random letters and
digits, then suffix (\"\"). Its path. Deleting it is up to the caller."
  ([] (temp-file "skein" ""))
  ([prefix] (temp-file prefix ""))
  ([prefix suffix] (make-temp prefix suffix false)))

(defn temp-dir
  "A new, empty directory in the system's directory for temporary files, as temp-file
makes a file (mode 700). Its path. Deleting it (delete-tree) is up to the caller."
  ([] (temp-dir "skein"))
  ([prefix] (make-temp prefix "" true)))

(defn owner-only!
  "Let only the owner of the file or directory at path use it: mode 600 for a file, 700
for a directory. On Windows, where a user's files are already only theirs, nothing
changes. Returns nil."
  [path]
  (when-not (%owner-only path)
    (if (file-exists? path)
      (fail path "cannot change the permissions of " path)
      (fail path "file not found: " path)))
  nil)

;;; ------------------------------------------------------------------------------------
;;; Git's ignore rules and walking a tree (M3.5, D-107). Each .gitignore's patterns are
;;; compiled once into regular expressions (so these are native only, as regexes are) and
;;; matched against paths relative to the directory that holds them: the last pattern that
;;; matches decides, deeper files before higher ones, then .git/info/exclude. A directory
;;; that is ignored isn't entered: nothing in it can be re-included, as in Git.

(defn- split-slash
  "The parts of the relative path p between its /s."
  [p]
  (loop [from 0 parts []]
    (if-let [at (%string-find p "/" from)]
      (recur (inc at) (conj parts (%string-slice p from at)))
      (conj parts (%string-slice p from (%string-end p))))))

(defn- lines-of
  "The lines of text, split at newlines."
  [text]
  (loop [from 0 lines []]
    (if-let [at (%string-find text "\n" from)]
      (recur (inc at) (conj lines (%string-slice text from at)))
      (conj lines (%string-slice text from (%string-end text))))))

(defn- join-slash [parts]
  (apply str (interpose "/" parts)))

(defn- re-char
  "The regular expression that matches the character ch as it is."
  [ch]
  (let [i (int ch)]
    (if (or (<= 48 i 57) (<= 65 i 90) (<= 97 i 122) (> i 127))
      (str ch)
      (apply str "\\u" (map (fn [k] (nth "0123456789abcdef" (mod (quot i k) 16)))
                             [4096 256 16 1])))))

(defn- glob-class
  "[regex, index after it] for the bracket expression of glob characters cs at i (its
[), or nil if it has no closing ]."
  [cs i]
  (let [n (count cs)
        neg? (and (< (inc i) n) (contains? #{\! \^} (nth cs (inc i))))
        start (if neg? (+ i 2) (inc i))]
    (loop [k start items []]
      (cond
        (>= k n) nil
        (and (= \] (nth cs k)) (> k start))
        [(str (if neg? "[^/" "[") (apply str items) "]") (inc k)]
        :else
        (let [[ch k] (if (and (= \\ (nth cs k)) (< (inc k) n)) [(nth cs (inc k)) (+ k 2)]
                         [(nth cs k) (inc k)])]
          (if (and (< (inc k) n) (= \- (nth cs k)) (not= \] (nth cs (inc k))))
            (let [[hi k] (if (and (= \\ (nth cs (inc k))) (< (+ k 2) n))
                           [(nth cs (+ k 2)) (+ k 3)]
                           [(nth cs (inc k)) (+ k 2)])]
              (recur k (conj items (str (re-char ch) "-" (re-char hi)))))
            (recur k (conj items (re-char ch)))))))))

(defn- glob->regex
  "The regular expression for a gitignore glob, which matches a whole path: * and ? within
a part, ** across parts where it is a part of its own."
  [glob]
  (let [cs (vec glob)
        n (count cs)]
    (loop [i 0 out []]
      (if (>= i n)
        (apply str out)
        (let [c (nth cs i)]
          (cond
            (= c \*)
            (let [j (loop [j i] (if (and (< j n) (= \* (nth cs j))) (recur (inc j)) j))
                  own-part? (and (>= (- j i) 2)
                                 (or (= i 0) (= \/ (nth cs (dec i))))
                                 (or (= j n) (= \/ (nth cs j))))]
              (cond (and own-part? (= j n)) (recur j (conj out ".*"))
                    own-part? (recur (inc j) (conj out "(?:.*/)?"))
                    :else (recur j (conj out "[^/]*"))))
            (= c \?) (recur (inc i) (conj out "[^/]"))
            (= c \[) (if-let [[re k] (glob-class cs i)]
                       (recur k (conj out re))
                       (recur (inc i) (conj out (re-char c))))
            (and (= c \\) (< (inc i) n)) (recur (+ i 2) (conj out (re-char (nth cs (inc i)))))
            :else (recur (inc i) (conj out (re-char c)))))))))

(defn- ignore-pattern
  "The pattern a line of a .gitignore gives, or nil for a blank line or a comment:
{:negate :dir-only :anchored :re}."
  [line]
  (let [line (if (and (pos? (count line)) (= \return (nth line (dec (count line)))))
               (subs line 0 (dec (count line)))
               line)
        ;; Trailing spaces go, unless a backslash escapes one.
        line (loop [l line]
               (let [k (count l)]
                 (if (and (pos? k) (= \space (nth l (dec k)))
                          (not (and (> k 1) (= \\ (nth l (- k 2))))))
                   (recur (subs l 0 (dec k)))
                   l)))]
    (when-not (or (= "" line) (= \# (first line)))
      (let [negate (= \! (first line))
            body (if negate (subs line 1) line)
            dir-only (and (pos? (count body)) (= \/ (nth body (dec (count body)))))
            body (if dir-only (subs body 0 (dec (count body))) body)
            anchored (some? (%string-find body "/" 0))
            body (if (and anchored (= \/ (first body))) (subs body 1) body)]
        (when-not (= "" body)
          (when-let [re (try (re-pattern (glob->regex body)) (catch error e nil))]
            {:negate negate :dir-only dir-only :anchored anchored :re re}))))))

(defn- ignore-patterns
  "The patterns of a .gitignore's text, in order."
  [text]
  (if text (vec (keep ignore-pattern (lines-of text))) []))

(defn- verdict
  "Whether the last of the patterns that matches the path sub (relative to their
directory; name is its last part) ignores it (true) or re-includes it (false); nil if
none matches."
  [patterns sub name dir?]
  (loop [i (dec (count patterns))]
    (when (>= i 0)
      (let [p (nth patterns i)]
        (if (and (or dir? (not (:dir-only p)))
                 (%re-exec (:re p) (if (:anchored p) sub name) 0 true))
          (not (:negate p))
          (recur (dec i)))))))

(defn ignore-matcher
  "A matcher of Git's ignore rules for the tree at root: every .gitignore in it (read when
first needed, and kept) and root/.git/info/exclude. ignored? asks it about a path."
  [root]
  {::root root
   ::exclude (ignore-patterns (%read-file (path root ".git" "info" "exclude")))
   ::gitignores (atom {})})

(defn- gitignore-patterns
  "The patterns of the .gitignore in the directory dir (relative to the root; \"\" for
it), or []."
  [m dir]
  (or (get @(::gitignores m) dir)
      (let [ps (ignore-patterns (%read-file (path (::root m) dir ".gitignore")))]
        (swap! (::gitignores m) assoc dir ps)
        ps)))

(defn- ignored-here?
  "Whether the rules ignore the path rel (parts, relative to the root) itself, its
directories being known not to be."
  [m parts dir?]
  (let [n (count parts)
        nm (peek parts)]
    (true? (loop [k (dec n)]
             (if (< k 0)
               (verdict (::exclude m) (join-slash parts) nm dir?)
               (let [v (verdict (gitignore-patterns m (join-slash (vec (take k parts))))
                                (join-slash (vec (drop k parts))) nm dir?)]
                 (if (nil? v) (recur (dec k)) v)))))))

(defn- relative-parts
  "The parts of path p relative to the matcher's root (p is relative to it, or under it),
or nil if it isn't under the root."
  [m p]
  (let [norm (fn [x] (apply str (map (fn [ch] (if (= ch \\) \/ ch)) (trim-separators x))))
        root (norm (::root m))
        p (norm p)
        prefix (str root "/")
        rel (cond (and (>= (count p) (count prefix)) (= prefix (subs p 0 (count prefix))))
                  (subs p (count prefix))
                  (absolute? p) nil
                  (and (> (count p) 2) (= "./" (subs p 0 2))) (subs p 2)
                  :else p)]
    (when (and rel (not= "" rel) (not= "." rel))
      (vec (remove (fn [x] (or (= "" x) (= "." x))) (split-slash rel))))))

(defn ignored?
  "True if Git's ignore rules, as the matcher reads them, ignore path (relative to the
matcher's root, or under it): it, or a directory it's in, matches. dir? says whether it's a
directory; without it the file system is asked. Anything in .git is ignored."
  ([m p] (ignored? m p nil))
  ([m p dir?]
   (if-let [parts (relative-parts m p)]
     (boolean
      (or (some #{".git"} parts)
          (some (fn [k] (ignored-here? m (vec (take k parts)) true)) (range 1 (count parts)))
          (ignored-here? m parts
                         (if (nil? dir?) (directory? (apply path (::root m) parts)) dir?))))
     false)))

(defn walk
  "A lazy seq of the paths under the directory root (each root joined with its path), by
name, each directory before what it holds. Symbolic links aren't followed, and .git is
skipped. opts: :gitignore (true), Git's ignore rules (as ignore-matcher reads them);
:hidden (false), names that start with a dot too; :dirs (true), directories too, not only
files."
  ([root] (walk root {}))
  ([root opts]
   (let [m (when (get opts :gitignore true) (ignore-matcher root))
         hidden (get opts :hidden false)
         dirs (get opts :dirs true)
         entries
         (fn entries [parts]
           (let [names (sort (map (fn [n] (if (= \/ (nth n (dec (count n))))
                                            [(subs n 0 (dec (count n))) true]
                                            [n false]))
                                  (or (%list-directory (apply path root parts)) [])))]
             (mapcat (fn [[nm dir?]]
                       (let [ps (conj parts nm)]
                         (cond (= nm ".git") nil
                               (and (not hidden) (= \. (first nm))) nil
                               (and m (ignored-here? m ps dir?)) nil
                               dir? (let [more (lazy-seq (entries ps))]
                                      (if dirs (cons (apply path root ps) more) more))
                               :else [(apply path root ps)])))
                     names)))]
     (lazy-seq (entries [])))))

;;; ------------------------------------------------------------------------------------
;;; Watching a tree (M3.5, D-107): the platform's watcher (FSEvents, inotify or
;;; ReadDirectoryChangesW) reports changes on a thread of its own; a fiber here takes them
;;; a batch at a time, drops what Git's rules ignore, and puts the rest on the channel.

(defn- watch-events
  "The events of a batch from the runtime ([kind relative-path] each), as maps, with the
ignore rules (m, or nil), repeats in a row dropped."
  [root m batch]
  (loop [batch batch prev nil out []]
    (if-let [[kind rel :as e] (first batch)]
      (cond
        (= e prev) (recur (rest batch) prev out)
        (= kind :rescan) (recur (rest batch) e (conj out {:kind :modified :path root}))
        (and m (ignored? @m rel (when (= kind :deleted) false))) (recur (rest batch) e out)
        :else (recur (rest batch) e (conj out {:kind kind :path (path root rel)})))
      out)))

(defn watch
  "Watch the directory tree at root for changes: a watcher, whose :events is a channel of
{:kind :created|:modified|:deleted :path p} (p is root joined with the path under it).
Events come promptly but can repeat, merge or (on Linux) arrive for files in a new
directory as :created; when the system loses some, an event says root is :modified, to
look again. Treat them as hints to look at a path. opts: :gitignore (true), dropping what
Git's ignore rules ignore (and .git always); :buffer, the channel's size (1024). Native
only; stop-watch! stops it."
  ([root] (watch root {}))
  ([root opts]
   (let [h (or (%fswatch-start root) (fail root "cannot watch " root))
         m (when (get opts :gitignore true) (atom (ignore-matcher root)))
         events (chan (get opts :buffer 1024))]
     (future
       (loop []
         (if-let [batch (%fswatch-next h 0)]
           (do
             ;; A changed .gitignore changes the rules.
             (when (and m (some (fn [[_ rel]] (= ".gitignore" (file-name rel))) batch))
               (reset! m (ignore-matcher root)))
             (doseq [e (watch-events root m batch)] (>! events e))
             (recur))
           (close! events))))
     {::handle h :root root :events events})))

(defn stop-watch!
  "Stop the watcher: its :events channel closes once what was reported is taken. Returns
nil."
  [w]
  (%fswatch-stop (::handle w))
  nil)

;;; ------------------------------------------------------------------------------------
;;; Streams (M2.11, D-093): text readers and writers, and byte inputs and outputs. close
;;; (or with-open) flushes and closes one.

(defclass stream []
  "An open file: kind is :reader, :writer, :input or :output; or a socket (skein.net),
:socket, which every stream function takes."
  (handle)
  (kind)
  (path :reader stream-path))

(defmethod close [(s stream)]
  (%stream-close (:handle s)))

(defn- open-stream [path kind mode]
  (if-let [h (%open-stream path mode)]
    (make stream :handle h :kind kind :path path)
    (if (or (pos? mode) (file-exists? path))
      (fail path "cannot open " path)
      (fail path "file not found: " path))))

(defn- handle-of [s kind what]
  (when-not (and (instance? stream s) (or (= kind (:kind s)) (= :socket (:kind s))))
    (error (str what " needs a " (name kind) " stream, not " (pr-str s))))
  (:handle s))

(defn open-reader
  "Open the file at path to read its text (UTF-8)."
  [path]
  (open-stream path :reader 0))

(defn read-line
  "The next line of the reader r, without its line ending, or nil at the end."
  [r]
  (%stream-read-line (handle-of r :reader "read-line")))

(defn line-seq
  "A lazy seq of the lines left in the reader r."
  [r]
  (lazy-seq (when-let [line (read-line r)] (cons line (line-seq r)))))

(defn read-text
  "The rest of the reader r's text."
  [r]
  (%stream-read-rest (handle-of r :reader "read-text")))

(defn open-writer
  "Open the file at path to write text (UTF-8), replacing it, or after what it holds
with {:append true}."
  ([path] (open-writer path {}))
  ([path opts] (open-stream path :writer (if (:append opts) 2 1))))

(defn write
  "Write the text of x (as str prints it) to the writer w. Returns nil."
  [w x]
  (%stream-write (handle-of w :writer "write") (str x) nil nil))

(defn flush
  "Write what the writer, output or socket s holds back. Returns nil."
  [s]
  (when-not (and (instance? stream s) (contains? #{:writer :output :socket} (:kind s)))
    (error (str "flush needs a writer or an output stream, not " (pr-str s))))
  (%stream-flush (:handle s)))

(defn open-input
  "Open the file at path to read its bytes."
  [path]
  (open-stream path :input 0))

(defn read-bytes!
  "Read bytes from the input in into array (a u8 array or a byte view), from index start
(0) up to n of them (to its end); how many it read, or nil at the end of the file."
  ([in array] (read-bytes! in array 0 (count array)))
  ([in array start] (read-bytes! in array start (- (count array) start)))
  ([in array start n] (%stream-read-bytes (handle-of in :input "read-bytes!") array start n)))

(defn open-output
  "Open the file at path to write bytes, replacing it, or after what it holds with
{:append true}."
  ([path] (open-output path {}))
  ([path opts] (open-stream path :output (if (:append opts) 2 1))))

(defn write-bytes!
  "Write data (a u8 array, a byte view or a string) to the output out, its bytes from
start to end. Returns nil."
  ([out data] (write-bytes! out data nil nil))
  ([out data start end]
   (%stream-write (handle-of out :output "write-bytes!") data start end)))
