(ns skein.core
  "Core macros, written in Skein (DESIGN §5.2). The special forms, the primitive functions
and the bootstrap macros ns, defmacro, defn and defn- are built into the host.")

;;; Order matters: each macro may use only the macros defined above it.

(defmacro comment
  "Ignore the body; evaluate to nil."
  [& body]
  nil)

(defmacro let
  "Bind names sequentially, with destructuring (DESIGN §5.4)."
  [bindings & body]
  `(let* ~(destructure bindings) ~@body))

(defmacro when
  "If test is true, evaluate the body; otherwise nil."
  [test & body]
  `(if ~test (do ~@body)))

(defmacro when-not
  "If test is false, evaluate the body; otherwise nil."
  [test & body]
  `(if ~test nil (do ~@body)))

(defmacro if-not
  "Like if, with the branches swapped."
  ([test then] `(if ~test nil ~then))
  ([test then else] `(if ~test ~else ~then)))

(defmacro cond
  "Evaluate the first expression whose test is true. Use :else as a final test."
  [& clauses]
  (when clauses
    (when-not (next clauses)
      (error "cond needs an even number of forms"))
    `(if ~(first clauses)
       ~(second clauses)
       (cond ~@(next (next clauses))))))

(defmacro and
  "Evaluate forms left to right; return the first falsy value, or the last value."
  ([] true)
  ([x] x)
  ([x & more] `(let* [and# ~x] (if and# (and ~@more) and#))))

(defmacro or
  "Evaluate forms left to right; return the first truthy value, or the last value."
  ([] nil)
  ([x] x)
  ([x & more] `(let* [or# ~x] (if or# or# (or ~@more)))))

(defn- binding-pair [bindings what]
  (when-not (and (vector? bindings) (= 2 (count bindings)))
    (error what "needs a binding vector of one name and one test"))
  bindings)

(defmacro if-let
  "If test is true, bind it with destructuring and evaluate then; otherwise else."
  ([bindings then] `(if-let ~bindings ~then nil))
  ([bindings then else]
   (let [[form test] (binding-pair bindings "if-let")]
     `(let* [temp# ~test]
        (if temp# (let [~form temp#] ~then) ~else)))))

(defmacro when-let
  "If test is true, bind it with destructuring and evaluate the body."
  [bindings & body]
  (let [[form test] (binding-pair bindings "when-let")]
    `(let* [temp# ~test]
       (when temp# (let [~form temp#] ~@body)))))

(defmacro if-some
  "Like if-let, but tests for non-nil (false counts as present)."
  ([bindings then] `(if-some ~bindings ~then nil))
  ([bindings then else]
   (let [[form test] (binding-pair bindings "if-some")]
     `(let* [temp# ~test]
        (if (nil? temp#) ~else (let [~form temp#] ~then))))))

(defmacro when-some
  "Like when-let, but tests for non-nil."
  [bindings & body]
  (let [[form test] (binding-pair bindings "when-some")]
    `(let* [temp# ~test]
       (if (nil? temp#) nil (let [~form temp#] ~@body)))))

(defmacro loop
  "Like loop*, with destructuring. recur supplies new values for the whole patterns."
  [bindings & body]
  (let [pairs (partition 2 bindings)]
    (when-not (even? (count bindings))
      (error "loop needs an even number of binding forms"))
    (if (every? (fn [[b _]] (symbol? b)) pairs)
      `(loop* ~bindings ~@body)
      (let [names (map (fn [[b _]] (if (symbol? b) b (gensym "loop__"))) pairs)]
        `(let [~@(mapcat (fn [[b init] g] (if (symbol? b) [b init] [g init b g]))
                         pairs names)]
           (loop* [~@(mapcat (fn [g] [g g]) names)]
             (let [~@(mapcat (fn [[b _] g] (if (symbol? b) [] [b g])) pairs names)]
               ~@body)))))))

(defmacro letfn
  "Bind mutually recursive local functions: (letfn [(f [x] ...) (g [y] ...)] body)."
  [fnspecs & body]
  `(letfn* ~fnspecs ~@body))

(defmacro lazy-seq
  "A lazy seq whose body runs the first time the seq is needed."
  [& body]
  `(%lazy-seq (fn [] ~@body)))

(defmacro case
  "Compare e with constants (or lists of constants) and evaluate the matching expression.
An odd final form is the default; with no default and no match, signal an error."
  [e & clauses]
  (let [g (gensym "case__")
        pairs (partition 2 clauses)
        test (fn [k]
               (if (list? k)
                 `(or ~@(map (fn [x] `(= ~g '~x)) k))
                 `(= ~g '~k)))]
    `(let* [~g ~e]
       (cond ~@(mapcat (fn [[k v]] [(test k) v]) pairs)
             :else ~(if (odd? (count clauses))
                      (last clauses)
                      `(%no-matching-case ~g))))))

;;; Threading

(defmacro ->
  "Thread x through the forms, as the first argument of each."
  [x & forms]
  (loop [x x forms forms]
    (if forms
      (let [form (first forms)]
        (recur (if (seq? form) `(~(first form) ~x ~@(next form)) (list form x))
               (next forms)))
      x)))

(defmacro ->>
  "Thread x through the forms, as the last argument of each."
  [x & forms]
  (loop [x x forms forms]
    (if forms
      (let [form (first forms)]
        (recur (if (seq? form) `(~@form ~x) (list form x))
               (next forms)))
      x)))

(defmacro as->
  "Bind name to expr, then to the result of each form in turn."
  [expr name & forms]
  `(let [~name ~expr
         ~@(interleave (repeat name) (butlast forms))]
     ~(if (empty? forms) name (last forms))))

(defmacro some->
  "Like ->, but stop at the first nil."
  [expr & forms]
  (let [g (gensym)
        steps (map (fn [step] `(if (nil? ~g) nil (-> ~g ~step))) forms)]
    `(let [~g ~expr
           ~@(interleave (repeat g) (butlast steps))]
       ~(if (empty? steps) g (last steps)))))

(defmacro some->>
  "Like ->>, but stop at the first nil."
  [expr & forms]
  (let [g (gensym)
        steps (map (fn [step] `(if (nil? ~g) nil (->> ~g ~step))) forms)]
    `(let [~g ~expr
           ~@(interleave (repeat g) (butlast steps))]
       ~(if (empty? steps) g (last steps)))))

(defmacro doto
  "Evaluate x, call each form with it as the first argument, and return x."
  [x & forms]
  (let [g (gensym)]
    `(let [~g ~x]
       ~@(map (fn [f] (if (seq? f) `(~(first f) ~g ~@(next f)) `(~f ~g))) forms)
       ~g)))

;;; Loops

(defmacro while
  "Evaluate the body repeatedly while test is true. Returns nil."
  [test & body]
  `(loop [] (when ~test ~@body (recur))))

(defmacro dotimes
  "Evaluate the body with name bound to 0, 1, ... n-1. Returns nil."
  [bindings & body]
  (let [[i n] (binding-pair bindings "dotimes")]
    `(let [n# ~n]
       (loop [~i 0]
         (when (< ~i n#)
           ~@body
           (recur (inc ~i)))))))

(defn- doseq-code
  "Code that runs body for the remaining seq-exprs, then evaluates continue."
  [exprs body continue]
  (if (empty? exprs)
    `(do ~@body ~continue)
    (let [[k v & more] exprs]
      (cond
        (= k :let) `(let ~v ~(doseq-code more body continue))
        (= k :when) `(if ~v ~(doseq-code more body continue) ~continue)
        (= k :while) `(when ~v ~(doseq-code more body continue))
        :else (let [s (gensym "seq__")]
                `(do (loop [~s (seq ~v)]
                       (when ~s
                         (let [~k (first ~s)]
                           ~(doseq-code more body `(recur (next ~s))))))
                     ~continue))))))

(defmacro doseq
  "Evaluate the body for each binding in the seq-exprs, which may also contain :let,
:when and :while modifiers, as in for. Returns nil."
  [seq-exprs & body]
  (when-not (and (vector? seq-exprs) (even? (count seq-exprs)))
    (error "doseq needs a vector with an even number of forms"))
  `(do ~(doseq-code (seq seq-exprs) body nil) nil))

(defn- for-code
  "Code for a lazy seq of the remaining results. next continues the innermost binding;
done is what the innermost binding returns when a :while test fails."
  [exprs body next done]
  (if (empty? exprs)
    `(cons ~body ~next)
    (let [[k v & more] exprs]
      (cond
        (= k :let) `(let ~v ~(for-code more body next done))
        (= k :when) `(if ~v ~(for-code more body next done) ~next)
        (= k :while) `(if ~v ~(for-code more body next done) ~done)
        :else (let [iter (gensym "iter__")
                    s (gensym "s__")]
                `(letfn* [(~iter [~s]
                           (lazy-seq
                             (let* [~s (seq ~s)]
                               (if ~s
                                 (let [~k (first ~s)]
                                   ~(for-code more body `(~iter (rest ~s)) next))
                                 ~next))))]
                   (~iter ~v)))))))

(defmacro for
  "A lazy comprehension: (for [x xs :when (odd? x) y ys] [x y]). Supports :let, :when
and :while modifiers."
  [seq-exprs body]
  (when-not (and (vector? seq-exprs) (even? (count seq-exprs)))
    (error "for needs a vector with an even number of forms"))
  (for-code (seq seq-exprs) body () ()))

;;; Conditions and restarts (DESIGN §10). These build on the special forms
;;; throw-condition, handler-bind* and restart-bind*.

(defn- condition-type-form
  "Code that evaluates a condition type spec: a symbol is looked up by name in the
namespace being compiled; anything else is evaluated."
  [spec]
  (if (symbol? spec)
    `(%condition-type '~spec ~(%current-namespace-name))
    spec))

(defmacro handler-bind
  "Run the body with handlers: [type handler ...]. A handler is a function of the
condition. It runs without unwinding, so restarts established inside the body are still
available; if it returns, the next applicable handler runs."
  [bindings & body]
  (when-not (and (vector? bindings) (even? (count bindings)))
    (error "handler-bind needs a vector of condition types and handlers"))
  `(handler-bind* [~@(mapcat (fn [[type handler]] [(condition-type-form type) handler])
                             (partition 2 bindings))]
     ~@body))

(defmacro handler-case
  "Evaluate expr. If a condition matching a clause (type [c] body...) is signaled, unwind
to here and evaluate that clause with c bound to the condition."
  [expr & clauses]
  (let [outer (gensym "handler_case__")
        inner (gensym "handler_case_inner__")
        result (gensym "result__")
        indexed (map-indexed vector clauses)]
    (doseq [clause clauses]
      (when-not (and (seq? clause) (vector? (second clause)) (<= (count (second clause)) 1))
        (error "handler-case clauses look like (type [c] body...)")))
    `(block* ~outer
       (let [~result (block* ~inner
                       (return-from* ~outer
                         (handler-bind* [~@(mapcat (fn [[i [type]]]
                                                     [(condition-type-form type)
                                                      `(fn [c#] (return-from* ~inner [~i c#]))])
                                                   indexed)]
                           ~expr)))]
         (case (nth ~result 0)
           ~@(mapcat (fn [[i [_ params & body]]]
                       [i (if (seq params)
                            `(let [~(first params) (nth ~result 1)] ~@body)
                            `(do ~@body))])
                     indexed))))))

(defmacro try
  "Evaluate the body. (catch type e body...) clauses handle matching conditions by
unwinding, as handler-case does; a (finally body...) clause always runs last."
  [& forms]
  (let [clause? (fn [head f] (and (seq? f) (= head (first f))))
        body (remove (fn [f] (or (clause? 'catch f) (clause? 'finally f))) forms)
        catches (filter (fn [f] (clause? 'catch f)) forms)
        finally (first (filter (fn [f] (clause? 'finally f)) forms))
        guarded (if (seq catches)
                  `(handler-case (do ~@body)
                     ~@(map (fn [[_ type e & handler]] `(~type [~e] ~@handler)) catches))
                  `(do ~@body))]
    (if finally
      `(unwind-protect ~guarded ~@(rest finally))
      guarded)))

(defmacro restart-case
  "Evaluate expr with restarts established: (name [params] body...), optionally with
:report \"description\" after the parameters. Invoking a restart unwinds to here and
evaluates its body with the arguments given to invoke-restart."
  [expr & clauses]
  (let [outer (gensym "restart_case__")
        inner (gensym "restart_case_inner__")
        result (gensym "result__")
        parse (fn [clause]
                (when-not (and (seq? clause) (symbol? (first clause)) (vector? (second clause)))
                  (error "restart-case clauses look like (name [params] body...)"))
                (let [[name params & more] clause
                      report? (= :report (first more))]
                  {:name name :params params
                   :report (when report? (second more))
                   :body (if report? (next (next more)) more)}))
        indexed (map-indexed vector (map parse clauses))]
    `(block* ~outer
       (let [~result (block* ~inner
                       (return-from* ~outer
                         (restart-bind* [~@(mapcat (fn [[i {:keys [name report]}]]
                                                     [name
                                                      `(fn [& args#]
                                                         (return-from* ~inner [~i args#]))
                                                      report])
                                                   indexed)]
                           ~expr)))]
         (case (nth ~result 0)
           ~@(mapcat (fn [[i {:keys [params body]}]]
                       [i `(apply (fn ~params ~@body) (nth ~result 1))])
                     indexed))))))

(defmacro defcondition
  "Define a condition type: (defcondition name [parents] doc? (slot :reader f
:initform expr)... (:report f)?). Parents default to [condition]. Makes name a var
holding the type, and defines each reader as a function of a condition."
  [type-name parents & specs]
  (let [ns (%current-namespace-name)
        specs (if (string? (first specs)) (rest specs) specs)
        report (some (fn [s] (when (= :report (first s)) (second s))) specs)
        slots (remove (fn [s] (keyword? (first s))) specs)
        options (fn [[_ & opts]] (apply hash-map opts))]
    (when-not (vector? parents)
      (error "defcondition needs a vector of parent condition types"))
    `(do
       ~@(keep (fn [s]
                 (when-let [reader (:reader (options s))]
                   `(defn ~reader [c#] (%condition-slot c# '~(first s)))))
               slots)
       (def ~type-name
         (%define-condition '~(symbol ns (name type-name))
                            [~@(map condition-type-form (if (empty? parents) '[condition] parents))]
                            [~@(map (fn [s] `['~(first s) (fn [] ~(:initform (options s)))]) slots)]
                            ~report))
       ~type-name)))
